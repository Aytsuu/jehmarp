---
import type { NavigationItem } from "@/config/navigation";
import AgentMobileChrome from "@/components/agent/AgentMobileChrome.astro";
import AdminMobileSidebarChrome from "@/components/admin/AdminMobileSidebarChrome.astro";
import DashboardSidebar from "@/components/dashboard/DashboardSidebar.astro";
import AlertDialog from "@/components/ui/AlertDialog.astro";
import type { DashboardSidebarUnreadBadge } from "@/lib/dashboard/sidebar-navigation";
import Sheet from "@/components/ui/Sheet.astro";
import { ClientRouter } from "astro:transitions";
import { getDashboardPageTransitionName } from "@/lib/dashboard/page-transition";
import { isAgentMobilePrimaryRoute } from "@/lib/dashboard/agent-navigation";
import "@/styles/global.css";

type Props = {
  title: string;
  description: string;
  navLabel: string;
  navItems: readonly NavigationItem[];
  sidebarUnreadBadges?: Record<string, DashboardSidebarUnreadBadge>;
};

const { title, description, navLabel, sidebarUnreadBadges = {} } = Astro.props;
const isAgentDashboard = navLabel === "Agent operations";
const isAdminDashboard = Astro.url.pathname.startsWith("/admin");
const isAgentMobilePrimary = isAgentDashboard && isAgentMobilePrimaryRoute(Astro.url.pathname);
const dashboardPageTransitionName = getDashboardPageTransitionName();
---

<!doctype html>
<html lang="en" style="font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" transition:persist />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
      transition:persist
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      transition:persist
    />
    <ClientRouter fallback="animate" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem("dashboard-sidebar-collapsed") === "true") {
          document.documentElement.classList.add("dashboard-sidebar-collapsed");
        }
      } catch {
        void 0;
      }
    </script>
    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }

      ::view-transition-old(dashboard-main-content),
      ::view-transition-new(dashboard-main-content) {
        animation: none;
      }

      @media (max-width: 47.99rem) {
        .dashboard-body--agent ::view-transition-old(dashboard-main),
        .dashboard-body--agent ::view-transition-new(dashboard-main),
        .dashboard-body--agent ::view-transition-group(dashboard-main),
        .dashboard-body--agent ::view-transition-old(root),
        .dashboard-body--agent ::view-transition-new(root),
        .dashboard-body--agent ::view-transition-group(root) {
          animation: none !important;
        }

        .agent-mobile-nav {
          view-transition-name: none;
        }
      }

      html.agent-mobile-nav-lock,
      html.agent-mobile-nav-lock body,
      html.dashboard-sidebar-mobile-open,
      html.dashboard-sidebar-mobile-open body {
        overflow: hidden;
      }
    </style>
  </head>
  <body
    class:list={[
      "dashboard-body",
      isAgentDashboard && "dashboard-body--agent",
      isAdminDashboard && "dashboard-body--admin",
      isAgentMobilePrimary && "dashboard-body--agent-mobile-primary",
    ]}
  >
    <script is:inline>
      if (location.pathname.startsWith("/agent")) {
        document.body.classList.add("dashboard-body--agent");
        const primaryRoutes = [
          "/agent",
          "/agent/customers",
          "/agent/orders",
          "/agent/notifications",
          "/agent/profile",
        ];
        if (primaryRoutes.includes(location.pathname)) {
          document.body.classList.add("dashboard-body--agent-mobile-primary");
        }

        if (window.matchMedia("(max-width: 47.99rem)").matches) {
          const syncAgentViewportHeight = () => {
            const height = window.visualViewport ? window.visualViewport.height : window.innerHeight;
            document.documentElement.style.setProperty("--app-viewport-height", `${Math.round(height)}px`);
          };

          syncAgentViewportHeight();
          window.visualViewport?.addEventListener("resize", syncAgentViewportHeight);
          window.visualViewport?.addEventListener("scroll", syncAgentViewportHeight);
          window.addEventListener("resize", syncAgentViewportHeight);
        }
      }

      if (
        location.pathname.startsWith("/admin") &&
        window.matchMedia("(max-width: 63.99rem)").matches
      ) {
        const syncAdminViewportHeight = () => {
          const height = window.visualViewport ? window.visualViewport.height : window.innerHeight;
          document.documentElement.style.setProperty("--app-viewport-height", `${Math.round(height)}px`);
        };

        syncAdminViewportHeight();
        window.visualViewport?.addEventListener("resize", syncAdminViewportHeight);
        window.visualViewport?.addEventListener("scroll", syncAdminViewportHeight);
        window.addEventListener("resize", syncAdminViewportHeight);
      }
    </script>
    {
      isAgentDashboard && (
        <AgentMobileChrome
          currentPath={Astro.url.pathname}
          sidebarUnreadBadges={sidebarUnreadBadges}
        />
      )
    }
    {
      isAdminDashboard && (
        <AdminMobileSidebarChrome currentPath={Astro.url.pathname} />
      )
    }
    <div class="dashboard-frame">
      <DashboardSidebar navLabel={navLabel} sidebarUnreadBadges={sidebarUnreadBadges} />
      <main class="dashboard-main">
        <div
          class="dashboard-route-skeleton"
          data-dashboard-route-skeleton
          hidden
          aria-hidden="true"
          aria-busy="true"
          aria-label="Loading page"
        >
          <div class="dashboard-route-skeleton__panel">
            <span class="table-skeleton-block table-skeleton-block--short dashboard-route-skeleton__title"></span>
            <span class="table-skeleton-block dashboard-route-skeleton__intro"></span>
            <div class="dashboard-route-skeleton__cards" aria-hidden="true">
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
            </div>
            <span class="table-skeleton-block table-skeleton-block--wide dashboard-route-skeleton__block"></span>
            <span class="table-skeleton-block dashboard-route-skeleton__block"></span>
            <span class="table-skeleton-block table-skeleton-block--short dashboard-route-skeleton__block"></span>
          </div>
        </div>
        {
          isAgentDashboard ? (
            <div class="dashboard-main__content dashboard-main__content--agent">
              <slot />
            </div>
          ) : (
            <div
              class="dashboard-main__content"
              transition:name={dashboardPageTransitionName}
              transition:animate="none"
            >
              <slot />
            </div>
          )
        }
      </main>
    </div>

    <!-- Drawer Sheet Component -->
    <Sheet header="Manage" content="" />

    <form
      id="dashboard-logout-form"
      method="post"
      action="/api/logout"
      data-astro-reload
      hidden
    ></form>
    <AlertDialog
      id="dashboard-logout-dialog"
      title="Sign out?"
      description="You will need to sign in again to access your dashboard."
      confirmLabel="Sign out"
      cancelLabel="Stay signed in"
      variant="danger"
    />

    <div class="cell-popover" id="cell-popover" aria-hidden="true">
      <div class="cell-popover__card">
        <header class="cell-popover__header">
          <div class="cell-popover__heading">
            <h3 class="cell-popover__title">Edit</h3>
            <p class="cell-popover__description" hidden></p>
          </div>
          <button
            type="button"
            class="dashboard-modal__close"
            data-close-cell-popover
            aria-label="Close popover"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>
        <div class="cell-popover__body" data-cell-popover-body></div>
      </div>
    </div>

    <script is:inline>
      window.readDashboardFragmentResponse = async function readDashboardFragmentResponse(response) {
        if (response.status === 503) {
          const redirectUrl = response.headers.get("X-System-Issue-Redirect") || "/system-issue";
          window.location.assign(redirectUrl);
          throw new DOMException("Aborted", "AbortError");
        }

        if (!response.ok) {
          throw new Error("Request failed with " + response.status + ".");
        }

        return response.text();
      };
    </script>

    <script>
      import { initDashboardCellPopovers } from "@/lib/client/dashboard-cell-popover";
      import { initDashboardAlertDialogs } from "@/lib/client/dashboard-alert-dialog";
      import { initDashboardModals } from "@/lib/client/dashboard-modal";
      import { initDashboardSheets } from "@/lib/client/dashboard-sheet";
      import { initDashboardNavNavigation } from "@/lib/client/dashboard-nav";
      import { initAgentMobileNavigation } from "@/lib/client/agent-mobile-route";
      import { initDashboardRouteLoading } from "@/lib/client/dashboard-route-loading";
      import { initDashboardSidebarUnreadBadges } from "@/lib/client/dashboard-sidebar-badges";
      import { initDashboardSidebarCollapse } from "@/lib/client/dashboard-sidebar";
      import { initAdminMobileSidebar } from "@/lib/client/dashboard-admin-mobile-sidebar";
      import { initOrderDetailTabs } from "@/lib/client/order-detail-tabs";
      import { initDashboardRecordPageRefresh } from "@/lib/client/order-detail-page";
      import { initDashboardDetailLinkPrefetchOptOut } from "@/lib/client/dashboard-prefetch";
      import { initOrderProductQuantityForms } from "@/lib/client/order-product-quantity-form";
      import { initOrderProductsList } from "@/lib/client/order-products-list";
      import { initOrderPaymentFormToggle } from "@/lib/client/order-payment-form";
      import { initOrderStatusAutoSave } from "@/lib/client/order-status-auto-save";
      import { initTableActionMenus } from "@/lib/client/table-action-menu";
      import { initTableRowActionModals } from "@/lib/client/table-row-action-modal";
      import { initAdminOrderBulkPdf } from "@/lib/client/admin-order-bulk-pdf";
      import { initAdminOrderPendingCustomersModal } from "@/lib/client/admin-order-pending-customers-modal";
      import { initAdminOrdersFragmentTable } from "@/lib/client/admin-orders-fragment-table";
      import { clearDashboardFragmentCaches } from "@/lib/client/dashboard-fragment-cache";
      import { initFormSubmissionState } from "@/lib/client/form-submission-state";
      import { clearSystemIssueRetryState } from "@/lib/client/system-issue-retry";
      import { formatRecordCount } from "@/lib/admin-dashboard/pagination";

      function initSidebarUnreadBadges() {
        initDashboardSidebarUnreadBadges();
      }

      const boardAlignmentObservers = new WeakMap<HTMLElement, ResizeObserver>();

      function isSidebarLayoutAnimationActive() {
        return document.documentElement.classList.contains(
          "dashboard-sidebar-animating",
        );
      }

      function measureActionColumnChild(child: HTMLElement) {
        if (
          child.matches(".order-table-action-form")
          || (child.tagName === "FORM" && child.querySelector("button, a"))
        ) {
          const control = child.querySelector("button, a") as HTMLElement | null;
          if (control) {
            return Math.ceil(control.getBoundingClientRect().width);
          }
        }

        return Math.ceil(child.getBoundingClientRect().width);
      }

      function measureActionColumnWidth(
        headerCell: HTMLTableCellElement,
        bodyRows: HTMLTableRowElement[],
        columnIndex: number,
        minimumWidth = 32,
      ) {
        let maxWidth = minimumWidth;

        const measureCell = (cell: HTMLElement) => {
          const previousMaxWidth = cell.style.maxWidth;
          cell.style.maxWidth = "none";

          try {
            const style = getComputedStyle(cell);
            const horizontalPadding =
              parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
            const children = [...cell.children].filter(
              (child) => !child.classList.contains("hidden-popover-form-holder"),
            ) as HTMLElement[];

            if (children.length === 0) {
              const textContent = cell.textContent?.trim();
              if (textContent) {
                maxWidth = Math.max(maxWidth, Math.ceil(cell.scrollWidth));
              }
              return;
            }

            let contentWidth = 0;
            children.forEach((child, childIndex) => {
              contentWidth += measureActionColumnChild(child);
              if (childIndex > 0) {
                contentWidth += 8;
              }
            });

            maxWidth = Math.max(maxWidth, contentWidth + horizontalPadding);
          } finally {
            if (previousMaxWidth) {
              cell.style.maxWidth = previousMaxWidth;
            } else {
              cell.style.removeProperty("max-width");
            }
          }
        };

        measureCell(headerCell);
        for (const row of bodyRows) {
          const cell = row.children[columnIndex] as HTMLElement | undefined;
          if (cell) {
            measureCell(cell);
          }
        }

        return maxWidth;
      }

      function measureContentColumnWidth(
        headerCell: HTMLTableCellElement,
        bodyRows: HTMLTableRowElement[],
        columnIndex: number,
        minimumWidth = 72,
      ) {
        let maxWidth = minimumWidth;

        const measureCell = (cell: HTMLElement) => {
          const style = getComputedStyle(cell);
          const horizontalPadding =
            parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
          const children = Array.from(cell.children) as HTMLElement[];

          if (children.length === 0) {
            maxWidth = Math.max(maxWidth, Math.ceil(cell.getBoundingClientRect().width));
            return;
          }

          let contentWidth = 0;
          children.forEach((child, childIndex) => {
            contentWidth += Math.ceil(child.getBoundingClientRect().width);
            if (childIndex > 0) {
              contentWidth += 8;
            }
          });

          maxWidth = Math.max(
            maxWidth,
            contentWidth + horizontalPadding,
            Math.ceil(cell.scrollWidth),
            Math.ceil(cell.getBoundingClientRect().width),
          );
        };

        measureCell(headerCell);
        for (const row of bodyRows) {
          const cell = row.children[columnIndex] as HTMLElement | undefined;
          if (cell) {
            measureCell(cell);
          }
        }

        return maxWidth;
      }

      const FIXED_TABLE_COLUMN_CLASSES = [
        "dashboard-table__number-column",
        "dashboard-table__select-column",
        "dashboard-table__actions-column",
      ];

      function isFixedTableColumn(cell: Element) {
        return FIXED_TABLE_COLUMN_CLASSES.some((className) =>
          cell.classList.contains(className),
        );
      }

      function isBadgeOnlyTableCell(cell: HTMLElement) {
        if (cell.querySelector(".customer-credit-cell, .order-status-cell")) {
          return false;
        }

        if (cell.querySelector(".table-cell-trigger[data-open-cell-popover]")) {
          return false;
        }

        if (cell.classList.contains("dashboard-table__badge-column")) {
          return true;
        }

        const meaningfulChildren = [...cell.children].filter(
          (child) => !child.classList.contains("hidden-popover-form-holder"),
        );

        if (meaningfulChildren.length !== 1) {
          return false;
        }

        const content = meaningfulChildren[0];
        if (content.classList.contains("status-badge")) {
          return true;
        }

        return false;
      }

      function isBadgeTableColumn(
        bodyRows: HTMLTableRowElement[],
        columnIndex: number,
      ) {
        return bodyRows.some((row) => {
          const cell = row.children[columnIndex] as HTMLElement | undefined;
          if (!cell) return false;

          return isBadgeOnlyTableCell(cell);
        });
      }

      function markBadgeOnlyTableCells(board: HTMLElement) {
        const table = board.querySelector("table");
        const tbody = table?.querySelector("tbody");
        if (!tbody) return;

        for (const row of tbody.rows) {
          for (const cell of row.cells) {
            if (isBadgeOnlyTableCell(cell)) {
              cell.classList.add("dashboard-table__badge-only-cell");
            } else {
              cell.classList.remove("dashboard-table__badge-only-cell");
            }
          }
        }
      }

      function shouldSyncTableColumnWidth(
        headerCell: HTMLTableCellElement,
        bodyRows: HTMLTableRowElement[],
        columnIndex: number,
      ) {
        return isFixedTableColumn(headerCell)
          || headerCell.classList.contains("dashboard-table__badge-column")
          || isBadgeTableColumn(bodyRows, columnIndex);
      }

      function getSyncedTableColumnWidth(
        headerCell: HTMLTableCellElement,
        bodyRows: HTMLTableRowElement[],
        columnIndex: number,
      ) {
        if (headerCell.classList.contains("dashboard-table__actions-column")) {
          return measureActionColumnWidth(headerCell, bodyRows, columnIndex);
        }

        if (
          headerCell.classList.contains("dashboard-table__badge-column")
          || isBadgeTableColumn(bodyRows, columnIndex)
        ) {
          return measureContentColumnWidth(headerCell, bodyRows, columnIndex);
        }

        return Math.ceil(parseFloat(getComputedStyle(headerCell).width));
      }

      function syncDashboardTableBoardColumns(board: HTMLElement) {
        const table = board.querySelector("table");
        const thead = table?.querySelector("thead");
        const tbody = table?.querySelector("tbody");
        if (!table || !thead || !tbody) return;

        markBadgeOnlyTableCells(board);

        table.querySelectorAll<HTMLTableCellElement>("th, td").forEach((cell) => {
          cell.style.removeProperty("width");
          cell.style.removeProperty("min-width");
          cell.style.removeProperty("max-width");
        });

        const headerRow = thead.querySelector("tr");
        if (!headerRow) return;

        const headerCells = Array.from(headerRow.children) as HTMLTableCellElement[];
        const bodyRows = Array.from(tbody.querySelectorAll("tr")).filter(
          (row) => !row.classList.contains("empty-row"),
        );

        headerCells.forEach((headerCell, columnIndex) => {
          if (!shouldSyncTableColumnWidth(headerCell, bodyRows, columnIndex)) {
            return;
          }

          const widthPx = `${getSyncedTableColumnWidth(headerCell, bodyRows, columnIndex)}px`;
          const isActionsColumn = headerCell.classList.contains(
            "dashboard-table__actions-column",
          );
          headerCell.style.width = widthPx;
          headerCell.style.minWidth = widthPx;
          headerCell.style.maxWidth = isActionsColumn ? widthPx : "none";
          for (const row of bodyRows) {
            const cell = row.children[columnIndex] as HTMLElement | undefined;
            if (cell) {
              cell.style.width = widthPx;
              cell.style.minWidth = widthPx;
              cell.style.maxWidth = isActionsColumn ? widthPx : "none";
            }
          }
        });

        const tableWidth = Math.ceil(headerRow.getBoundingClientRect().width);
        board.style.setProperty(
          "--dashboard-table-sync-width",
          `${tableWidth}px`,
        );
      }

      function syncDashboardTableBoards(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>(".dashboard-table-board").forEach(
          (board) => {
            syncDashboardTableBoardColumns(board);
          },
        );
      }

      function initDashboardTableBoardAlignment(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>(".dashboard-table-board").forEach(
          (board) => {
            syncDashboardTableBoardColumns(board);

            if (boardAlignmentObservers.has(board)) return;

            const observer = new ResizeObserver(() => {
              if (isSidebarLayoutAnimationActive()) return;
              syncDashboardTableBoardColumns(board);
            });
            observer.observe(board);
            const tbody = board.querySelector("tbody");
            if (tbody) observer.observe(tbody);
            boardAlignmentObservers.set(board, observer);
          },
        );
      }

      function initInteractiveTables() {
        const interactiveTables = document.querySelectorAll<HTMLElement>(
          "[data-interactive-table]",
        );
        interactiveTables.forEach((container) => {
          if (container.dataset.serverPagination === "true") {
            return;
          }

          const tableGeneration = String(
            Number(container.dataset.interactiveTableGeneration || "0") + 1,
          );
          container.dataset.interactiveTableGeneration = tableGeneration;
          const searchInput = container.querySelector<HTMLInputElement>(
            "[data-search-input]",
          );
          const statusSelect = container.querySelector<HTMLSelectElement>(
            "[data-status-select]",
          );
          const limitSelect = container.querySelector<HTMLSelectElement>(
            "[data-limit-select]",
          );
          const prevBtn = container.querySelector<HTMLButtonElement>(
            "[data-pagination-prev]",
          );
          const nextBtn = container.querySelector<HTMLButtonElement>(
            "[data-pagination-next]",
          );
          const pageInput = container.querySelector<HTMLInputElement>(
            "[data-pagination-page-input]",
          );
          const totalPagesEl = container.querySelector<HTMLElement>(
            "[data-total-pages]",
          );
          const totalRecordsEl = container.querySelector<HTMLElement>(
            "[data-total-records]",
          );
          const cardsContainer = container.querySelector<HTMLElement>(
            "[data-interactive-cards]",
          );
          const tbody =
            container.querySelector<HTMLTableSectionElement>("tbody");

          let allRows: HTMLElement[];
          if (cardsContainer) {
            allRows = Array.from(
              cardsContainer.querySelectorAll<HTMLElement>("[data-interactive-row]"),
            );
          } else if (tbody) {
            allRows = Array.from(
              tbody.querySelectorAll<HTMLTableRowElement>("tr"),
            ).filter(
              (row) =>
                !row.classList.contains("empty-row") && row.querySelector("td"),
            );
          } else {
            return;
          }
          let filteredRows = [...allRows];
          let currentPage = 1;
          let limit = parseInt(limitSelect?.value || "10", 10);

          function isCurrentGeneration() {
            return container.dataset.interactiveTableGeneration === tableGeneration;
          }

          function updateTable() {
            if (!isCurrentGeneration()) return;

            const query = searchInput?.value.toLowerCase().trim() || "";
            const statusQuery = statusSelect?.value || "";

            // Filter rows
            filteredRows = allRows.filter((row) => {
              // Text Search filter (check text content of the row)
              const textMatch =
                query === "" || row.textContent?.toLowerCase().includes(query);

              // Status filter
              const rowStatus = row.dataset.status || "";
              const statusMatch =
                statusQuery === "" ||
                rowStatus.toLowerCase() === statusQuery.toLowerCase();

              return textMatch && statusMatch;
            });

            const totalRows = filteredRows.length;
            const totalPages = Math.ceil(totalRows / limit) || 1;

            if (currentPage > totalPages) {
              currentPage = totalPages;
            }

            const start = (currentPage - 1) * limit;
            const end = start + limit;

            if (pageInput && document.activeElement !== pageInput) {
              pageInput.value = String(currentPage);
            }
            if (totalPagesEl) {
              totalPagesEl.textContent = String(totalPages);
            }
            if (totalRecordsEl) {
              totalRecordsEl.textContent = formatRecordCount(totalRows);
            }

            // Hide/Show rows
            allRows.forEach((row) => {
              row.style.display = "none";
            });

            filteredRows.slice(start, end).forEach((row) => {
              row.style.display = "";
            });

            if (prevBtn) {
              prevBtn.disabled = currentPage === 1;
              prevBtn.dataset.page = String(Math.max(currentPage - 1, 1));
            }
            if (nextBtn) {
              nextBtn.disabled = currentPage === totalPages;
              nextBtn.dataset.page = String(Math.min(currentPage + 1, totalPages));
            }

            window.requestAnimationFrame(() => {
              container
                .querySelectorAll<HTMLElement>(".dashboard-table-board")
                .forEach((board) => {
                  syncDashboardTableBoardColumns(board);
                });
            });

            container.dispatchEvent(
              new CustomEvent("dashboard:interactive-table-page-changed", {
                bubbles: true,
              }),
            );
          }

          searchInput?.addEventListener("input", () => {
            if (!isCurrentGeneration()) return;
            currentPage = 1;
            updateTable();
          });

          statusSelect?.addEventListener("change", () => {
            if (!isCurrentGeneration()) return;
            currentPage = 1;
            updateTable();
          });

          limitSelect?.addEventListener("change", () => {
            if (!isCurrentGeneration()) return;
            limit = parseInt(limitSelect.value, 10);
            currentPage = 1;
            updateTable();
          });

          prevBtn?.addEventListener("click", () => {
            if (!isCurrentGeneration()) return;
            if (currentPage > 1) {
              currentPage--;
              updateTable();
            }
          });

          nextBtn?.addEventListener("click", () => {
            if (!isCurrentGeneration()) return;
            const totalPages = Math.ceil(filteredRows.length / limit) || 1;
            if (currentPage < totalPages) {
              currentPage++;
              updateTable();
            }
          });

          function applyPageInput() {
            if (!isCurrentGeneration() || !pageInput) return;

            const totalPages = Math.ceil(filteredRows.length / limit) || 1;
            const requestedPage = Number(pageInput.value);
            const nextPage = Number.isInteger(requestedPage) && requestedPage > 0
              ? Math.min(requestedPage, totalPages)
              : 1;

            currentPage = nextPage;
            pageInput.value = String(nextPage);
            updateTable();
          }

          pageInput?.addEventListener("change", applyPageInput);
          pageInput?.addEventListener("keydown", (event) => {
            if (event.key !== "Enter") return;
            event.preventDefault();
            applyPageInput();
          });

          // Initial update
          updateTable();
        });
      }

      function initDigitsOnlyInputs() {
        document.querySelectorAll<HTMLInputElement>("[data-digits-only]").forEach((input) => {
          if (input.dataset.digitsOnlyInitialized === "true") return;
          input.dataset.digitsOnlyInitialized = "true";

          const allowedKeys = new Set([
            "Backspace",
            "Delete",
            "Tab",
            "ArrowLeft",
            "ArrowRight",
            "Home",
            "End",
          ]);

          input.addEventListener("keydown", (event) => {
            if (allowedKeys.has(event.key) || event.ctrlKey || event.metaKey) return;
            if (!/^\d$/.test(event.key)) event.preventDefault();
          });

          input.addEventListener("input", () => {
            const digitsOnly = input.value.replace(/\D/g, "");
            if (input.value !== digitsOnly) input.value = digitsOnly;
          });
        });
      }

      function initDashboardFormSubmissionState() {
        initFormSubmissionState(document, {
          onSubmit: (form) => {
            clearDashboardFragmentCaches({
              markRefreshNeeded: !form.hasAttribute("data-astro-reload"),
            });
          },
        });
      }

      function initDashboardPostFormReloadOptOut() {
        document.querySelectorAll<HTMLFormElement>("form").forEach((form) => {
          if ((form.getAttribute("method") || "get").toLowerCase() !== "post") {
            return;
          }

          if (form.dataset.astroClientSubmit === "true") return;

          form.setAttribute("data-astro-reload", "");
        });
      }

      function initDashboardFeatures() {
        clearSystemIssueRetryState();
        initDashboardPostFormReloadOptOut();
        initDashboardDetailLinkPrefetchOptOut();
        initDashboardSidebarCollapse();
        initAdminMobileSidebar();
        initAgentMobileNavigation();
        initDashboardNavNavigation();
        initDashboardRouteLoading();
        initDashboardModals();
        initDashboardAlertDialogs();
        initSidebarUnreadBadges();
        initDashboardSheets();
        initDashboardCellPopovers();
        initDashboardTableBoardAlignment();
        initInteractiveTables();
        initDigitsOnlyInputs();
        initDashboardFormSubmissionState();
        initOrderDetailTabs();
        initDashboardRecordPageRefresh();
        initOrderProductQuantityForms();
        initOrderProductsList();
        initOrderPaymentFormToggle();
        initOrderStatusAutoSave();
        initTableActionMenus();
        initTableRowActionModals();
        initAdminOrdersFragmentTable();
        initAdminOrderBulkPdf();
        initAdminOrderPendingCustomersModal();
      }

      document.addEventListener("DOMContentLoaded", initDashboardFeatures);
      document.addEventListener("astro:after-swap", initDashboardFeatures);
      document.addEventListener("astro:page-load", initDashboardFeatures);
      document.addEventListener(
        "dashboard:interactive-table-updated",
        () => {
          initInteractiveTables();
          initDashboardTableBoardAlignment();
          initDigitsOnlyInputs();
        },
      );
      window.addEventListener("resize", () => {
        if (isSidebarLayoutAnimationActive()) return;
        syncDashboardTableBoards();
      });
      window.addEventListener("dashboard:sidebar-transition-end", () => {
        syncDashboardTableBoards();
      });
      if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
      ) {
        initDashboardFeatures();
      }
    </script>
  </body>
</html>
