---
import type { NavigationItem } from "@/config/navigation";
import AdminMobileSidebarChrome from "@/components/admin/AdminMobileSidebarChrome.astro";
import DashboardSidebar from "@/components/dashboard/DashboardSidebar.astro";
import AlertDialog from "@/components/ui/AlertDialog.astro";
import type { DashboardSidebarUnreadBadge } from "@/lib/dashboard/sidebar-navigation";
import { getDashboardPageTransitionName } from "@/lib/dashboard/page-transition";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

type Props = {
  title: string;
  description: string;
  navLabel: string;
  navItems: readonly NavigationItem[];
  sidebarUnreadBadges?: Record<string, DashboardSidebarUnreadBadge>;
};

const { title, description, navLabel, sidebarUnreadBadges = {} } = Astro.props;
const dashboardPageTransitionName = getDashboardPageTransitionName();
---

<!doctype html>
<html lang="en" style="font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" transition:persist />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
      transition:persist
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      transition:persist
    />
    <ClientRouter fallback="animate" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      try {
        if (localStorage.getItem("dashboard-sidebar-collapsed") === "true") {
          document.documentElement.classList.add("dashboard-sidebar-collapsed");
        }
      } catch {
        void 0;
      }
    </script>
    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
      }

      ::view-transition-old(dashboard-main-content),
      ::view-transition-new(dashboard-main-content) {
        animation: none;
      }

      html.dashboard-sidebar-mobile-open,
      html.dashboard-sidebar-mobile-open body {
        overflow: hidden;
      }
    </style>
  </head>
  <body class="dashboard-body dashboard-body--admin admin-content-dashboard-body">
    <AdminMobileSidebarChrome currentPath={Astro.url.pathname} />
    <div class="dashboard-frame admin-content-dashboard-frame">
      <DashboardSidebar navLabel={navLabel} sidebarUnreadBadges={sidebarUnreadBadges} />
      <main class="admin-content-dashboard-main">
        <div
          class="dashboard-route-skeleton"
          data-dashboard-route-skeleton
          hidden
          aria-hidden="true"
          aria-busy="true"
          aria-label="Loading page"
        >
          <div class="dashboard-route-skeleton__panel">
            <span class="table-skeleton-block table-skeleton-block--short dashboard-route-skeleton__title"></span>
            <span class="table-skeleton-block dashboard-route-skeleton__intro"></span>
            <div class="dashboard-route-skeleton__cards" aria-hidden="true">
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
              <span class="dashboard-route-skeleton__card"></span>
            </div>
            <span class="table-skeleton-block table-skeleton-block--wide dashboard-route-skeleton__block"></span>
            <span class="table-skeleton-block dashboard-route-skeleton__block"></span>
            <span class="table-skeleton-block table-skeleton-block--short dashboard-route-skeleton__block"></span>
          </div>
        </div>
        <div
          class="admin-content-dashboard-main__content"
          transition:name={dashboardPageTransitionName}
          transition:animate="none"
        >
          <slot />
        </div>
      </main>
    </div>

    <form
      id="dashboard-logout-form"
      method="post"
      action="/api/logout"
      data-astro-reload
      hidden
    ></form>
    <AlertDialog
      id="dashboard-logout-dialog"
      title="Sign out?"
      description="You will need to sign in again to access your dashboard."
      confirmLabel="Sign out"
      cancelLabel="Stay signed in"
      variant="danger"
    />

    <div class="cell-popover" id="cell-popover" aria-hidden="true">
      <div class="cell-popover__card" data-cell-popover-mount></div>
    </div>

    <script>
      import { initDashboardAlertDialogs } from "@/lib/client/dashboard-alert-dialog";
      import { initDashboardNavNavigation } from "@/lib/client/dashboard-nav";
      import { initDashboardRouteLoading } from "@/lib/client/dashboard-route-loading";
      import { initDashboardSidebarUnreadBadges } from "@/lib/client/dashboard-sidebar-badges";
      import { initDashboardSidebarCollapse } from "@/lib/client/dashboard-sidebar";
      import { initAdminMobileSidebar } from "@/lib/client/dashboard-admin-mobile-sidebar";
      import { initDashboardDetailLinkPrefetchOptOut } from "@/lib/client/dashboard-prefetch";
      import { initDashboardCellPopovers } from "@/lib/client/dashboard-cell-popover";
      import { initPageSectionContentEditors } from "@/lib/client/page-section-content-editor";
      import { initSiteNavSmartScroll } from "@/lib/client/site-nav-smart-scroll";

      function initAdminContentDashboardFeatures() {
        initDashboardDetailLinkPrefetchOptOut();
        initDashboardSidebarCollapse();
        initAdminMobileSidebar();
        initDashboardNavNavigation();
        initDashboardRouteLoading();
        initDashboardSidebarUnreadBadges();
        initDashboardAlertDialogs();
        initDashboardCellPopovers();
        initPageSectionContentEditors();
        initSiteNavSmartScroll();
      }

      document.addEventListener("DOMContentLoaded", initAdminContentDashboardFeatures);
      document.addEventListener("astro:after-swap", initAdminContentDashboardFeatures);
      if (document.readyState !== "loading") {
        initAdminContentDashboardFeatures();
      }
    </script>
  </body>
</html>

<style>
  .admin-content-dashboard-body {
    height: 100dvh;
    overflow: hidden;
  }

  :global(html:has(.admin-content-dashboard-body)) {
    overflow: hidden;
  }

  .admin-content-dashboard-frame {
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }

  .admin-content-dashboard-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    padding: 0;
    position: relative;
  }

  .admin-content-dashboard-main--loading .admin-content-dashboard-main__content {
    visibility: hidden;
    pointer-events: none;
  }

  .admin-content-dashboard-main__content {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    height: 0;
    overflow: hidden;
  }
</style>
