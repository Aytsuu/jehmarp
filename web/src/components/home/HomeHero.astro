---
import AdminContentEditable from "@/components/admin/AdminContentEditable.astro";
import AdminHeroCarouselEditor from "@/components/admin/AdminHeroCarouselEditor.astro";
import type { PublicPageSectionRecord } from "@/lib/public-website/content";
import type { AdminContentEditingContext } from "@/lib/public-website/admin-content-editing";
import { getHeroSlides } from "@/lib/public-website/home-hero-slides";
import { toAdminContentPreviewHref } from "@/lib/public-website/admin-content-preview";

type Props = {
  section: PublicPageSectionRecord;
  previewRoot?: string;
  contentEditing?: AdminContentEditingContext;
};

const { section, previewRoot, contentEditing } = Astro.props;

function linkHref(href: string) {
  return previewRoot ? toAdminContentPreviewHref(href) : href;
}

function stringValue(value: unknown): string | undefined {
  return typeof value === "string" && value.trim().length > 0
    ? value.trim()
    : undefined;
}

const heading = stringValue(section.content.heading) ?? "JEHMARP";
const summary = stringValue(section.content.summary);
const supportingText = stringValue(section.content.supportingText);
const heroSlides = getHeroSlides(section.content);
---

<section class="home-hero" aria-labelledby="home-hero-heading">
  <div class="home-hero__slides">
    {
      heroSlides.map((slide, index) => (
        <div
          class:list={[
            "home-hero__slide",
            index === 0 && "home-hero__slide--active",
          ]}
          data-slide-index={index}
        >
          <img
            src={slide.displaySrc}
            alt={slide.alt}
            class="home-hero__slide-image"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="home-hero__overlay"></div>
  <div class="home-hero__content">
    <AdminContentEditable
      contentEditing={contentEditing}
      section={section}
      fieldKey="heading"
      fieldLabel="Hero heading"
      value={heading}
      class="admin-content-editable--inline"
    >
      <h1 id="home-hero-heading" class="home-hero__title">{heading}</h1>
    </AdminContentEditable>
    {
      summary && <p class="home-hero__summary">{summary}</p>
    }
    {
      supportingText && (
        <AdminContentEditable
          contentEditing={contentEditing}
          section={section}
          fieldKey="supportingText"
          fieldLabel="Hero supporting text"
          value={supportingText}
          multiline
        >
          <p class="home-hero__supporting-text">{supportingText}</p>
        </AdminContentEditable>
      )
    }

    <div class="home-hero__actions">
      <a
        href={linkHref("/shop")}
        class="public-pill-button public-pill-button--light"
      >
        Browse shop
      </a>
    </div>
  </div>

  <div class="home-hero__carousel-footer">
    {
      contentEditing && (
        <AdminHeroCarouselEditor
          contentEditing={contentEditing}
          section={section}
          slides={heroSlides}
        />
      )
    }

    <div class="home-hero__indicators" aria-label="Hero carousel navigation">
      {
        heroSlides.map((_, index) => (
          <button
            class:list={[
              "home-hero__indicator-dot",
              index === 0 && "home-hero__indicator-dot--active",
            ]}
            aria-label={`Go to slide ${index + 1}`}
            aria-current={index === 0 ? "true" : undefined}
            data-indicator-index={index}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initHomeHeroCarousel, registerHomeHeroCarouselListeners } from "@/lib/client/home-hero-carousel";

  registerHomeHeroCarouselListeners();

  function init() {
    initHomeHeroCarousel();
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:after-swap", init);
  if (document.readyState !== "loading") {
    init();
  }
</script>
