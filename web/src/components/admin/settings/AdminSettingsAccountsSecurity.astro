---
import AdminSettingsAgentsTable from "@/components/admin/settings/AdminSettingsAgentsTable.astro";
import Button from "@/components/ui/Button.astro";
import Sheet from "@/components/ui/Sheet.astro";
import type { AdminAgentManagementData } from "@/lib/admin-dashboard/data";

type Props = {
  agentsData: AdminAgentManagementData;
  agentsPaginationQuery: string;
};

const { agentsData, agentsPaginationQuery } = Astro.props;
---

<section class="admin-settings-card" data-admin-settings-accounts>
  <header class="admin-settings-card__header">
    <h3>Accounts &amp; security</h3>
    <p>Update your admin password and manage agent login accounts.</p>
  </header>

  <div class="admin-settings-section-row">
    <div class="admin-settings-section-row__intro">
      <h4>Admin password</h4>
      <p>Update your admin sign-in password. You will need your current password to confirm the change.</p>
    </div>
    <div class="admin-settings-section-row__content">
      <Button
        type="button"
        variant="outlined"
        data-open-create-sheet
        data-sheet-target="#admin-reset-password-sheet"
      >
        Reset password
      </Button>
    </div>
  </div>

  <Sheet
    id="admin-reset-password-sheet"
    header="Reset admin password"
    description="Enter your current password, then choose a new password with at least 8 characters."
    width="34rem"
  >
    <form
      id="admin-reset-password-form"
      method="post"
      class="admin-form agent-create-form"
      aria-label="Reset admin password"
      data-astro-reload
    >
      <input type="hidden" name="action" value="change-admin-password" />
      <div class="admin-form-grid agent-create-form__grid">
        <label class="field-row">
          <span>Current password</span>
          <input name="currentPassword" type="password" autocomplete="current-password" required />
        </label>
        <label class="field-row">
          <span>New password</span>
          <input name="newPassword" type="password" autocomplete="new-password" minlength="8" required />
        </label>
        <label class="field-row">
          <span>Confirm new password</span>
          <input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required />
        </label>
      </div>
    </form>
    <div slot="footer" class="order-create-sheet__footer">
      <Button type="submit" form="admin-reset-password-form">Update password</Button>
    </div>
  </Sheet>

  <div class="admin-settings-section-row" data-admin-settings-agents>
    <div class="admin-settings-section-row__intro">
      <h4>Agent accounts</h4>
      <p>Deactivate accounts to block sign-in, or send a password reset email to the agent.</p>
    </div>
    <div class="admin-settings-section-row__content">
      <AdminSettingsAgentsTable data={agentsData} paginationQuery={agentsPaginationQuery} />
    </div>
  </div>
</section>

<style>
  .admin-settings-card {
    min-width: 0;
    max-width: 100%;
    display: grid;
    gap: 0;
  }

  .admin-settings-card__header {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .admin-settings-card__header h3,
  .admin-settings-card__header p {
    margin: 0;
  }

  .admin-settings-card__header h3 {
    font-size: 1.2rem;
    line-height: 1.16;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #111827;
  }

  .admin-settings-card__header p {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(75, 85, 99, 0.9);
  }

</style>
