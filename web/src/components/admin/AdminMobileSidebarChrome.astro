---
import { getActiveDashboardSidebarItem } from "@/lib/dashboard/sidebar-navigation";

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
const activeItem = getActiveDashboardSidebarItem(currentPath, true);
const fallbackIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>`;
---

<div class="admin-sidebar-mobile-chrome" data-admin-sidebar-mobile-chrome>
  <button
    type="button"
    class="admin-sidebar-mobile-toggle"
    data-admin-sidebar-mobile-toggle
    data-edge="right"
    aria-expanded="false"
    aria-controls="dashboard-sidebar-mobile-panel"
    aria-label={activeItem ? `Open ${activeItem.label} menu` : "Open admin menu"}
  >
    <span class="admin-sidebar-mobile-toggle__drag-surface" aria-hidden="true">
      <svg
        class="admin-sidebar-mobile-toggle__drag-surface-svg"
        viewBox="0 0 72 104"
        preserveAspectRatio="none"
        focusable="false"
        aria-hidden="true"
      >
        <path
          d="M 8,14 H 44 Q 52,14 52,22 V 39 C 56.5,40.5 65.5,45 72,52 C 65.5,59 56.5,63.5 52,65 V 82 Q 52,90 44,90 H 8 Q 0,90 0,82 V 22 Q 0,14 8,14 Z"
        ></path>
      </svg>
    </span>
    <span
      class="admin-sidebar-mobile-toggle__icon nav-icon-wrapper"
      data-admin-sidebar-mobile-toggle-icon
      set:html={activeItem?.icon ?? fallbackIcon}
    />
  </button>
  <button
    type="button"
    class="admin-sidebar-mobile-backdrop"
    data-admin-sidebar-mobile-backdrop
    hidden
    aria-hidden="true"
    tabindex="-1"
  ></button>
</div>
