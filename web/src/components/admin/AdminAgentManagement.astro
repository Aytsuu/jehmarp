---
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import Popover from "@/components/ui/Popover.astro";
import Button from "@/components/ui/Button.astro";
import Modal from "@/components/ui/Modal.astro";
import Sheet from "@/components/ui/Sheet.astro";
import ViewButton from "@/components/ViewButton.astro";
import type { AdminAgentManagementData } from "@/lib/admin-dashboard/data";
import type { AdminAgentFilters } from "@/lib/admin-dashboard/agent-filters";
import { agentStatuses } from "@/lib/admin-dashboard/agent-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatDate, formatAgentCode } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminAgentManagementData;
  activeFilters: AdminAgentFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
---

<section
  id="admin-agents"
  class="admin-panel"
  data-admin-agents-page
  aria-labelledby="admin-agents-title"
>
  <Sheet id="create-agent-sheet" width="42rem">
    <div slot="header" class="agent-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Agent</h3>
      <p class="agent-create-sheet__header-description">
        Add the agent's profile details. Email and temporary password are only needed when the agent should be able to log in.
      </p>
    </div>
    <form id="create-agent-form" method="post" class="admin-form agent-create-form agent-sheet-create-form" aria-label="Create agent" data-astro-reload>
      <input type="hidden" name="action" value="create-agent" />
      <div class="admin-form-grid agent-create-form__grid agent-sheet-create-form__grid">
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Employee ID</span>
          </span>
          <input name="employeeId" autocomplete="off" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">First Name</span>
          </span>
          <input name="firstName" required autocomplete="given-name" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Last Name</span>
          </span>
          <input name="lastName" required autocomplete="family-name" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Email</span>
          </span>
          <input name="email" type="email" autocomplete="email" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Contact Number</span>
            <span class="field-row__description">11-digit mobile number.</span>
          </span>
          <input
            name="contact"
            type="tel"
            inputmode="numeric"
            pattern="[0-9]{11}"
            minlength="11"
            maxlength="11"
            required
            autocomplete="tel"
            data-digits-only
          />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Address</span>
          </span>
          <textarea name="address" required rows="3" autocomplete="street-address"></textarea>
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Temporary Password</span>
            <span class="field-row__description">Only needed when the agent should be able to log in.</span>
          </span>
          <input name="password" type="password" minlength="8" autocomplete="new-password" />
        </label>
      </div>
    </form>
    <div slot="footer" class="agent-create-sheet__footer">
      <button type="submit" form="create-agent-form">Create agent</button>
    </div>
  </Sheet>

  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/agents"
        class="order-filter-form order-filter-form--paired"
        data-agent-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter agents"
      >
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search agent code, name, email, or contact..."
              autocomplete="off"
              aria-label="Search agents"
              data-agent-search-input
            />
          </div>
          <div class="product-filter-form__toolbar-actions">
            <button
              type="button"
              class="product-filter-form__icon-trigger"
              data-agent-filter-modal-trigger
              data-open-dashboard-modal="agent-filters-modal"
              aria-label="Open agent filters"
              aria-pressed="false"
              aria-controls="agent-filters-modal"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
            </button>
            <button
              type="button"
              class="product-filter-form__icon-trigger product-filter-form__create-trigger"
              data-open-create-sheet
              data-sheet-target="#create-agent-sheet"
              aria-label="Create agent"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-filter-form__advanced-filters">
          <div class="order-filter-form__field">
            <select
              name="status"
              data-agent-filter-field="status"
              aria-label="Filter by status"
            >
              <option value="">All statuses</option>
              {agentStatuses.map((status) => (
                <option value={status} selected={activeFilters.status === status}>
                  {autoCapitalize(status)}
                </option>
              ))}
            </select>
          </div>
        </div>
      </form>

      <div class="order-management-toolbar__actions">
        <Button
          type="button"
          class="order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-agent-sheet"
        >
          Create Agent
        </Button>
      </div>
    </div>

    <div data-agent-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col">Date Created</th>
              <th scope="col">Agent Code</th>
              <th scope="col">Agent</th>
              <th scope="col">Employee ID</th>
              <th scope="col">Email</th>
              <th scope="col">Contact</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {data.agents.length === 0 ? (
              <DashboardTableEmptyState
                colspan={8}
                message="No agents match the selected filters."
              />
            ) : data.agents.map((agent, index) => (
              <tr data-status={agent.status}>
                <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                <td>{formatDate(agent.created_at)}</td>
                <td>{formatAgentCode(agent.id)}</td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{agent.display_name}</span>
                  </button>
                  <Popover title={`Edit Agent: ${agent.display_name}`}>
                      <input type="hidden" name="action" value="update-agent" />
                      <input type="hidden" name="agentId" value={agent.id} />
                      <input type="hidden" name="status" value={agent.status} />
                      <input type="hidden" name="contact" value={agent.contact ?? ""} />
                      <input type="hidden" name="email" value={agent.email ?? ""} />
                      <label><span>Employee ID</span><input name="employeeId" value={agent.employee_id ?? ""} /></label>
                      <label><span>First name</span><input name="firstName" value={agent.first_name} required /></label>
                      <label><span>Last name</span><input name="lastName" value={agent.last_name} required /></label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{agent.employee_id ?? "No employee ID"}</span>
                  </button>
                  <Popover title={`Edit Employee ID: ${agent.display_name}`}>
                      <input type="hidden" name="action" value="update-agent" />
                      <input type="hidden" name="agentId" value={agent.id} />
                      <input type="hidden" name="firstName" value={agent.first_name} />
                      <input type="hidden" name="lastName" value={agent.last_name} />
                      <input type="hidden" name="status" value={agent.status} />
                      <input type="hidden" name="contact" value={agent.contact ?? ""} />
                      <input type="hidden" name="email" value={agent.email ?? ""} />
                      <label><span>Employee ID</span><input name="employeeId" value={agent.employee_id ?? ""} /></label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{agent.email ?? "No email"}</span>
                  </button>
                  <Popover title={`Edit Email: ${agent.display_name}`}>
                      <input type="hidden" name="action" value="update-agent" />
                      <input type="hidden" name="agentId" value={agent.id} />
                      <input type="hidden" name="employeeId" value={agent.employee_id ?? ""} />
                      <input type="hidden" name="firstName" value={agent.first_name} />
                      <input type="hidden" name="lastName" value={agent.last_name} />
                      <input type="hidden" name="status" value={agent.status} />
                      <input type="hidden" name="contact" value={agent.contact ?? ""} />
                      <label><span>Email</span><input name="email" type="email" value={agent.email ?? ""} autocomplete="email" /></label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{agent.contact ?? "No contact"}</span>
                  </button>
                  <Popover title={`Edit Contact: ${agent.display_name}`}>
                      <input type="hidden" name="action" value="update-agent" />
                      <input type="hidden" name="agentId" value={agent.id} />
                      <input type="hidden" name="employeeId" value={agent.employee_id ?? ""} />
                      <input type="hidden" name="firstName" value={agent.first_name} />
                      <input type="hidden" name="lastName" value={agent.last_name} />
                      <input type="hidden" name="status" value={agent.status} />
                      <input type="hidden" name="email" value={agent.email ?? ""} />
                      <label>
                        <span>Contact number</span>
                        <input
                          name="contact"
                          type="tel"
                          value={agent.contact ?? ""}
                          inputmode="numeric"
                          pattern="[0-9]{11}"
                          minlength="11"
                          maxlength="11"
                          required
                          autocomplete="tel"
                          data-digits-only
                        />
                      </label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__actions-column"><ViewButton href={`/admin/agents/${agent.id}`} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-agent-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered agents</caption>
        <thead><tr><DashboardTableNumberHeader /><th scope="col">Date Created</th><th scope="col">Agent Code</th><th scope="col">Agent</th><th scope="col">Employee ID</th><th scope="col">Email</th><th scope="col">Contact</th><DashboardTableActionsHeader /></tr></thead>
        <tbody>{skeletonRows.map(() => (<tr><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td><td><span class="table-skeleton-block table-skeleton-block--short"></span></td></tr>))}</tbody>
      </table>
    </DashboardTableBoard>
  </template>

  <Modal
    id="agent-filters-modal"
    title="Filter agents"
    description="Narrow agents by status."
  >
    <div class="product-filter-modal">
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Status</span>
        <select data-agent-filter-field="status" aria-label="Filter by status">
          <option value="">All statuses</option>
          {agentStatuses.map((status) => (
            <option value={status} selected={activeFilters.status === status}>
              {autoCapitalize(status)}
            </option>
          ))}
        </select>
      </label>
      <div class="product-filter-modal__actions">
        <button type="button" class="product-filter-modal__clear" data-agent-filter-modal-clear>
          Clear
        </button>
        <button type="button" class="product-filter-modal__apply" data-agent-filter-modal-apply>
          Apply filters
        </button>
      </div>
    </div>
  </Modal>
</section>

<script>
  import { initDashboardFilterModals } from "@/lib/client/dashboard-filter-modal";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";

  function initAdminAgentFilters() {
    initDashboardFilterModals();
    initDashboardFragmentTable({
      cacheKey: "admin-agents-filter-cache-v2",
      fragmentPath: "/admin/agents-fragment",
      pagePath: "/admin/agents",
      formSelector: "[data-agent-filter-form]",
      tableShellSelector: "[data-agent-table-shell]",
      skeletonTemplateSelector: "[data-agent-filter-skeleton]",
      filterKeys: ["search", "status"],
      searchInputSelector: "[data-agent-search-input]",
      historyStateKey: "agentFilterQuery",
    });
  }
  document.addEventListener("DOMContentLoaded", initAdminAgentFilters);
  document.addEventListener("astro:after-swap", initAdminAgentFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminAgentFilters();
</script>
