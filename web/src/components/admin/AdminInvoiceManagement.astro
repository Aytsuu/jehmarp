---
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import TableActionMenu from "@/components/TableActionMenu.astro";
import TableRowActionsModal from "@/components/TableRowActionsModal.astro";
import Modal from "@/components/ui/Modal.astro";
import type { AdminInvoiceManagementData } from "@/lib/admin-dashboard/data";
import type { AdminInvoiceFilters } from "@/lib/admin-dashboard/invoice-filters";
import { invoiceBalanceStatuses } from "@/lib/admin-dashboard/invoice-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatCurrency, formatDate } from "@/lib/admin-dashboard/view";

type Props = {
  data: AdminInvoiceManagementData;
  activeFilters: AdminInvoiceFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });

function formatBalanceStatus(status: (typeof invoiceBalanceStatuses)[number]) {
  if (status === "partial") return "Partial payment";
  return status === "paid" ? "Paid" : "Unpaid";
}
---

<section
  id="admin-invoices"
  class="admin-panel"
  data-admin-invoices-page
  aria-labelledby="admin-invoices-title"
>
  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/invoices"
        class="order-filter-form order-filter-form--paired"
        data-invoice-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter invoices"
      >
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search invoice number or customer name..."
              autocomplete="off"
              aria-label="Search invoices"
              data-invoice-search-input
            />
          </div>
          <div class="product-filter-form__toolbar-actions">
            <button
              type="button"
              class="product-filter-form__icon-trigger"
              data-invoice-filter-modal-trigger
              data-open-dashboard-modal="invoice-filters-modal"
              aria-label="Open invoice filters"
              aria-pressed="false"
              aria-controls="invoice-filters-modal"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-filter-form__advanced-filters">
          <div class="order-filter-form__field">
            <select
              name="balanceStatus"
              data-invoice-filter-field="balanceStatus"
              aria-label="Filter by balance status"
            >
              <option value="">All balances</option>
              {invoiceBalanceStatuses.map((status) => (
                <option value={status} selected={activeFilters.balanceStatus === status}>
                  {formatBalanceStatus(status)}
                </option>
              ))}
            </select>
          </div>
        </div>
      </form>
    </div>

    <div data-invoice-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col">Date Created</th>
              <th scope="col">Invoice Number</th>
              <th scope="col">Customer</th>
              <th scope="col">Invoice Total</th>
              <th scope="col">Paid</th>
              <th scope="col">Balance</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {data.invoiceRows.length === 0 ? (
              <DashboardTableEmptyState
                colspan={8}
                message="No invoices match the selected filters."
              />
            ) : data.invoiceRows.map((invoice, index) => {
              const salesInvoicePdfHref = `/admin/orders/customer/${invoice.order_id}/sales-invoice.pdf`;
              const orderDetailsHref = `/admin/orders/customer/${invoice.order_id}`;

              return (
                <tr data-status={invoice.payment_status}>
                  <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                  <td>{formatDate(invoice.invoice_created_at)}</td>
                  <td class="dashboard-table__cell--truncate">
                    {invoice.invoice_number}
                  </td>
                  <td class="dashboard-table__cell--truncate">
                    {invoice.customer_label || "Guest"}
                  </td>
                  <td>{formatCurrency(invoice.invoice_total)}</td>
                  <td>{formatCurrency(invoice.paid_total)}</td>
                  <td>{formatCurrency(invoice.balance)}</td>
                  <td class="dashboard-table__actions-column">
                    <TableActionMenu
                      menuLabel={`Open actions for ${invoice.invoice_number}`}
                      pdfHref={salesInvoicePdfHref}
                      detailsHref={orderDetailsHref}
                      mobileModalId="invoice-row-actions-modal"
                    />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-invoice-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered invoices</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <th scope="col">Date Created</th>
            <th scope="col">Invoice Number</th>
            <th scope="col">Customer</th>
            <th scope="col">Invoice Total</th>
            <th scope="col">Paid</th>
            <th scope="col">Balance</th>
            <DashboardTableActionsHeader />
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>

  <TableRowActionsModal
    id="invoice-row-actions-modal"
    title="Invoice actions"
    description="Choose an action for this invoice."
  />

  <Modal
    id="invoice-filters-modal"
    title="Filter invoices"
    description="Narrow invoices by balance status."
  >
    <div class="product-filter-modal">
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Balance status</span>
        <select data-invoice-filter-field="balanceStatus" aria-label="Filter by balance status">
          <option value="">All balances</option>
          {invoiceBalanceStatuses.map((status) => (
            <option value={status} selected={activeFilters.balanceStatus === status}>
              {formatBalanceStatus(status)}
            </option>
          ))}
        </select>
      </label>
      <div class="product-filter-modal__actions">
        <button type="button" class="product-filter-modal__clear" data-invoice-filter-modal-clear>
          Clear
        </button>
        <button type="button" class="product-filter-modal__apply" data-invoice-filter-modal-apply>
          Apply filters
        </button>
      </div>
    </div>
  </Modal>
</section>

<script>
  import { initDashboardFilterModals } from "@/lib/client/dashboard-filter-modal";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";

  function initAdminInvoiceFilters() {
    initDashboardFilterModals();
    initDashboardFragmentTable({
      cacheKey: "admin-invoices-filter-cache-v2",
      fragmentPath: "/admin/invoices-fragment",
      pagePath: "/admin/invoices",
      formSelector: "[data-invoice-filter-form]",
      tableShellSelector: "[data-invoice-table-shell]",
      skeletonTemplateSelector: "[data-invoice-filter-skeleton]",
      filterKeys: ["search", "balanceStatus"],
      searchInputSelector: "[data-invoice-search-input]",
      historyStateKey: "invoiceFilterQuery",
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminInvoiceFilters);
  document.addEventListener("astro:after-swap", initAdminInvoiceFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminInvoiceFilters();
  }
</script>
