---
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import Popover from "@/components/ui/Popover.astro";
import Button from "@/components/ui/Button.astro";
import Picker from "@/components/ui/Picker.astro";
import Modal from "@/components/ui/Modal.astro";
import Sheet from "@/components/ui/Sheet.astro";
import ViewButton from "@/components/ViewButton.astro";
import type { AdminCustomerManagementData } from "@/lib/admin-dashboard/data";
import type { AdminCustomerFilters } from "@/lib/admin-dashboard/customer-filters";
import { customerTypes } from "@/lib/admin-dashboard/customer-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatCompactCurrency, formatDate, fullName, selected } from "@/lib/admin-dashboard/view";

type Props = {
  data: AdminCustomerManagementData;
  activeFilters: AdminCustomerFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
const activeAgents = data.agents.filter((agent) => agent.status === "active");

function formatCustomerType(customerType: (typeof customerTypes)[number]) {
  return customerType === "reseller" ? "Reseller" : "Retail";
}

function formatRegistrationAgentLabel(agent: (typeof activeAgents)[number]) {
  return `${agent.display_name}${agent.employee_id ? ` (${agent.employee_id})` : ""}`;
}
---

<section
  id="admin-customers"
  class="admin-panel"
  data-admin-customers-page
  aria-labelledby="admin-customers-title"
>
  <Sheet id="create-customer-sheet" width="42rem">
    <div slot="header" class="agent-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Customer</h3>
      <p class="agent-create-sheet__header-description">
        Add an existing customer record and set the unpaid-order credit cap used during order creation.
      </p>
    </div>
    <form id="create-customer-form" method="post" class="admin-form agent-create-form customer-create-form" aria-label="Create customer" data-astro-reload>
      <input type="hidden" name="action" value="save-customer" />
      <div class="admin-form-grid agent-create-form__grid customer-create-form__grid">
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">First Name</span>
          </span>
          <input name="firstName" required autocomplete="given-name" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Last Name</span>
          </span>
          <input name="lastName" required autocomplete="family-name" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Phone Number</span>
          </span>
          <input name="phoneNumber" required inputmode="tel" autocomplete="tel" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Email</span>
          </span>
          <input name="email" type="email" autocomplete="email" />
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Assigned Agent</span>
          </span>
          <select name="assignedAgentId">
            <option value="">None</option>
            {data.agents.map((agent) => (
              <option value={agent.id}>
                {agent.display_name}
                {agent.employee_id ? ` (${agent.employee_id})` : ""}
              </option>
            ))}
          </select>
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Credit Limit</span>
            <span class="field-row__description">Unpaid-order credit cap used during order creation.</span>
          </span>
          <input name="creditLimit" type="number" min="0" step="1" value={data.defaultCustomerCreditLimit} required />
        </label>
        <label class="checkbox-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Reseller?</span>
            <span class="field-row__description">Uses reseller pricing when applicable.</span>
          </span>
          <span class="field-row__control customer-create-form__checkbox-control">
            <input name="isReseller" type="checkbox" />
          </span>
        </label>
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Address</span>
          </span>
          <textarea name="address" required rows="3"></textarea>
        </label>
      </div>
    </form>
    <div slot="footer" class="agent-create-sheet__footer">
      <button type="submit" form="create-customer-form">Create customer</button>
    </div>
  </Sheet>

  <Sheet id="create-customer-registration-link-sheet" width="42rem">
    <div slot="header" class="agent-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Registration Link</h3>
      <p class="agent-create-sheet__header-description">
        Send a temporary customer registration link to selected agents. Customers can use the link until it expires.
      </p>
    </div>
    <form
      id="create-customer-registration-link-form"
      method="post"
      class="admin-form agent-create-form customer-create-form"
      aria-label="Create customer registration link"
      data-customer-registration-link-form
      data-astro-reload
    >
      <input type="hidden" name="action" value="create-customer-registration-link" />
      <input type="hidden" name="baseUrl" value={Astro.url.origin} />
      <div class="admin-form-grid agent-create-form__grid customer-create-form__grid">
        <label class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Duration</span>
            <span class="field-row__description">How long the registration link stays active.</span>
          </span>
          <select name="duration" required>
            <option value="30m">30 minutes</option>
            <option value="1h">1 hour</option>
            <option value="3h">3 hours</option>
            <option value="12h">12 hours</option>
            <option value="1d">1 day</option>
          </select>
        </label>
        <div class="field-row field-row--split">
          <span class="field-row__meta">
            <span class="field-row__label">Notify Agents</span>
            <span class="field-row__description">Optional. Choose which agents receive the registration link.</span>
          </span>
          <div class="field-row__control">
            <Picker
              multiple
              disabled={activeAgents.length === 0}
              placeholder="Search agents..."
              searchLabel="Search agents"
              toggleAriaLabel="Show agents"
              summaryText="Search or select agents to notify."
              emptyMessage={activeAgents.length === 0
                ? "No active agents are available."
                : "No matching agents found."}
              showSummary={false}
              showPagination={false}
            />
            <div data-selected-registration-agent-inputs hidden></div>
            <template data-registration-agent-picker-template>
              {activeAgents.map((agent) => {
                const label = formatRegistrationAgentLabel(agent);
                return (
                  <label
                    class="order-customer-picker__option ui-picker__option--checkbox"
                    data-ui-picker-option
                    data-ui-picker-option-value={agent.id}
                    data-ui-picker-option-label={label}
                    data-ui-picker-option-search={label.toLowerCase()}
                  >
                    <input
                      type="checkbox"
                      class="ui-picker__option-checkbox"
                      value={agent.id}
                      data-ui-picker-option-checkbox
                    />
                    <span class="order-customer-picker__option-name">{agent.display_name}</span>
                    {agent.employee_id && (
                      <span class="order-customer-picker__option-type">{agent.employee_id}</span>
                    )}
                  </label>
                );
              })}
            </template>
          </div>
        </div>
      </div>
    </form>
    <div slot="footer" class="agent-create-sheet__footer">
      <button type="submit" form="create-customer-registration-link-form">Create link</button>
    </div>
  </Sheet>

  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/customers"
        class="order-filter-form order-filter-form--paired"
        data-customer-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter customers"
      >
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search name, email, contact, tracking number, or assigned agent..."
              autocomplete="off"
              aria-label="Search customers"
              data-customer-search-input
            />
          </div>
          <div class="product-filter-form__toolbar-actions">
            <button
              type="button"
              class="product-filter-form__icon-trigger"
              data-customer-filter-modal-trigger
              data-open-dashboard-modal="customer-filters-modal"
              aria-label="Open customer filters"
              aria-pressed="false"
              aria-controls="customer-filters-modal"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
            </button>
            <button
              type="button"
              class="product-filter-form__icon-trigger"
              data-open-create-sheet
              data-sheet-target="#create-customer-registration-link-sheet"
              aria-label="Create registration link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            </button>
            <button
              type="button"
              class="product-filter-form__icon-trigger product-filter-form__create-trigger"
              data-open-create-sheet
              data-sheet-target="#create-customer-sheet"
              aria-label="Create customer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-filter-form__advanced-filters">
          <div class="order-filter-form__field">
            <select
              name="customerType"
              data-customer-filter-field="customerType"
              aria-label="Filter by customer type"
            >
              <option value="">All types</option>
              {customerTypes.map((customerType) => (
                <option value={customerType} selected={activeFilters.customerType === customerType}>
                  {formatCustomerType(customerType)}
                </option>
              ))}
            </select>
          </div>
        </div>
      </form>

      <div class="order-management-toolbar__actions">
        <Button
          type="button"
          variant="outlined"
          class="order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-customer-registration-link-sheet"
        >
          Create Registration Link
        </Button>
        <Button
          type="button"
          class="order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-customer-sheet"
        >
          Create Customer
        </Button>
      </div>
    </div>

    <div data-customer-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col">Date Created</th>
              <th scope="col">Customer</th>
              <th scope="col">Tracking</th>
              <th scope="col">Email</th>
              <th scope="col">Contact</th>
              <th scope="col">Type</th>
              <th scope="col">Assigned Agent</th>
              <th scope="col">Credit</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {data.customers.length === 0 ? (
              <DashboardTableEmptyState
                colspan={10}
                message="No customers match the selected filters."
              />
            ) : data.customers.map((customer, index) => (
              <tr>
                <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                <td>{formatDate(customer.created_at)}</td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span class="order-customer-cell">
                      <span class="order-customer-cell__name">{fullName(customer)}</span>
                    </span>
                  </button>
                  <Popover title={`Edit Customer: ${fullName(customer)}`}>
                      <input type="hidden" name="action" value="save-customer" />
                      <input type="hidden" name="customerId" value={customer.id} />
                      <label><span>First name</span><input name="firstName" value={customer.first_name} required /></label>
                      <label><span>Last name</span><input name="lastName" value={customer.last_name} required /></label>
                      <input type="hidden" name="phoneNumber" value={customer.phone_number} />
                      <input type="hidden" name="email" value={customer.email ?? ""} />
                      <input type="hidden" name="address" value={customer.address} />
                      <input type="hidden" name="assignedAgentId" value={customer.assigned_agent_id ?? ""} />
                      <input type="hidden" name="creditLimit" value={customer.credit_limit} />
                      {customer.is_reseller && <input type="hidden" name="isReseller" value="on" />}
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <span class="customer-tracking-number">{customer.tracking_number}</span>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{customer.email ?? "No email"}</span>
                  </button>
                  <Popover title={`Edit Email: ${fullName(customer)}`}>
                      <input type="hidden" name="action" value="save-customer" />
                      <input type="hidden" name="customerId" value={customer.id} />
                      <input type="hidden" name="firstName" value={customer.first_name} />
                      <input type="hidden" name="lastName" value={customer.last_name} />
                      <input type="hidden" name="phoneNumber" value={customer.phone_number} />
                      <input type="hidden" name="address" value={customer.address} />
                      <input type="hidden" name="assignedAgentId" value={customer.assigned_agent_id ?? ""} />
                      <input type="hidden" name="creditLimit" value={customer.credit_limit} />
                      {customer.is_reseller && <input type="hidden" name="isReseller" value="on" />}
                      <label><span>Email</span><input name="email" type="email" value={customer.email ?? ""} autocomplete="email" /></label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{customer.phone_number}</span>
                  </button>
                  <Popover title={`Edit Contact: ${fullName(customer)}`}>
                      <input type="hidden" name="action" value="save-customer" />
                      <input type="hidden" name="customerId" value={customer.id} />
                      <input type="hidden" name="firstName" value={customer.first_name} />
                      <input type="hidden" name="lastName" value={customer.last_name} />
                      <input type="hidden" name="email" value={customer.email ?? ""} />
                      <input type="hidden" name="address" value={customer.address} />
                      <input type="hidden" name="assignedAgentId" value={customer.assigned_agent_id ?? ""} />
                      <input type="hidden" name="creditLimit" value={customer.credit_limit} />
                      {customer.is_reseller && <input type="hidden" name="isReseller" value="on" />}
                      <label><span>Phone number</span><input name="phoneNumber" value={customer.phone_number} required inputmode="tel" autocomplete="tel" /></label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td>
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <StatusBadge
                      kind="customer-type"
                      status={customer.is_reseller ? "reseller" : "retail"}
                      label={customer.is_reseller ? "Reseller" : "Retail"}
                    />
                  </button>
                  <Popover title={`Edit Type: ${fullName(customer)}`}>
                      <input type="hidden" name="action" value="save-customer" />
                      <input type="hidden" name="customerId" value={customer.id} />
                      <input type="hidden" name="firstName" value={customer.first_name} />
                      <input type="hidden" name="lastName" value={customer.last_name} />
                      <input type="hidden" name="phoneNumber" value={customer.phone_number} />
                      <input type="hidden" name="email" value={customer.email ?? ""} />
                      <input type="hidden" name="address" value={customer.address} />
                      <input type="hidden" name="assignedAgentId" value={customer.assigned_agent_id ?? ""} />
                      <input type="hidden" name="creditLimit" value={customer.credit_limit} />
                      <label class="checkbox-row">
                        <input name="isReseller" type="checkbox" checked={customer.is_reseller || undefined} />
                        <span>Reseller customer</span>
                      </label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__cell--truncate">
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span>{customer.assigned_agent_name ?? "None"}</span>
                  </button>
                  <Popover title={`Edit Assigned Agent: ${fullName(customer)}`}>
                      <input type="hidden" name="action" value="save-customer" />
                      <input type="hidden" name="customerId" value={customer.id} />
                      <input type="hidden" name="firstName" value={customer.first_name} />
                      <input type="hidden" name="lastName" value={customer.last_name} />
                      <input type="hidden" name="phoneNumber" value={customer.phone_number} />
                      <input type="hidden" name="email" value={customer.email ?? ""} />
                      <input type="hidden" name="address" value={customer.address} />
                      <input type="hidden" name="creditLimit" value={customer.credit_limit} />
                      {customer.is_reseller && <input type="hidden" name="isReseller" value="on" />}
                      <label>
                        <span>Assigned agent</span>
                        <select name="assignedAgentId">
                          <option value="" selected={!customer.assigned_agent_id}>None</option>
                          {data.agents.map((agent) => (
                            <option value={agent.id} selected={selected(customer.assigned_agent_id, agent.id)}>
                              {agent.display_name}
                              {agent.employee_id ? ` (${agent.employee_id})` : ""}
                            </option>
                          ))}
                        </select>
                      </label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td>
                  <button
                    type="button"
                    class="table-cell-trigger"
                    data-open-cell-popover
                  >
                    <span class="customer-credit-cell">
                      <span>
                        {formatCompactCurrency(customer.outstanding_credit_balance)} / {formatCompactCurrency(customer.credit_limit)}
                      </span>
                      {customer.credit_limit_exceeded && (
                        <StatusBadge kind="payment" status="partial" label="Exceeded" />
                      )}
                    </span>
                  </button>
                  <Popover title={`Edit Credit: ${fullName(customer)}`}>
                      <input type="hidden" name="action" value="save-customer" />
                      <input type="hidden" name="customerId" value={customer.id} />
                      <input type="hidden" name="firstName" value={customer.first_name} />
                      <input type="hidden" name="lastName" value={customer.last_name} />
                      <input type="hidden" name="phoneNumber" value={customer.phone_number} />
                      <input type="hidden" name="email" value={customer.email ?? ""} />
                      <input type="hidden" name="address" value={customer.address} />
                      <input type="hidden" name="assignedAgentId" value={customer.assigned_agent_id ?? ""} />
                      {customer.is_reseller && <input type="hidden" name="isReseller" value="on" />}
                      <p class="cell-popover__readonly-value">
                        Outstanding balance: {formatCompactCurrency(customer.outstanding_credit_balance)}
                      </p>
                      <label>
                        <span>Credit limit</span>
                        <input name="creditLimit" type="number" min="0" step="1" value={customer.credit_limit} required />
                      </label>
                      <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                </td>
                <td class="dashboard-table__actions-column">
                  <ViewButton href={`/admin/customers/${customer.id}`} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-customer-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered customers</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <th scope="col">Date Created</th>
            <th scope="col">Customer</th>
            <th scope="col">Tracking</th>
            <th scope="col">Email</th>
            <th scope="col">Contact</th>
            <th scope="col">Type</th>
            <th scope="col">Assigned Agent</th>
            <th scope="col">Credit</th>
            <DashboardTableActionsHeader />
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>
  <Modal
    id="customer-filters-modal"
    title="Filter customers"
    description="Narrow customers by type."
  >
    <div class="product-filter-modal">
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Customer type</span>
        <select data-customer-filter-field="customerType" aria-label="Filter by customer type">
          <option value="">All types</option>
          {customerTypes.map((customerType) => (
            <option value={customerType} selected={activeFilters.customerType === customerType}>
              {formatCustomerType(customerType)}
            </option>
          ))}
        </select>
      </label>
      <div class="product-filter-modal__actions">
        <button type="button" class="product-filter-modal__clear" data-customer-filter-modal-clear>
          Clear
        </button>
        <button type="button" class="product-filter-modal__apply" data-customer-filter-modal-apply>
          Apply filters
        </button>
      </div>
    </div>
  </Modal>
</section>

<style>
  .customer-tracking-number {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #111827;
  }
</style>

<script>
  import { initDashboardFilterModals } from "@/lib/client/dashboard-filter-modal";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";
  import { initUiPicker } from "@/lib/client/ui-picker";

  function initRegistrationLinkPicker() {
    const form = document.querySelector<HTMLFormElement>("[data-customer-registration-link-form]");
    if (!form) return null;

    const hiddenInputContainer = form.querySelector<HTMLElement>(
      "[data-selected-registration-agent-inputs]",
    );
    const optionTemplate = form.querySelector<HTMLTemplateElement>(
      "[data-registration-agent-picker-template]",
    );
    if (!optionTemplate) return null;

    return initUiPicker({
      root: form,
      optionTemplate,
      multiple: true,
      hiddenInputContainer,
      hiddenInputName: "agentId",
    });
  }

  function initCustomerRegistrationLinkForm() {
    const form = document.querySelector<HTMLFormElement>("[data-customer-registration-link-form]");
    if (!form || form.dataset.customerRegistrationLinkInitialized === "true") return;
    form.dataset.customerRegistrationLinkInitialized = "true";

    initRegistrationLinkPicker();
  }

  function ensureRegistrationLinkPickerOnSheetOpen() {
    const picker = document.querySelector<HTMLElement>(
      "[data-customer-registration-link-form] [data-customer-picker]",
    );
    if (!picker || picker.dataset.uiPickerInitialized === "true") return;
    initRegistrationLinkPicker();
  }

  function initAdminCustomerFilters() {
    initDashboardFilterModals();
    initDashboardFragmentTable({
      cacheKey: "admin-customers-filter-cache-v2",
      fragmentPath: "/admin/customers-fragment",
      pagePath: "/admin/customers",
      formSelector: "[data-customer-filter-form]",
      tableShellSelector: "[data-customer-table-shell]",
      skeletonTemplateSelector: "[data-customer-filter-skeleton]",
      filterKeys: ["search", "customerType"],
      searchInputSelector: "[data-customer-search-input]",
      historyStateKey: "customerFilterQuery",
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminCustomerFilters);
  document.addEventListener("astro:after-swap", initAdminCustomerFilters);
  document.addEventListener("DOMContentLoaded", initCustomerRegistrationLinkForm);
  document.addEventListener("astro:after-swap", initCustomerRegistrationLinkForm);
  document.addEventListener("astro:page-load", initCustomerRegistrationLinkForm);
  document.addEventListener(
    "click",
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('[data-sheet-target="#create-customer-registration-link-sheet"]')) return;
      window.requestAnimationFrame(ensureRegistrationLinkPickerOnSheetOpen);
    },
    true,
  );
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminCustomerFilters();
    initCustomerRegistrationLinkForm();
  }
</script>
