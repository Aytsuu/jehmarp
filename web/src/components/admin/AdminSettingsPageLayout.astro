---
import type { AdminDashboardData } from "@/lib/admin-dashboard/data";
import type { AdminActionFeedback } from "@/lib/admin-dashboard/actions";
import PageAvailabilityNotice from "@/components/dashboard/PageAvailabilityNotice.astro";
import {
  getUnreadAdminInquiryIds,
  getUnreadAdminOrderIds,
  getUnreadAdminResellerApplicationIds,
  getAdminUnreadNotificationIds,
} from "@/lib/admin-dashboard/notifications";
import { adminDashboardRoutes } from "@/config/navigation";
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import { getDashboardPageAvailability } from "@/lib/page-availability";

export type AdminSettingsTab = "general" | "privacy" | "templates" | "accounts";

type Props = {
  title: string;
  description: string;
  heading: string;
  intro: string;
  activeTab: AdminSettingsTab;
  feedback?: AdminActionFeedback;
  dashboardData?: AdminDashboardData;
};

const { title, description, heading, intro, activeTab, feedback, dashboardData } = Astro.props;
const headingId = `${heading
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "")}-title`;
const unreadOrderCount = dashboardData ? getUnreadAdminOrderIds(dashboardData).length : 0;
const unreadInquiryCount = dashboardData ? getUnreadAdminInquiryIds(dashboardData).length : 0;
const unreadResellerApplicationCount = dashboardData
  ? getUnreadAdminResellerApplicationIds(dashboardData).length
  : 0;
const unreadNotificationCount = dashboardData
  ? getAdminUnreadNotificationIds(dashboardData).length
  : 0;
const pageAvailability = getDashboardPageAvailability(Astro.url.pathname);
const isPageReady = pageAvailability.status === "ready";

const tabs: Array<{ id: AdminSettingsTab; label: string }> = [
  { id: "general", label: "General" },
  { id: "privacy", label: "Privacy notice" },
  { id: "templates", label: "Templates" },
  { id: "accounts", label: "Account & security" },
];
---

<DashboardLayout
  title={title}
  description={description}
  navLabel="Admin operations"
  navItems={adminDashboardRoutes}
  sidebarUnreadBadges={{
    "/admin/orders": {
      count: unreadOrderCount,
    },
    "/admin/inquiries": {
      count: unreadInquiryCount,
    },
    "/admin/reseller-applications": {
      count: unreadResellerApplicationCount,
    },
    "/admin/notifications": {
      count: unreadNotificationCount,
    },
  }}
>
  <div class="admin-settings-page" data-admin-settings-page>
    <header class="admin-settings-page__header">
      <div class="admin-settings-page__intro">
        <h1 id={headingId} class="admin-settings-page__title">{heading}</h1>
        <p class="admin-settings-page__description">{intro}</p>
      </div>

      {
        feedback?.status && (
          <p class="status-message admin-settings-page__feedback" role="status">
            {feedback.status}
          </p>
        )
      }
      {
        feedback?.error && (
          <p class="error-message admin-settings-page__feedback" role="alert">
            {feedback.error}
          </p>
        )
      }

      <nav class="admin-settings-page__tabs" aria-label="Settings sections" role="tablist">
        {
          tabs.map((tab) => (
            <button
              type="button"
              class:list={["admin-settings-page__tab", activeTab === tab.id && "is-active"]}
              data-admin-settings-tab-trigger
              data-tab-target={tab.id}
              role="tab"
              aria-selected={activeTab === tab.id ? "true" : "false"}
            >
              {tab.label}
            </button>
          ))
        }
      </nav>
    </header>

    <div class="admin-settings-page__panel">
      <div class="admin-settings-page__panel-inner">
        {isPageReady ? <slot /> : <PageAvailabilityNotice availability={pageAvailability} />}
      </div>
    </div>
  </div>
</DashboardLayout>

{
  feedback?.cleanPath && (
    <script is:inline define:vars={{ adminFeedbackCleanPath: feedback.cleanPath }}>
      if (typeof adminFeedbackCleanPath === "string" && window.history.replaceState) {
        window.history.replaceState(window.history.state, "", adminFeedbackCleanPath);
      }
    </script>
  )
}

<script>
  import { initAdminSettingsTabs } from "@/lib/client/admin-settings-tabs";

  function init() {
    initAdminSettingsTabs(document);
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:after-swap", init);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    init();
  }
</script>

<style>
  :global(.dashboard-body:has([data-admin-settings-page])),
  :global(.dashboard-frame:has([data-admin-settings-page])) {
    height: 100vh;
    min-height: 0;
    overflow: hidden;
  }

  :global(.dashboard-main:has([data-admin-settings-page])) {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    max-height: 100vh;
    overflow: hidden;
    padding: 0;
  }

  :global(.dashboard-main:has([data-admin-settings-page]) .dashboard-main__content) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    padding: 0;
    overflow: hidden;
  }

  .admin-settings-page {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    width: 100%;
    height: 100%;
  }

  .admin-settings-page__header {
    flex-shrink: 0;
    padding: 1.5rem 1.5rem 0;
    background: transparent;
  }

  .admin-settings-page__title {
    margin: 0;
    font-size: clamp(1.4rem, 1.9vw, 1.85rem);
    line-height: 1;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.025em;
  }

  .admin-settings-page__description {
    margin: 0.4rem 0 0;
    max-width: 42rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-brand-muted-black);
  }

  .admin-settings-page__feedback {
    margin: 0.75rem 0 0;
  }

  .admin-settings-page__tabs {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .admin-settings-page__tab {
    display: inline-flex;
    align-items: center;
    margin-bottom: -1px;
    padding: 0.7rem 0.95rem;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: transparent;
    color: #6b7280;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .admin-settings-page__tab:hover:not(:disabled) {
    background: transparent;
    color: #111827;
  }

  .admin-settings-page__tab:active:not(:disabled) {
    background: transparent;
    opacity: 1;
  }

  .admin-settings-page__tab.is-active {
    color: #111827;
    border-bottom-color: var(--color-brand-red);
  }

  .admin-settings-page__panel {
    flex: 1;
    min-height: 0;
    margin-top: 0;
    background: #ffffff;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .admin-settings-page__panel-inner {
    width: 100%;
    min-height: 100%;
    padding: 1.5rem;
    box-sizing: border-box;
  }
</style>
