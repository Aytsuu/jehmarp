---
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import AdminProductSortHeader from "@/components/admin/AdminProductSortHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import ResellerEmailDeliveryStatus from "@/components/admin/ResellerEmailDeliveryStatus.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import Popover from "@/components/ui/Popover.astro";
import type { AdminResellerApplicationManagementData } from "@/lib/admin-dashboard/data";
import type { AdminResellerApplicationFilters } from "@/lib/admin-dashboard/reseller-application-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatDate, selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminResellerApplicationManagementData;
  applicationStatuses: readonly string[];
  activeFilters: AdminResellerApplicationFilters;
  filterQuery: string;
};

const { data, applicationStatuses, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
const activeFilterCount = Number(Boolean(activeFilters.status));
const hasActiveFilters = activeFilterCount > 0;
---

<section
  id="admin-reseller-applications"
  class="admin-panel"
  data-admin-reseller-applications-page
  aria-labelledby="admin-reseller-applications-title"
>
  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/reseller-applications"
        class="order-filter-form"
        data-reseller-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter reseller applications"
      >
        <input type="hidden" name="sort" value={activeFilters.sort ?? ""} data-reseller-sort-input />
        <input type="hidden" name="direction" value={activeFilters.direction ?? ""} data-reseller-direction-input />
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search applicant name, email, or contact..."
              autocomplete="off"
              aria-label="Search reseller applications"
              data-reseller-search-input
            />
          </div>

          <div
            class="product-filter-popover-container"
            data-reseller-filter-popover-root
          >
            <button
              type="button"
              class="product-filter-form__icon-trigger product-filter-popover-trigger"
              data-reseller-filter-popover-trigger
              aria-label="Filter reseller applications"
              aria-expanded="false"
              aria-haspopup="dialog"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
              <span
                class="product-filter-popover-trigger__badge"
                data-reseller-filter-popover-badge
                hidden={!hasActiveFilters}
              >
                {activeFilterCount}
              </span>
            </button>

            <div
              class="product-filter-popover"
              data-reseller-filter-popover
              role="dialog"
              aria-label="Filter reseller applications"
              hidden
            >
              <header class="product-filter-popover__header">
                <div class="product-filter-popover__heading">
                  <h3 class="product-filter-popover__title">Filter reseller applications</h3>
                  <p class="product-filter-popover__description">
                    Narrow applications by status.
                  </p>
                </div>
                <button
                  type="button"
                  class="product-filter-popover__close"
                  data-reseller-filter-popover-close
                  aria-label="Close filters"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </header>

              <div class="product-filter-popover__body">
                <label class="product-filter-popover__field">
                  <span class="product-filter-popover__label">Status</span>
                  <select
                    name="status"
                    data-reseller-filter-field="status"
                    aria-label="Filter by status"
                  >
                    <option value="">All statuses</option>
                    {
                      applicationStatuses.map((status) => (
                        <option
                          value={status}
                          selected={activeFilters.status === status}
                        >
                          {autoCapitalize(status)}
                        </option>
                      ))
                    }
                  </select>
                </label>
              </div>

              <footer class="product-filter-popover__footer">
                <button
                  type="button"
                  class="product-filter-popover__clear"
                  data-reseller-filter-popover-clear
                >
                  Clear
                </button>
              </footer>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div data-reseller-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <AdminProductSortHeader column="created_at" label="Date Created" sortScope="reseller" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
              <AdminProductSortHeader column="name" label="Applicant" sortScope="reseller" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
              <th scope="col">Email</th>
              <th scope="col">Contact</th>
              <th scope="col">Supply Needs</th>
              <th scope="col">Message</th>
              <th scope="col">Status</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {data.resellerApplications.length === 0 ? (
              <DashboardTableEmptyState
                colspan={9}
                message="No reseller applications match the selected filters."
              />
            ) : data.resellerApplications.map((application, index) => {
              const isUnread = !application.admin_read_at && application.application_status === "submitted";
              return (
                <tr
                  data-status={application.application_status}
                  data-application-id={application.id}
                  {...(isUnread ? { "data-reseller-unread": "true" } : {})}
                >
                  <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                  <td>{formatDate(application.created_at)}</td>
                  <td class="dashboard-table__cell--truncate">{application.name}</td>
                  <td class="dashboard-table__cell--truncate">{application.email}</td>
                  <td class="dashboard-table__cell--truncate">{application.contact_number}</td>
                  <td>{application.expected_quantity_per_week}</td>
                  <td class="dashboard-table__cell--truncate" title={application.message ?? "No message"}>
                    {application.message ?? "-"}
                  </td>
                  <td>
                    <button
                      type="button"
                      class="table-cell-trigger"
                      data-open-cell-popover
                    >
                      <StatusBadge kind="reseller" status={application.application_status} />
                    </button>
                    <Popover title={`Edit Status: ${application.name}`}>
                        <input type="hidden" name="action" value="update-reseller-application" />
                        <input type="hidden" name="applicationId" value={application.id} />
                        <label>
                          <span>Status</span>
                          <select name="applicationStatus" required>
                            {applicationStatuses.map((status) => (
                              <option value={status} selected={selected(application.application_status, status)}>
                                {autoCapitalize(status)}
                              </option>
                            ))}
                          </select>
                        </label>
                        <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                  </td>
                  <td class="dashboard-table__actions-column">
                    <ResellerEmailDeliveryStatus
                      status={application.email_delivery_status}
                      error={application.email_error}
                    />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>
    <DashboardTablePagination pagination={data.pagination} />
  </div>
  <template data-reseller-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered reseller applications</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <AdminProductSortHeader column="created_at" label="Date Created" sortScope="reseller" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
            <AdminProductSortHeader column="name" label="Applicant" sortScope="reseller" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
            <th scope="col">Email</th>
            <th scope="col">Contact</th>
            <th scope="col">Supply Needs</th>
            <th scope="col">Message</th>
            <th scope="col">Status</th>
            <DashboardTableActionsHeader />
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td class="dashboard-table__actions-column"><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>

</section>

<script>
  import { initAdminListSort } from "@/lib/client/admin-list-sort";
  import { initDashboardFilterPopovers } from "@/lib/client/dashboard-filter-popover";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";
  import { formatSidebarUnreadCount } from "@/lib/dashboard/sidebar-navigation";
  import { isAdminResellerApplicationSortColumn, nextAdminResellerApplicationSort } from "@/lib/admin-dashboard/reseller-application-sort";

  function initAdminResellerFilters() {
    initDashboardFilterPopovers();
    initDashboardFragmentTable({
      cacheKey: "admin-reseller-filter-cache-v3",
      fragmentPath: "/admin/reseller-applications-fragment",
      pagePath: "/admin/reseller-applications",
      formSelector: "[data-reseller-filter-form]",
      tableShellSelector: "[data-reseller-table-shell]",
      skeletonTemplateSelector: "[data-reseller-filter-skeleton]",
      filterKeys: ["search", "status", "sort", "direction"],
      searchInputSelector: "[data-reseller-search-input]",
      historyStateKey: "resellerFilterQuery",
      updatedEvents: ["dashboard:reseller-applications-table-updated"],
    });
    initAdminListSort({
      buttonSelector: "[data-reseller-sort]",
      pageSelector: "[data-admin-reseller-applications-page]",
      formSelector: "[data-reseller-filter-form]",
      sortInputSelector: "[data-reseller-sort-input]",
      directionInputSelector: "[data-reseller-direction-input]",
      readColumn: (button) => button.dataset.resellerSort,
      isColumn: isAdminResellerApplicationSortColumn,
      nextSort: nextAdminResellerApplicationSort,
    });
  }
  document.addEventListener("DOMContentLoaded", initAdminResellerFilters);
  document.addEventListener("astro:after-swap", initAdminResellerFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminResellerFilters();

  function initResellerApplicationAutoRead() {
    const tableShell = document.querySelector<HTMLElement>("[data-reseller-table-shell]");
    if (!tableShell) return;
    const activeTableShell = tableShell;
    const interactiveTable = activeTableShell.closest<HTMLElement>("[data-interactive-table]");
    if (!interactiveTable) return;
    if (interactiveTable.dataset.resellerAutoReadInitialized === "true") return;
    interactiveTable.dataset.resellerAutoReadInitialized = "true";

    const markedApplicationIds = new Set<string>();
    let markRequestInFlight = false;

    function getVisibleUnreadApplicationIds() {
      return Array.from(
        activeTableShell.querySelectorAll<HTMLTableRowElement>("tr[data-reseller-unread='true']"),
      )
        .filter((row) => row.style.display !== "none")
        .map((row) => row.dataset.applicationId)
        .filter((id): id is string => typeof id === "string" && id.length > 0)
        .filter((id) => !markedApplicationIds.has(id));
    }

    function clearUnreadIndicators(applicationIds: string[]) {
      applicationIds.forEach((applicationId) => {
        const row = activeTableShell.querySelector<HTMLTableRowElement>(
          `tr[data-application-id="${applicationId}"]`,
        );
        if (!row) return;
        row.removeAttribute("data-reseller-unread");
      });
    }

    function adjustUnreadBadgeCount(href: string, delta: number) {
      const badge = document.querySelector<HTMLElement>(
        `.dashboard-sidebar a[href="${href}"] .dashboard-sidebar__nav-badge`,
      );
      if (!badge) return;

      const currentCount = Number.parseInt(badge.dataset.unreadCount || "0", 10) || 0;
      const nextCount = Math.max(0, currentCount + delta);
      badge.dataset.unreadCount = String(nextCount);
      badge.textContent = formatSidebarUnreadCount(nextCount);
      badge.hidden = nextCount < 1;
    }

    async function markVisibleUnreadApplications() {
      const applicationIds = getVisibleUnreadApplicationIds();
      if (applicationIds.length === 0 || markRequestInFlight) return;

      applicationIds.forEach((applicationId) => markedApplicationIds.add(applicationId));
      markRequestInFlight = true;

      try {
        const response = await fetch("/admin/reseller-applications-mark-read.json", {
          method: "POST",
          headers: {
            Accept: "application/json",
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ applicationIds }),
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(
            typeof body.error === "string"
              ? body.error
              : "Unable to mark reseller applications as read.",
          );
        }

        const markedCount = typeof body.markedCount === "number" ? body.markedCount : applicationIds.length;
        clearUnreadIndicators(applicationIds);
        adjustUnreadBadgeCount("/admin/reseller-applications", -markedCount);
        adjustUnreadBadgeCount("/admin/notifications", -markedCount);
      } catch {
        applicationIds.forEach((applicationId) => markedApplicationIds.delete(applicationId));
      } finally {
        markRequestInFlight = false;
      }
    }

    const scheduleMarkVisibleUnread = () => {
      window.requestAnimationFrame(() => {
        void markVisibleUnreadApplications();
      });
    };

    interactiveTable.addEventListener("dashboard:interactive-table-page-changed", scheduleMarkVisibleUnread);
    document.addEventListener("dashboard:reseller-applications-table-updated", scheduleMarkVisibleUnread);
    document.addEventListener("dashboard:interactive-table-updated", scheduleMarkVisibleUnread);
    scheduleMarkVisibleUnread();
  }

  document.addEventListener("DOMContentLoaded", initResellerApplicationAutoRead);
  document.addEventListener("astro:after-swap", initResellerApplicationAutoRead);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initResellerApplicationAutoRead();
  }
</script>
