---
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import TableActionMenu from "@/components/TableActionMenu.astro";
import TableRowActionsModal from "@/components/TableRowActionsModal.astro";
import Modal from "@/components/ui/Modal.astro";
import type { AdminSalesManagementData } from "@/lib/admin-dashboard/data";
import type { AdminOrderFilters } from "@/lib/admin-dashboard/order-filters";
import { orderSources } from "@/lib/admin-dashboard/order-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatCurrency, formatDate, formatSalePaymentSummary } from "@/lib/admin-dashboard/view";
import { formatOrderSource } from "@/lib/formatters";

type Props = {
  data: AdminSalesManagementData;
  activeFilters: AdminOrderFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
---

<section
  id="admin-sales"
  class="admin-panel"
  data-admin-sales-page
  aria-labelledby="admin-sales-title"
>
  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/sales"
        class="order-filter-form order-filter-form--paired"
        data-sales-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter sales"
      >
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search customer, invoice, phone, or email..."
              autocomplete="off"
              aria-label="Search sales"
              data-sales-search-input
            />
          </div>
          <div class="product-filter-form__toolbar-actions">
            <button
              type="button"
              class="product-filter-form__icon-trigger"
              data-sales-filter-modal-trigger
              data-open-dashboard-modal="sales-filters-modal"
              aria-label="Open sales filters"
              aria-pressed="false"
              aria-controls="sales-filters-modal"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-filter-form__advanced-filters">
          <div class="order-filter-form__field">
            <select
              name="source"
              data-sales-filter-field="source"
              aria-label="Filter by source"
            >
              <option value="">All sources</option>
              {orderSources.map((source) => (
                <option value={source} selected={activeFilters.source === source}>
                  {formatOrderSource(source)}
                </option>
              ))}
            </select>
          </div>
        </div>
      </form>
    </div>

    <div data-sales-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col">Order Date</th>
              <th scope="col">Sale Date</th>
              <th scope="col">Customer</th>
              <th scope="col">Source</th>
              <th scope="col">Gross Amount</th>
              <th scope="col">Net Amount</th>
              <th scope="col">Payments</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {data.salesRows.length === 0 ? (
              <DashboardTableEmptyState
                colspan={9}
                message="No completed sales match the selected filters."
              />
            ) : data.salesRows.map((sale, index) => {
              const salesInvoicePdfHref = sale.invoice_number
                ? `/admin/orders/customer/${sale.id}/sales-invoice.pdf`
                : undefined;

              return (
                <tr data-status={sale.payment_status}>
                  <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                  <td>{formatDate(sale.created_at)}</td>
                  <td>{formatDate(sale.sale_date)}</td>
                  <td class="dashboard-table__cell--truncate">{sale.customer_label || "Guest"}</td>
                  <td>{sale.source_label}</td>
                  <td>{formatCurrency(sale.order_total)}</td>
                  <td>{formatCurrency(sale.net_total)}</td>
                  <td>{formatSalePaymentSummary(sale.payment_count)}</td>
                  <td class="dashboard-table__actions-column">
                    <TableActionMenu
                      menuLabel={`Open actions for sale ${sale.customer_label || sale.id}`}
                      pdfHref={salesInvoicePdfHref}
                      detailsHref={sale.href}
                      mobileModalId="sales-row-actions-modal"
                    />
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-sales-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered sales</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <th scope="col">Order Date</th>
            <th scope="col">Sale Date</th>
            <th scope="col">Customer</th>
            <th scope="col">Source</th>
            <th scope="col">Gross Amount</th>
            <th scope="col">Net Amount</th>
            <th scope="col">Payments</th>
            <DashboardTableActionsHeader />
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>

  <TableRowActionsModal
    id="sales-row-actions-modal"
    title="Sale actions"
    description="Choose an action for this sale."
  />

  <Modal
    id="sales-filters-modal"
    title="Filter sales"
    description="Narrow sales by order source."
  >
    <div class="product-filter-modal">
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Source</span>
        <select data-sales-filter-field="source" aria-label="Filter by source">
          <option value="">All sources</option>
          {orderSources.map((source) => (
            <option value={source} selected={activeFilters.source === source}>
              {formatOrderSource(source)}
            </option>
          ))}
        </select>
      </label>
      <div class="product-filter-modal__actions">
        <button type="button" class="product-filter-modal__clear" data-sales-filter-modal-clear>
          Clear
        </button>
        <button type="button" class="product-filter-modal__apply" data-sales-filter-modal-apply>
          Apply filters
        </button>
      </div>
    </div>
  </Modal>
</section>

<script>
  import { initDashboardFilterModals } from "@/lib/client/dashboard-filter-modal";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";

  function initAdminSalesFilters() {
    initDashboardFilterModals();
    initDashboardFragmentTable({
      cacheKey: "admin-sales-filter-cache-v1",
      fragmentPath: "/admin/sales-fragment",
      pagePath: "/admin/sales",
      formSelector: "[data-sales-filter-form]",
      tableShellSelector: "[data-sales-table-shell]",
      skeletonTemplateSelector: "[data-sales-filter-skeleton]",
      filterKeys: ["search", "source"],
      searchInputSelector: "[data-sales-search-input]",
      historyStateKey: "salesFilterQuery",
    });
  }

  document.addEventListener("DOMContentLoaded", initAdminSalesFilters);
  document.addEventListener("astro:after-swap", initAdminSalesFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminSalesFilters();
  }
</script>
