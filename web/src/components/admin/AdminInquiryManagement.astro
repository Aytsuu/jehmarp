---
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import AdminProductSortHeader from "@/components/admin/AdminProductSortHeader.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import Popover from "@/components/ui/Popover.astro";
import type { AdminInquiryManagementData } from "@/lib/admin-dashboard/data";
import type { AdminInquiryFilters } from "@/lib/admin-dashboard/inquiry-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import { formatDate, selected } from "@/lib/admin-dashboard/view";
import { autoCapitalize } from "@/lib/formatters";

type Props = {
  data: AdminInquiryManagementData;
  inquiryStatuses: readonly string[];
  activeFilters: AdminInquiryFilters;
  filterQuery: string;
};

const { data, inquiryStatuses, activeFilters, filterQuery } = Astro.props;
const skeletonRows = Array.from({ length: 6 });
const activeFilterCount = Number(Boolean(activeFilters.status));
const hasActiveFilters = activeFilterCount > 0;
---

<section
  id="admin-inquiries"
  class="admin-panel"
  data-admin-inquiries-page
  aria-labelledby="admin-inquiries-title"
>
  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/inquiries"
        class="order-filter-form"
        data-inquiry-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter inquiries"
      >
        <input type="hidden" name="sort" value={activeFilters.sort ?? ""} data-inquiry-sort-input />
        <input type="hidden" name="direction" value={activeFilters.direction ?? ""} data-inquiry-direction-input />
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search name, email, or contact..."
              autocomplete="off"
              aria-label="Search inquiries"
              data-inquiry-search-input
            />
          </div>

          <div
            class="product-filter-popover-container"
            data-inquiry-filter-popover-root
          >
            <button
              type="button"
              class="product-filter-form__icon-trigger product-filter-popover-trigger"
              data-inquiry-filter-popover-trigger
              aria-label="Filter inquiries"
              aria-expanded="false"
              aria-haspopup="dialog"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
              <span
                class="product-filter-popover-trigger__badge"
                data-inquiry-filter-popover-badge
                hidden={!hasActiveFilters}
              >
                {activeFilterCount}
              </span>
            </button>

            <div
              class="product-filter-popover"
              data-inquiry-filter-popover
              role="dialog"
              aria-label="Filter inquiries"
              hidden
            >
              <header class="product-filter-popover__header">
                <div class="product-filter-popover__heading">
                  <h3 class="product-filter-popover__title">Filter inquiries</h3>
                  <p class="product-filter-popover__description">
                    Narrow inquiries by status.
                  </p>
                </div>
                <button
                  type="button"
                  class="product-filter-popover__close"
                  data-inquiry-filter-popover-close
                  aria-label="Close filters"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </header>

              <div class="product-filter-popover__body">
                <label class="product-filter-popover__field">
                  <span class="product-filter-popover__label">Status</span>
                  <select
                    name="status"
                    data-inquiry-filter-field="status"
                    aria-label="Filter by status"
                  >
                    <option value="">All statuses</option>
                    {
                      inquiryStatuses.map((status) => (
                        <option
                          value={status}
                          selected={activeFilters.status === status}
                        >
                          {autoCapitalize(status)}
                        </option>
                      ))
                    }
                  </select>
                </label>
              </div>

              <footer class="product-filter-popover__footer">
                <button
                  type="button"
                  class="product-filter-popover__clear"
                  data-inquiry-filter-popover-clear
                >
                  Clear
                </button>
              </footer>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div data-inquiry-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <AdminProductSortHeader column="created_at" label="Date Created" sortScope="inquiry" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
              <AdminProductSortHeader column="name" label="Name" sortScope="inquiry" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
              <th scope="col">Email</th>
              <th scope="col">Contact</th>
              <th scope="col">Message</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {data.contactInquiries.length === 0 ? (
              <DashboardTableEmptyState
                colspan={7}
                message="No inquiries match the selected filters."
              />
            ) : data.contactInquiries.map((inquiry, index) => (
                <tr data-status={inquiry.inquiry_status}>
                  <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                  <td>{formatDate(inquiry.created_at)}</td>
                  <td class="dashboard-table__cell--truncate">{inquiry.name}</td>
                  <td class="dashboard-table__cell--truncate">{inquiry.email ?? "-"}</td>
                  <td class="dashboard-table__cell--truncate">{inquiry.phone_number ?? "-"}</td>
                  <td class="dashboard-table__cell--truncate" title={inquiry.message}>{inquiry.message}</td>
                  <td>
                    <button
                      type="button"
                      class="table-cell-trigger"
                      data-open-cell-popover
                    >
                      <StatusBadge kind="inquiry" status={inquiry.inquiry_status} />
                    </button>
                    <Popover title={`Edit Status: ${inquiry.name}`}>
                        <input type="hidden" name="action" value="update-inquiry" />
                        <input type="hidden" name="inquiryId" value={inquiry.id} />
                        <input type="hidden" name="internalNotes" value={inquiry.internal_notes ?? ""} />
                        <label>
                          <span>Status</span>
                          <select name="inquiryStatus" required>
                            {inquiryStatuses.map((status) => (
                              <option value={status} selected={selected(inquiry.inquiry_status, status)}>
                                {autoCapitalize(status)}
                              </option>
                            ))}
                          </select>
                        </label>
                        <button slot="footer" type="submit" class="ui-popover__button-primary">Save Changes</button>
                    </Popover>
                  </td>
                </tr>
              ))}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>
    <DashboardTablePagination pagination={data.pagination} />
  </div>
  <template data-inquiry-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered inquiries</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <AdminProductSortHeader column="created_at" label="Date Created" sortScope="inquiry" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
            <AdminProductSortHeader column="name" label="Name" sortScope="inquiry" activeSort={activeFilters.sort} activeDirection={activeFilters.direction} />
            <th scope="col">Email</th>
            <th scope="col">Contact</th>
            <th scope="col">Message</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>

</section>

<script>
  import { initAdminListSort } from "@/lib/client/admin-list-sort";
  import { initDashboardFilterPopovers } from "@/lib/client/dashboard-filter-popover";
  import { initDashboardFragmentTable } from "@/lib/client/dashboard-fragment-table";
  import { isAdminInquirySortColumn, nextAdminInquirySort } from "@/lib/admin-dashboard/inquiry-sort";

  function initAdminInquiryFilters() {
    initDashboardFilterPopovers();
    initDashboardFragmentTable({
      cacheKey: "admin-inquiry-filter-cache-v3",
      fragmentPath: "/admin/inquiries-fragment",
      pagePath: "/admin/inquiries",
      formSelector: "[data-inquiry-filter-form]",
      tableShellSelector: "[data-inquiry-table-shell]",
      skeletonTemplateSelector: "[data-inquiry-filter-skeleton]",
      filterKeys: ["search", "status", "sort", "direction"],
      searchInputSelector: "[data-inquiry-search-input]",
      historyStateKey: "inquiryFilterQuery",
    });
    initAdminListSort({
      buttonSelector: "[data-inquiry-sort]",
      pageSelector: "[data-admin-inquiries-page]",
      formSelector: "[data-inquiry-filter-form]",
      sortInputSelector: "[data-inquiry-sort-input]",
      directionInputSelector: "[data-inquiry-direction-input]",
      readColumn: (button) => button.dataset.inquirySort,
      isColumn: isAdminInquirySortColumn,
      nextSort: nextAdminInquirySort,
    });
  }
  document.addEventListener("DOMContentLoaded", initAdminInquiryFilters);
  document.addEventListener("astro:after-swap", initAdminInquiryFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") initAdminInquiryFilters();
</script>
