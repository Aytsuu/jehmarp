---
import Accordion from "@/components/ui/Accordion.astro";
import ActionMenu, { type ActionMenuItem } from "@/components/ActionMenu.astro";
import Button from "@/components/ui/Button.astro";
import Modal from "@/components/ui/Modal.astro";
import Sheet from "@/components/ui/Sheet.astro";
import Picker from "@/components/ui/Picker.astro";
import Tooltip from "@/components/ui/Tooltip.astro";
import type { AdminOrderManagementData } from "@/lib/admin-dashboard/data";
import ViewButton from "@/components/ViewButton.astro";
import DashboardTableActionsHeader from "@/components/dashboard/DashboardTableActionsHeader.astro";
import DashboardTableBoard from "@/components/dashboard/DashboardTableBoard.astro";
import DashboardTableEmptyState from "@/components/dashboard/DashboardTableEmptyState.astro";
import DashboardTableNumberHeader from "@/components/dashboard/DashboardTableNumberHeader.astro";
import DashboardTablePagination from "@/components/dashboard/DashboardTablePagination.astro";
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import type { AdminOrderFilters } from "@/lib/admin-dashboard/order-filters";
import { getAdminOrderStatusFilters, orderSources, paymentStatuses } from "@/lib/admin-dashboard/order-filters";
import { dashboardTableRowNumber } from "@/lib/admin-dashboard/pagination";
import {
  formatCurrency,
  formatDate,
  pendingCustomerOrdersAwaitingLabel,
} from "@/lib/admin-dashboard/view";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";
import { formatOrderCode } from "@/lib/order-detail-nav";

type Props = {
  data: AdminOrderManagementData;
  activeFilters: AdminOrderFilters;
  filterQuery: string;
};

const { data, activeFilters, filterQuery } = Astro.props;
const defaultTime = new Intl.DateTimeFormat("en-GB", {
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "Asia/Manila",
}).format(new Date());
const activeProducts = data.products.filter((product) => product.is_active);
const canCreateOrder = activeProducts.length > 0;
const orderStatuses = getAdminOrderStatusFilters();
const skeletonRows = Array.from({ length: 6 });
const orderRows = data.orderRows;
const orderActionPath = filterQuery ? `/admin/orders?${filterQuery}` : "/admin/orders";
const orderDocumentMenuItems: ActionMenuItem[] = [
  {
    label: "Sales Invoice",
    icon: "external-pdf",
    dataAction: "bulk-sales-invoice-pdf",
  },
  {
    label: "Order Slip",
    icon: "external-pdf",
    dataAction: "bulk-order-slip-pdf",
  },
];

function isPendingCustomerOrderRow(order: (typeof orderRows)[number]) {
  return order.row_type === "customer" && order.status === "pending";
}

function linkedCustomerOrdersLabel(count: number) {
  return count === 1
    ? "1 linked customer order in this agent order"
    : `${count} linked customer orders in this agent order`;
}
---

<section
  id="admin-orders"
  class="admin-panel"
  data-admin-orders-page
  aria-labelledby="admin-orders-title"
>
  <Sheet id="create-order-sheet" width="42rem">
    <div slot="header" class="order-create-sheet__header-copy">
      <h3 class="drawer-sheet__title" data-sheet-title>Create Order</h3>
      <p class="order-create-sheet__header-description">
        Select an existing customer or enter new customer details, then add the order items below.
      </p>
    </div>
    <form id="create-order-form" method="post" class="order-create-form" aria-label="Create order" data-astro-reload>
      <input type="hidden" name="action" value="create-order" />

      {!canCreateOrder && (
        <p class="empty-state">
          Add at least one active product before creating an admin order.
        </p>
      )}

      <section class="order-create-section">
        <div class="order-create-section__body">
          <div class="field-row field-row--split">
            <div class="field-row__meta">
              <span class="field-row__label">Existing</span>
              <span class="field-row__description">Search for an existing customer or agent.</span>
            </div>
            <div class="field-row__control">
              <Picker showPaymentNotice />
              <input type="hidden" name="customerId" data-customer-id />
              <input type="hidden" name="agentId" data-agent-order-agent-id />
            </div>
          </div>
        </div>
      </section>

      <section class="order-create-section">
        <div class="order-create-section__body">
          <label class="field-row field-row--split" hidden data-agent-order-fields>
            <span class="field-row__meta">
              <span class="field-row__label">Order Type</span>
            </span>
            <select name="agentOrderType" data-agent-order-type disabled>
              <option value="personal">Personal</option>
              <option value="distribution">Distribution</option>
            </select>
          </label>
        </div>
      </section>

      <section class="order-create-section" data-new-customer-fields>
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Customer Details</h3>
        </div>
        <div class="order-create-section__body order-create-form__fields">
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">First Name</span>
            </span>
            <input name="firstName" required data-customer-first-name />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Last Name</span>
            </span>
            <input name="lastName" required data-customer-last-name />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Phone Number</span>
            </span>
            <input name="phoneNumber" required data-customer-phone-number />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Email</span>
            </span>
            <input name="email" type="email" data-customer-email />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Address</span>
            </span>
            <textarea name="address" required data-customer-address></textarea>
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Assigned Agent</span>
            </span>
            <select name="assignedAgentId" data-customer-assigned-agent-id>
              <option value="">None</option>
              {data.agents.map((agent) => (
                <option value={agent.id}>{agent.display_name}</option>
              ))}
            </select>
          </label>
          <label class="checkbox-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Reseller?</span>
              <span class="field-row__description">Uses reseller pricing when applicable.</span>
            </span>
            <span class="field-row__control order-create-form__checkbox-control">
              <input name="isReseller" type="checkbox" data-customer-is-reseller />
            </span>
          </label>
        </div>
      </section>

      <section class="order-create-section">
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Order Items</h3>
          <button
            type="button"
            class="order-create-form__add-item"
            data-add-order-item
            disabled={!canCreateOrder}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14"></path>
              <path d="M5 12h14"></path>
            </svg>
            <span>Add Item</span>
          </button>
        </div>
        <div class="order-create-section__body">
          <div class="order-item-list" data-order-items>
            <Accordion class="order-item-accordion" open>
              <span slot="title" data-order-item-title>Select product</span>
              <button
                slot="actions"
                type="button"
                class="order-item-accordion__remove"
                data-remove-order-item
                aria-label="Remove item"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
              <div class="order-item-accordion__fields" data-order-item-row>
                <label class="field-row field-row--split">
                  <span class="field-row__meta">
                    <span class="field-row__label">Product</span>
                  </span>
                  <select name="productId" required disabled={activeProducts.length === 0} data-order-product-select>
                    <option value="">Select product</option>
                    {activeProducts.map((product) => (
                      <option
                        value={product.id}
                        data-product-name={product.name}
                        data-product-retail-price={product.default_price}
                        data-product-reseller-price={product.reseller_price}
                      >
                        {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="field-row field-row--split">
                  <span class="field-row__meta">
                    <span class="field-row__label">Quantity</span>
                  </span>
                  <input name="quantity" type="number" min="0.001" step="0.001" required />
                </label>
                <label class="field-row field-row--split">
                  <span class="field-row__meta">
                    <span class="field-row__label">Details</span>
                    <span class="field-row__description">Cut, packing, or delivery notes.</span>
                  </span>
                  <textarea name="addDetails" placeholder="Optional item notes"></textarea>
                </label>
              </div>
            </Accordion>
          </div>
        </div>
      </section>

      <section class="order-create-section">
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Release</h3>
        </div>
        <div class="order-create-section__body order-create-form__fields">
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Date</span>
            </span>
            <input name="releaseDate" type="date" required data-release-date />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Time</span>
            </span>
            <input name="releaseTime" type="time" required data-release-time />
          </label>
        </div>
      </section>

      <template data-order-item-template>
        <details class="ui-accordion order-item-accordion" data-order-item-accordion>
          <summary class="ui-accordion__summary">
            <span class="ui-accordion__title" data-order-item-title>Select product</span>
            <span class="ui-accordion__summary-actions">
              <button
                type="button"
                class="order-item-accordion__remove"
                data-remove-order-item
                aria-label="Remove item"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                  <path d="M10 11v6"></path>
                  <path d="M14 11v6"></path>
                </svg>
              </button>
              <span class="ui-accordion__icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </span>
          </summary>
          <div class="ui-accordion__content">
            <div class="order-item-accordion__fields" data-order-item-row>
              <label class="field-row field-row--split">
                <span class="field-row__meta">
                  <span class="field-row__label">Product</span>
                </span>
                <select name="productId" required disabled={activeProducts.length === 0} data-order-product-select>
                  <option value="">Select product</option>
                  {activeProducts.map((product) => (
                    <option
                      value={product.id}
                      data-product-name={product.name}
                      data-product-retail-price={product.default_price}
                      data-product-reseller-price={product.reseller_price}
                    >
                      {product.name} - retail {formatCurrency(product.default_price)} / reseller {formatCurrency(product.reseller_price)} per {product.unit_label}
                    </option>
                  ))}
                </select>
              </label>
              <label class="field-row field-row--split">
                <span class="field-row__meta">
                  <span class="field-row__label">Quantity</span>
                </span>
                <input name="quantity" type="number" min="0.001" step="0.001" required />
              </label>
              <label class="field-row field-row--split">
                <span class="field-row__meta">
                  <span class="field-row__label">Details</span>
                  <span class="field-row__description">Cut, packing, or delivery notes.</span>
                </span>
                <textarea name="addDetails" placeholder="Optional item notes"></textarea>
              </label>
            </div>
          </div>
        </details>
      </template>

      <section class="order-create-section" data-downpayment-section>
        <div class="order-create-section__header">
          <h3 class="order-create-section__title">Payment</h3>
        </div>
        <div class="order-create-section__body order-create-form__fields order-create-form__payment-fields">
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Amount Received</span>
              <span class="field-row__description">Optional payment recorded when the order is created.</span>
            </span>
            <input name="downpaymentAmount" type="number" min="0.01" step="0.01" data-downpayment-amount />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Method</span>
            </span>
            <select name="downpaymentMethod" data-downpayment-method>
              <option value="Cash">Cash</option>
              <option value="Check">Check</option>
            </select>
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Terms</span>
            </span>
            <select name="downpaymentTerms" data-downpayment-terms>
              <option value="Cash on Delivery (COD)">Cash on Delivery (COD)</option>
              <option value="Bank Transfer">Bank Transfer</option>
              <option value="Gcash">Gcash</option>
            </select>
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Date</span>
            </span>
            <input name="downpaymentDate" type="date" value={new Date().toISOString().slice(0, 10)} data-downpayment-date />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Time</span>
            </span>
            <input name="downpaymentTime" type="time" value={defaultTime} data-downpayment-time />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Reference</span>
              <span class="field-row__description">Check number, transfer reference, or receipt ID.</span>
            </span>
            <input name="downpaymentReferenceNumber" data-downpayment-reference />
          </label>
          <label class="field-row field-row--split">
            <span class="field-row__meta">
              <span class="field-row__label">Notes</span>
            </span>
            <textarea name="downpaymentNotes" rows="2" data-downpayment-notes></textarea>
          </label>
        </div>
      </section>
    </form>
    <div slot="footer" class="order-create-sheet__footer">
      <div class="order-create-sheet__footer-total" aria-live="polite">
        <span>Total amount</span>
        <strong data-order-total-value>{formatCurrency(0)}</strong>
      </div>
      <button type="submit" form="create-order-form" disabled={!canCreateOrder}>Create order</button>
    </div>
  </Sheet>

  <div class="order-management-controls">
    <div class="table-filters order-management-toolbar">
      <form
        method="get"
        action="/admin/orders"
        class="order-filter-form order-filter-form--quad"
        data-order-filter-form
        data-current-filter-query={filterQuery}
        aria-label="Filter orders"
      >
        <div class="product-filter-form__search-row">
          <div class="order-filter-form__field order-filter-form__field--search">
            <input
              name="search"
              type="search"
              value={activeFilters.search ?? ""}
              placeholder="Search customer, phone, email, or customers in agent orders..."
              autocomplete="off"
              aria-label="Search orders"
              data-order-search-input
            />
          </div>
          <div class="product-filter-form__toolbar-actions">
            <button
              type="button"
              class="product-filter-form__icon-trigger"
              data-order-filter-modal-trigger
              data-open-dashboard-modal="order-filters-modal"
              aria-label="Open order filters"
              aria-pressed="false"
              aria-controls="order-filters-modal"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
              </svg>
            </button>
            <button
              type="button"
              class="product-filter-form__icon-trigger order-management-toolbar__document-modal-trigger"
              data-order-document-modal-trigger
              data-open-dashboard-modal="order-documents-modal"
              aria-label="Document options for selected orders"
              aria-controls="order-documents-modal"
              disabled
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="product-filter-form__icon-trigger product-filter-form__create-trigger"
              data-open-create-sheet
              data-sheet-target="#create-order-sheet"
              aria-label="Create order"
              disabled={!canCreateOrder}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>
        </div>
        <div class="product-filter-form__advanced-filters">
          <div class="order-filter-form__field">
            <select
              name="source"
              data-order-filter-field="source"
              aria-label="Filter by source"
            >
              <option value="">All sources</option>
              {orderSources.map((source) => (
                <option value={source} selected={activeFilters.source === source}>
                  {formatOrderSource(source)}
                </option>
              ))}
            </select>
          </div>
          <div class="order-filter-form__field">
            <select
              name="orderStatus"
              data-order-filter-field="orderStatus"
              aria-label="Filter by order status"
            >
              <option value="">All order statuses</option>
              {orderStatuses.map((status) => (
                <option value={status} selected={activeFilters.orderStatus === status}>
                  {autoCapitalize(status)}
                </option>
              ))}
            </select>
          </div>
          <div class="order-filter-form__field">
            <select
              name="paymentStatus"
              data-order-filter-field="paymentStatus"
              aria-label="Filter by payment status"
            >
              <option value="">All payment statuses</option>
              {paymentStatuses.map((status) => (
                <option value={status} selected={activeFilters.paymentStatus === status}>
                  {autoCapitalize(status)}
                </option>
              ))}
            </select>
          </div>
        </div>
      </form>
      <div class="order-management-toolbar__actions">
        <ActionMenu
          id="admin-orders-document-menu"
          menuLabel="Document options for selected orders"
          triggerLabel="Document"
          triggerClass="order-management-toolbar__document-menu"
          disabled
          items={orderDocumentMenuItems}
        />
        <Button
          type="button"
          class="order-management-toolbar__create"
          data-open-create-sheet
          data-sheet-target="#create-order-sheet"
          disabled={!canCreateOrder}
        >
          Create Order
        </Button>
      </div>
    </div>

    {!canCreateOrder && (
      <section class="order-management-notice" aria-live="polite">
        <p class="order-management-notice__copy">
          You cannot create an order until at least one product exists.{" "}
          <a href="/admin/products?create=product" class="order-management-notice__action">
            Create a product
          </a>
        </p>
      </section>
    )}
  </div>

  <div data-interactive-table data-server-pagination="true" class="dashboard-interactive-table dashboard-interactive-table--orders-content">
    <div data-order-table-shell class="dashboard-interactive-table__surface">
      <DashboardTableBoard>
        <table class="dashboard-table">
          <thead>
            <tr>
              <DashboardTableNumberHeader />
              <th scope="col" class="dashboard-table__select-column">
                <label class="dashboard-table__select-all">
                  <span class="sr-only">Select all orders on this page</span>
                  <input type="checkbox" data-order-select-all />
                </label>
              </th>
              <th scope="col">Date Created</th>
              <th scope="col">Order ID</th>
              <th scope="col">Customer</th>
              <th scope="col">Source</th>
              <th scope="col">Order Status</th>
              <th scope="col">Payment Status</th>
              <th scope="col">Order Total</th>
              <th scope="col">Remaining Receivable</th>
              <DashboardTableActionsHeader />
            </tr>
          </thead>
          <tbody>
            {orderRows.length === 0 ? (
              <DashboardTableEmptyState
                colspan={11}
                message="No orders match the selected filters."
              />
            ) : orderRows.map((order, index) => {
              return (
                <tr data-status={order.status}>
                  <td class="dashboard-table__number-column">{dashboardTableRowNumber(data.pagination, index)}</td>
                  <td class="dashboard-table__select-column">
                    <label class="dashboard-table__row-select">
                      <span class="sr-only">Select order for {order.customer_label}</span>
                      <input
                        type="checkbox"
                        value={order.id}
                        data-order-row-checkbox
                        data-order-row-type={order.row_type}
                      />
                    </label>
                  </td>
                  <td>{formatDate(order.created_at)}</td>
                  <td>{formatOrderCode(order.id)}</td>
                  <td class="dashboard-table__cell--truncate">
                    <span class="order-customer-cell">
                      <span class="order-customer-cell__name">{order.customer_label}</span>
                    {order.linked_customer_count !== null && (
                      <Tooltip text={linkedCustomerOrdersLabel(order.linked_customer_count)}>
                        <span class="order-customer-count">
                          {order.linked_customer_count}
                        </span>
                      </Tooltip>
                    )}
                    </span>
                  </td>
                  <td>{order.source_label}</td>
                  <td>
                    <StatusBadge kind="order" status={order.status} label={autoCapitalize(order.status)} />
                  </td>
                  <td>
                    {order.payment_status ? (
                      <StatusBadge kind="payment" status={order.payment_status} />
                    ) : (
                      <span class="dashboard-table__muted-line">N/A</span>
                    )}
                  </td>
                  <td>{formatCurrency(order.total_amount)}</td>
                  <td>{formatCurrency(order.remaining_receivable)}</td>
                  <td class="dashboard-table__actions-column">
                    {
                      isPendingCustomerOrderRow(order) ? (
                        <form
                          method="post"
                          action={orderActionPath}
                          class="order-table-action-form"
                          data-astro-reload
                        >
                          <input type="hidden" name="action" value="update-order-status" />
                          <input type="hidden" name="orderId" value={order.id} />
                          <input type="hidden" name="orderStatus" value="processing" />
                          <button type="submit" class="btn-table-manage">
                            Accept order
                          </button>
                        </form>
                      ) : (
                        <div class="order-table-actions">
                          <ViewButton href={order.href} data-astro-prefetch="false" />
                          {
                            order.row_type === "agent"
                              && (order.pending_customer_order_count ?? 0) > 0 && (
                              <Tooltip
                                text={pendingCustomerOrdersAwaitingLabel(order.pending_customer_order_count ?? 0)}
                                interactive
                              >
                                <button
                                  type="button"
                                  class="order-pending-customers-action"
                                  data-open-pending-customer-orders-modal
                                  data-distribution-order-id={order.id}
                                  data-distribution-label={order.customer_label}
                                  data-pending-customer-order-count={order.pending_customer_order_count ?? 0}
                                  aria-label={pendingCustomerOrdersAwaitingLabel(order.pending_customer_order_count ?? 0)}
                                >
                                  {order.pending_customer_order_count}
                                </button>
                              </Tooltip>
                            )
                          }
                        </div>
                      )
                    }
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DashboardTableBoard>
    </div>

    <DashboardTablePagination pagination={data.pagination} />
  </div>

  <template data-order-filter-skeleton>
    <DashboardTableBoard aria-busy="true" aria-live="polite">
      <table class="product-table-skeleton dashboard-table">
        <caption class="sr-only">Loading filtered orders</caption>
        <thead>
          <tr>
            <DashboardTableNumberHeader />
            <th scope="col" class="dashboard-table__select-column">
              <span class="table-skeleton-block table-skeleton-block--short"></span>
            </th>
            <th scope="col">Date Created</th>
            <th scope="col">Order ID</th>
            <th scope="col">Customer</th>
            <th scope="col">Source</th>
            <th scope="col">Order Status</th>
            <th scope="col">Payment Status</th>
            <th scope="col">Order Total</th>
            <th scope="col">Remaining Receivable</th>
            <DashboardTableActionsHeader />
          </tr>
        </thead>
        <tbody>
          {skeletonRows.map(() => (
            <tr>
              <td class="dashboard-table__number-column"><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td class="dashboard-table__select-column"><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block table-skeleton-block--short"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td><span class="table-skeleton-block"></span></td>
              <td class="dashboard-table__actions-column"><span class="table-skeleton-block table-skeleton-block--short"></span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DashboardTableBoard>
  </template>

  <Modal
    id="order-documents-modal"
    title="Document"
    description="Choose a document type for the selected orders."
  >
    <div class="order-documents-modal">
      {orderDocumentMenuItems.map((item) => (
        <button
          type="button"
          class="order-documents-modal__action"
          data-action-menu-item
          data-action={item.dataAction}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 3h6v6"></path>
            <path d="M10 14 21 3"></path>
            <path d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4"></path>
          </svg>
          <span>{item.label}</span>
        </button>
      ))}
    </div>
  </Modal>

  <Modal
    id="order-filters-modal"
    title="Filter orders"
    description="Narrow orders by source, status, and payment."
  >
    <div class="product-filter-modal">
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Source</span>
        <select data-order-filter-field="source" aria-label="Filter by source">
          <option value="">All sources</option>
          {orderSources.map((source) => (
            <option value={source} selected={activeFilters.source === source}>
              {formatOrderSource(source)}
            </option>
          ))}
        </select>
      </label>
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Order status</span>
        <select data-order-filter-field="orderStatus" aria-label="Filter by order status">
          <option value="">All order statuses</option>
          {orderStatuses.map((status) => (
            <option value={status} selected={activeFilters.orderStatus === status}>
              {autoCapitalize(status)}
            </option>
          ))}
        </select>
      </label>
      <label class="product-filter-modal__field">
        <span class="product-filter-modal__label">Payment status</span>
        <select data-order-filter-field="paymentStatus" aria-label="Filter by payment status">
          <option value="">All payment statuses</option>
          {paymentStatuses.map((status) => (
            <option value={status} selected={activeFilters.paymentStatus === status}>
              {autoCapitalize(status)}
            </option>
          ))}
        </select>
      </label>
      <div class="product-filter-modal__actions">
        <button
          type="button"
          class="product-filter-modal__clear"
          data-order-filter-modal-clear
        >
          Clear
        </button>
        <button
          type="button"
          class="product-filter-modal__apply"
          data-order-filter-modal-apply
        >
          Apply filters
        </button>
      </div>
    </div>
  </Modal>
</section>

<script>
  import { initAdminCreateOrderSheet } from "@/lib/client/admin-create-order-sheet";
  import { initAdminOrderBulkPdf } from "@/lib/client/admin-order-bulk-pdf";
  import { initAdminOrdersFragmentTable } from "@/lib/client/admin-orders-fragment-table";
  import { initDashboardFilterModals } from "@/lib/client/dashboard-filter-modal";

  function bootCreateOrderSheet() {
    initAdminCreateOrderSheet();
  }

  document.addEventListener("DOMContentLoaded", bootCreateOrderSheet);
  document.addEventListener("astro:after-swap", bootCreateOrderSheet);
  document.addEventListener("astro:page-load", bootCreateOrderSheet);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    bootCreateOrderSheet();
  }

  function initAdminOrderFilters() {
    initDashboardFilterModals();
    initAdminOrdersFragmentTable();
  }

  document.addEventListener("DOMContentLoaded", initAdminOrderFilters);
  document.addEventListener("astro:after-swap", initAdminOrderFilters);
  document.addEventListener("astro:page-load", initAdminOrderFilters);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminOrderFilters();
  }

  function initAdminOrderBulkPdfControls() {
    initAdminOrderBulkPdf();
  }

  document.addEventListener("DOMContentLoaded", initAdminOrderBulkPdfControls);
  document.addEventListener("astro:after-swap", initAdminOrderBulkPdfControls);
  document.addEventListener("astro:page-load", initAdminOrderBulkPdfControls);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initAdminOrderBulkPdfControls();
  }
</script>

