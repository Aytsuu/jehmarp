---
import AdminContentEditable from "@/components/admin/AdminContentEditable.astro";
import FormSubmissionFeedback from "@/components/ui/FormSubmissionFeedback.astro";
import PrivacyCollectionNotice from "@/components/public-website/PrivacyCollectionNotice.astro";
import { CONTACT_INQUIRY_FEEDBACK_PARAMS } from "@/lib/client/form-submission-feedback-url";
import {
  getSectionFieldEntries,
  getSectionHeading,
  type PublicPageContent,
} from "@/lib/public-website/content";
import { isLockedContactDetailsField } from "@/lib/platform-settings/contact-sync";
import { isAdminContentPreviewPath } from "@/lib/public-website/admin-content-preview";
import { getPublicEnv } from "@/lib/env";
import type { AdminContentEditingContext } from "@/lib/public-website/admin-content-editing";
import type { ContactInquiryFeedback } from "@/lib/public-website/contact-inquiries";

type Props = {
  content: PublicPageContent;
  feedback: ContactInquiryFeedback | null;
  turnstileSiteKey: string | null;
  returnPath?: string;
  contentEditing?: AdminContentEditingContext;
  privacyHref?: string | null;
  requirePrivacyAcknowledgement?: boolean;
};

const {
  content,
  feedback,
  turnstileSiteKey,
  returnPath,
  contentEditing,
  privacyHref = null,
  requirePrivacyAcknowledgement = false,
} = Astro.props;

const disableFormSubmission = returnPath
  ? isAdminContentPreviewPath(returnPath)
  : false;
const previewSubmissionTitle = "Submissions are disabled in content preview";
const turnstileRequired = !getPublicEnv().turnstileDisabled;

const detailsSection = content.sections.find((s) => s.type === "contact_details");
const orderingSection = content.sections.find((s) => s.type === "ordering_note");

const detailsEntries = detailsSection ? getSectionFieldEntries(detailsSection) : [];
const detailsHeading = detailsSection ? getSectionHeading(detailsSection) : "";
const orderingSummaryText =
  orderingSection?.content &&
  typeof orderingSection.content === "object" &&
  "summary" in orderingSection.content
    ? String((orderingSection.content as { summary?: unknown }).summary)
    : "";

function getIconTypeFromLabel(label: string) {
  const norm = label.toLowerCase();
  if (norm.includes("phone")) return "phone";
  if (norm.includes("email") || norm.includes("mail")) return "email";
  if (
    norm.includes("location") ||
    norm.includes("address") ||
    norm.includes("market")
  ) {
    return "location";
  }
  if (
    norm.includes("hour") ||
    norm.includes("time") ||
    norm.includes("open") ||
    norm.includes("day")
  ) {
    return "clock";
  }
  return "default";
}
---

<div class="business-layout">
  <div class="business-form">
    <section
      class="form-section"
      aria-labelledby="contact-inquiry-title"
      style="margin-top: 0;"
    >
      <h3
        id="contact-inquiry-title"
        class="business-subtitle"
        style="margin-bottom: 1.5rem;"
      >
        Inquiry Form
      </h3>
      {
        feedback?.status === "submitted" && (
          <FormSubmissionFeedback
            variant="success"
            title="Inquiry submitted"
            message="Your message was sent to the JEHMARP team. We will follow up using the contact details you provided."
            clearParams={CONTACT_INQUIRY_FEEDBACK_PARAMS}
          />
        )
      }
      {
        feedback?.status === "error" && (
          <FormSubmissionFeedback
            variant="error"
            title="Inquiry was not submitted"
            message={feedback.message}
            clearParams={CONTACT_INQUIRY_FEEDBACK_PARAMS}
          />
        )
      }
      <form
        class="form-grid"
        method="post"
        action="/api/contact-inquiries"
        onsubmit={disableFormSubmission ? "return false;" : undefined}
      >
        {returnPath && <input type="hidden" name="returnPath" value={returnPath} />}
        <fieldset class="fieldset-block">
          <legend>Contact details</legend>
          <div class="form-grid form-grid--two-column">
            <div class="field-row">
              <label for="name">Name</label>
              <input
                id="name"
                name="name"
                required
                autocomplete="name"
                maxlength="120"
              />
            </div>
            <div class="field-row">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="254"
              />
            </div>
            <div class="field-row">
              <label for="phoneNumber">Phone number</label>
              <input
                id="phoneNumber"
                name="phoneNumber"
                autocomplete="tel"
                maxlength="50"
              />
            </div>
          </div>
        </fieldset>

        <fieldset class="fieldset-block">
          <legend>Message</legend>
          <div class="field-row">
            <label for="message">How can we help?</label>
            <textarea id="message" name="message" required maxlength="2000"
            ></textarea>
          </div>
        </fieldset>

        <PrivacyCollectionNotice
          purpose="contact-inquiry"
          privacyHref={privacyHref}
          requireAcknowledgement={requirePrivacyAcknowledgement}
        />

        <div class="turnstile-container">
          {
            turnstileSiteKey ? (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
            ) : turnstileRequired ? (
              <p class="error-message">Contact verification is not configured.</p>
            ) : null
          }
        </div>

        <div class="button-row">
          <button
            type="submit"
            disabled={disableFormSubmission || (turnstileRequired && !turnstileSiteKey)}
            title={disableFormSubmission ? previewSubmissionTitle : undefined}
          >
            Send inquiry
          </button>
        </div>
      </form>
    </section>
  </div>

  <div class="business-info">
    {
      detailsSection && (
        <section
          class="contact-details-section"
          aria-labelledby="contact-details-heading"
        >
          <AdminContentEditable
            contentEditing={contentEditing}
            section={detailsSection}
            fieldKey="heading"
            fieldLabel="Contact details heading"
            value={detailsHeading}
          >
            <h3 id="contact-details-heading" class="business-subtitle">
              {detailsHeading}
            </h3>
          </AdminContentEditable>

          <div class="contact-details-list">
            {detailsEntries.map((entry) => {
              const iconType = getIconTypeFromLabel(entry.label);
              return (
                <div class="contact-details-item">
                  <span class="contact-details-icon" aria-hidden="true">
                    {iconType === "phone" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                      </svg>
                    )}
                    {iconType === "email" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                        <polyline points="22,6 12,13 2,6" />
                      </svg>
                    )}
                    {iconType === "location" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>
                    )}
                    {iconType === "clock" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    )}
                    {iconType === "default" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="4" />
                      </svg>
                    )}
                  </span>
                  {
                    isLockedContactDetailsField(entry.key) ? (
                      <span class="contact-details-value">{entry.value}</span>
                    ) : (
                      <AdminContentEditable
                        contentEditing={contentEditing}
                        section={detailsSection}
                        fieldKey={entry.key}
                        fieldLabel={entry.label}
                        value={entry.value}
                        class="admin-content-editable--inline"
                      >
                        <span class="contact-details-value">{entry.value}</span>
                      </AdminContentEditable>
                    )
                  }
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    {
      orderingSection && orderingSummaryText && (
        <div class="contact-ordering-summary">
          <AdminContentEditable
            contentEditing={contentEditing}
            section={orderingSection}
            fieldKey="summary"
            fieldLabel="Ordering note summary"
            value={orderingSummaryText}
            multiline
          >
            <p class="business-text">{orderingSummaryText}</p>
          </AdminContentEditable>
        </div>
      )
    }
  </div>
</div>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}
