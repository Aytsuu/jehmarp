---
import FormSubmissionFeedback from "@/components/ui/FormSubmissionFeedback.astro";
import PrivacyCollectionNotice from "@/components/public-website/PrivacyCollectionNotice.astro";
import { GUEST_ORDER_FEEDBACK_PARAMS } from "@/lib/client/form-submission-feedback-url";
import { isAdminContentPreviewPath } from "@/lib/public-website/admin-content-preview";
import { getPublicEnv } from "@/lib/env";
import {
  applyShopFilters,
  SHOP_PAGE_SIZE,
  type PublicProduct,
} from "@/lib/public-website/shop";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  products: PublicProduct[];
  orderStatus: string | null;
  orderEmailStatus: "sent" | "failed" | "unavailable" | null;
  orderMessage: string | null;
  turnstileSiteKey: string | null;
  returnPath?: string;
  privacyHref?: string | null;
  requirePrivacyAcknowledgement?: boolean;
};

const {
  products,
  orderStatus,
  orderEmailStatus,
  orderMessage,
  turnstileSiteKey,
  returnPath,
  privacyHref = null,
  requirePrivacyAcknowledgement = false,
} = Astro.props;

const disableFormSubmission = returnPath
  ? isAdminContentPreviewPath(returnPath)
  : false;
const previewSubmissionTitle = "Submissions are disabled in content preview";

function getProductImage(name: string): string {
  const normalized = name.toLowerCase();
  if (normalized.includes("pork belly")) return "/images/pork_belly.png";
  if (normalized.includes("chicken breast"))
    return "/images/chicken_breast.png";
  if (normalized.includes("short ribs") || normalized.includes("beef")) {
    return "/images/beef_short_ribs.png";
  }
  if (normalized.includes("ground pork")) return "/images/ground_pork.png";
  return "/images/meat_cluster.svg";
}

function getResolvedProductImage(imagePath: string | null, name: string) {
  return resolvePublicStorageUrl(imagePath) ?? getProductImage(name);
}

const catalogProducts = products.map((product) => ({
  ...product,
  imageUrl: getResolvedProductImage(product.image_path, product.name),
}));

const defaultFilters = {
  sort: "name_asc" as const,
  page: 1,
  pageSize: SHOP_PAGE_SIZE,
};

const { products: initialProducts, pagination } = applyShopFilters(
  products,
  defaultFilters,
);

const priceMax =
  products.length > 0
    ? Math.max(
        1000,
        ...products.map((product) => Number(product.default_price)),
      )
    : 1000;

const orderCatalog = catalogProducts.map((product) => ({
  id: product.id,
  name: product.name,
  defaultPrice: product.default_price,
  unitLabel: product.unit_label,
  stockStatus: product.stock_status,
  imageUrl: product.imageUrl,
}));

const availableOrderProducts = catalogProducts.filter(
  (product) => product.stock_status !== "out_of_stock",
);
const turnstileRequired = !getPublicEnv().turnstileDisabled;
const canSubmitOrder =
  !disableFormSubmission &&
  availableOrderProducts.length > 0 &&
  (!turnstileRequired || Boolean(turnstileSiteKey));

const orderSuccessMessage = orderEmailStatus === "sent"
  ? "Your guest order was submitted for review. We sent your customer tracking number to the email address you provided."
  : orderEmailStatus === "failed"
    ? "Your guest order was submitted for review, but we could not deliver the tracking email. Please contact our team so we can share your customer tracking number."
    : orderEmailStatus === "unavailable"
      ? "Your guest order was submitted for review. Email delivery is not available right now, so our team will share your customer tracking number with you."
      : "Your guest order was submitted for review. Our team will share your customer tracking number with you so you can follow your order status.";

const orderErrorMessage =
  orderMessage ?? "Please check the order form and try again.";
---

<div class="shop-header-banner">
  <img
    src="/images/shop_banner.png"
    alt="Fresh Local Meats Banner"
    class="shop-header-banner__image"
    loading="eager"
  />
  <div class="shop-header-banner__overlay">
    <div class="shop-header-banner__content">
      <h1 class="shop-header-banner__title">
        Farm-Fresh Meats, Delivered Daily
      </h1>
      <p class="shop-header-banner__subtitle">
        Premium local pork, chicken, and fresh cuts sourced directly from
        trusted local farmers.
      </p>
    </div>
  </div>
</div>

<section
  class="form-section form-section--shop-filters"
  aria-labelledby="shop-filters"
>
  <form class="form-grid form-grid--filters" data-shop-filters-form>
    <div class="field-row">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All categories</option>
        <option value="pork">Pork</option>
        <option value="chicken">Chicken</option>
        <option value="egg">Egg</option>
      </select>
    </div>

    <div class="field-row">
      <label for="stockStatus">Stock status</label>
      <select id="stockStatus" name="stockStatus">
        <option value="">All stock statuses</option>
        <option value="in_stock">In stock</option>
        <option value="limited">Limited</option>
        <option value="out_of_stock">Out of stock</option>
      </select>
    </div>

    <div class="field-row">
      <label for="minPrice"
        >Minimum price (PHP <span id="minPriceVal">0</span>)</label
      >
      <input
        id="minPrice"
        name="minPrice"
        type="range"
        min="0"
        max={priceMax}
        step="5"
        value="0"
      />
    </div>

    <div class="field-row">
      <label for="maxPrice"
        >Maximum price (PHP <span id="maxPriceVal">{priceMax}</span>)</label
      >
      <input
        id="maxPrice"
        name="maxPrice"
        type="range"
        min="0"
        max={priceMax}
        step="5"
        value={priceMax}
      />
    </div>

    <div class="field-row">
      <label for="sort">Sort</label>
      <select id="sort" name="sort">
        <option value="name_asc" selected>Name, A to Z</option>
        <option value="name_desc">Name, Z to A</option>
        <option value="price_asc">Price, low to high</option>
        <option value="price_desc">Price, high to low</option>
        <option value="newest">Newest</option>
      </select>
    </div>
  </form>
</section>

<section
  class="shop-products-section"
  aria-labelledby="product-list"
  data-shop-products-section
>
  <script
    type="application/json"
    data-shop-product-catalog
    set:html={JSON.stringify(catalogProducts)}
  />

  <p data-shop-products-summary>
    Showing page {pagination.currentPage} of {pagination.totalPages}. {
      pagination.count
    } product{pagination.count === 1 ? "" : "s"} found.
  </p>

  {
    initialProducts.length > 0 ? (
      <ul class="shop-product-grid" data-shop-product-grid>
        {initialProducts.map((product) => (
          <li>
            <article class="product-card">
              <div class="product-card__image-container">
                <img
                  src={getResolvedProductImage(
                    product.image_path,
                    product.name,
                  )}
                  alt={product.name}
                  class="product-card__image"
                />
                {product.stock_status === "out_of_stock" && (
                  <span class="product-card__badge product-card__badge--sold-out">
                    SOLD OUT
                  </span>
                )}
                {product.stock_status === "limited" && (
                  <span class="product-card__badge product-card__badge--limited">
                    LIMITED
                  </span>
                )}
              </div>
              <div class="product-card__content">
                <div class="product-card__price-row">
                  <span>Price from </span>
                  <span class="product-card__price-val">
                    PHP {Number(product.default_price).toFixed(2)}
                  </span>
                  <span class="product-card__unit-label">
                    / {product.unit_label}
                  </span>
                </div>
                <h3 class="product-card__title">{product.name}</h3>
                <div class="product-card__status-row">
                  <span class="product-card__status-text">
                    {product.stock_status === "in_stock" && "In stock"}
                    {product.stock_status === "limited" && "Limited Stock"}
                    {product.stock_status === "out_of_stock" && "Out of stock"}
                  </span>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p data-shop-products-empty hidden>
        No active products match the selected filters.
      </p>
    )
  }

  <nav
    class="shop-pagination"
    aria-label="Product pagination"
    data-shop-pagination
  >
    {
      pagination.previousPage ? (
        <button
          type="button"
          class="pagination-arrow"
          data-shop-page={pagination.previousPage}
          aria-label="Previous page"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
      ) : (
        <span class="pagination-arrow pagination-arrow--disabled">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </span>
      )
    }

    <div class="pagination-dots">
      {
        Array.from({ length: pagination.totalPages }, (_, i) => i + 1).map(
          (p) => {
            const isActive = p === pagination.currentPage;
            return isActive ? (
              <span
                class="pagination-indicator pagination-indicator--active"
                aria-current="page"
              />
            ) : (
              <button
                type="button"
                class="pagination-indicator"
                data-shop-page={p}
                aria-label={`Go to page ${p}`}
              />
            );
          },
        )
      }
    </div>

    {
      pagination.nextPage ? (
        <button
          type="button"
          class="pagination-arrow"
          data-shop-page={pagination.nextPage}
          aria-label="Next page"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      ) : (
        <span class="pagination-arrow pagination-arrow--disabled">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </span>
      )
    }
  </nav>
</section>

<section class="shop-guest-order-section" aria-labelledby="guest-order">
  <header class="shop-guest-order-section__header">
    <h2 id="guest-order" class="page-title-brand">ORDER FORM</h2>
    <p class="shop-guest-order-section__intro">
      Complete your details below, add products individually, then submit for
      review.
    </p>
  </header>
  {
    orderStatus === "submitted" && (
      <FormSubmissionFeedback
        variant="success"
        title="Order submitted"
        message={orderSuccessMessage}
        clearParams={GUEST_ORDER_FEEDBACK_PARAMS}
      />
    )
  }
  {
    orderStatus === "error" && (
      <FormSubmissionFeedback
        variant="error"
        title="Order was not submitted"
        message={orderErrorMessage}
        clearParams={GUEST_ORDER_FEEDBACK_PARAMS}
      />
    )
  }
  <form
    class="shop-guest-order-form form-grid"
    method="post"
    action="/api/guest-orders"
    onsubmit={disableFormSubmission ? "return false;" : undefined}
  >
    {returnPath && <input type="hidden" name="returnPath" value={returnPath} />}

    <script
      type="application/json"
      data-shop-order-catalog
      set:html={JSON.stringify(orderCatalog)}
    />

    <fieldset class="shop-guest-order-form__panel">
      <legend>Customer details</legend>
      <div class="form-grid form-grid--two-column">
        <div class="field-row">
          <label for="firstName">First name</label>
          <input
            id="firstName"
            name="firstName"
            required
            autocomplete="given-name"
          />
        </div>
        <div class="field-row">
          <label for="lastName">Last name</label>
          <input
            id="lastName"
            name="lastName"
            required
            autocomplete="family-name"
          />
        </div>
        <div class="field-row">
          <label for="phoneNumber">Phone number</label>
          <input
            id="phoneNumber"
            name="phoneNumber"
            required
            autocomplete="tel"
          />
        </div>
        <div class="field-row">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" />
        </div>
      </div>
      <div class="field-row shop-guest-order-form__address">
        <label for="address">Delivery address</label>
        <textarea
          id="address"
          name="address"
          required
          autocomplete="street-address"
          rows="4"></textarea>
      </div>
    </fieldset>

    <fieldset class="shop-guest-order-form__panel">
      <legend>Order items</legend>
      <p class="shop-guest-order-form__items-hint">
        Add products one at a time. You can include optional notes for each
        item.
      </p>

      {
        availableOrderProducts.length > 0 ? (
          <div class="shop-guest-order-form__add-item">
            <p class="shop-guest-order-form__add-item-label">Add a product</p>
            <div class="shop-guest-order-form__add-item-controls">
              <div class="field-row shop-guest-order-form__product-picker">
                <label for="shop-order-product-select">Product</label>
                <select
                  id="shop-order-product-select"
                  data-shop-order-product-select
                >
                  <option value="">Select a product</option>
                  {availableOrderProducts.map((product) => (
                    <option value={product.id}>
                      {product.name} — PHP{" "}
                      {Number(product.default_price).toFixed(2)} /{" "}
                      {product.unit_label}
                    </option>
                  ))}
                </select>
              </div>
              <button
                type="button"
                class="shop-guest-order-form__add-button"
                data-shop-order-add-item
              >
                Add item
              </button>
            </div>
          </div>
        ) : (
          <p class="shop-guest-order-form__empty">
            No active products are available for guest ordering.
          </p>
        )
      }

      <h3 class="shop-guest-order-form__lines-heading">Your items</h3>

      <div class="shop-order-lines" data-shop-order-lines>
        <p class="shop-guest-order-form__empty-state" data-shop-order-empty>
          No items added yet.
        </p>
      </div>

      <template data-shop-order-line-template>
        <article class="shop-order-line" data-shop-order-line>
          <div class="shop-order-line__media">
            <img src="" alt="" loading="lazy" data-shop-order-line-image />
          </div>
          <div class="shop-order-line__body">
            <div class="shop-order-line__header">
              <h3 data-shop-order-line-name></h3>
              <button
                type="button"
                class="shop-order-line__remove"
                data-shop-order-remove-item
                aria-label="Remove item"
              >
                Remove
              </button>
            </div>
            <p class="shop-order-line__price" data-shop-order-line-price></p>
            <div class="shop-order-line__quantity">
              <label data-shop-order-line-quantity-label>Quantity</label>
              <div class="shop-order-line__quantity-controls">
                <button
                  type="button"
                  class="shop-order-line__qty-step"
                  data-shop-order-qty-step="down"
                  aria-label="Decrease quantity"
                >
                  -
                </button>
                <input
                  type="number"
                  min="0.001"
                  step="0.001"
                  inputmode="decimal"
                  value="1"
                  required
                  data-shop-order-quantity
                />
                <button
                  type="button"
                  class="shop-order-line__qty-step"
                  data-shop-order-qty-step="up"
                  aria-label="Increase quantity"
                >
                  +
                </button>
              </div>
            </div>
            <div class="field-row shop-order-line__details">
              <label data-shop-order-line-details-label
                >Item notes (optional)</label
              >
              <input
                type="text"
                placeholder="Cut preference, packaging, etc."
                data-shop-order-details
              />
            </div>
            <p class="shop-order-line__subtotal">
              Line total:
              <strong data-shop-order-line-total>PHP 0.00</strong>
            </p>
          </div>
        </article>
      </template>

      <div class="shop-guest-order-form__total" aria-live="polite">
        <span class="shop-guest-order-form__total-label">Order total</span>
        <strong
          class="shop-guest-order-form__total-value"
          data-shop-order-total-value
        >
          PHP 0.00
        </strong>
      </div>
    </fieldset>

    <div class="shop-guest-order-form__footer">
      <PrivacyCollectionNotice
        purpose="guest-order"
        privacyHref={privacyHref}
        requireAcknowledgement={requirePrivacyAcknowledgement}
      />
      <div class="turnstile-container shop-guest-order-form__turnstile">
        {
          turnstileSiteKey ? (
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
          ) : turnstileRequired ? (
            <p class="error-message">
              Guest order verification is not configured.
            </p>
          ) : null
        }
      </div>

      <div class="button-row shop-guest-order-form__submit">
        <button
          type="submit"
          disabled={!canSubmitOrder}
          title={disableFormSubmission ? previewSubmissionTitle : undefined}
          data-shop-order-submit
          data-shop-order-submit-locked={!canSubmitOrder ? "true" : undefined}
        >
          Submit order
        </button>
      </div>
    </div>
  </form>
</section>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import { initShopFilters } from "@/lib/client/shop-filters";
  import { initShopGuestOrderForm } from "@/lib/client/shop-guest-order-form";

  function initShopPageScripts() {
    initShopFilters();
    initShopGuestOrderForm();
  }

  document.addEventListener("DOMContentLoaded", initShopPageScripts);
  document.addEventListener("astro:after-swap", initShopPageScripts);

  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initShopPageScripts();
  }
</script>
