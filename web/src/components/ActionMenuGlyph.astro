---
export type ActionMenuGlyph =
  | "vertical"
  | "horizontal"
  | "document"
  | "external-pdf"
  | "details";

type Props = {
  glyph: ActionMenuGlyph;
};

const { glyph } = Astro.props;
---

{
  glyph === "vertical" ? (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="5" r="1.75"></circle>
      <circle cx="12" cy="12" r="1.75"></circle>
      <circle cx="12" cy="19" r="1.75"></circle>
    </svg>
  ) : glyph === "horizontal" ? (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="5" cy="12" r="1.75"></circle>
      <circle cx="12" cy="12" r="1.75"></circle>
      <circle cx="19" cy="12" r="1.75"></circle>
    </svg>
  ) : glyph === "document" ? (
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="16" y1="13" x2="8" y2="13"></line>
      <line x1="16" y1="17" x2="8" y2="17"></line>
      <polyline points="10 9 9 9 8 9"></polyline>
    </svg>
  ) : glyph === "external-pdf" ? (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 3h6v6"></path>
      <path d="M10 14 21 3"></path>
      <path d="M21 14v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h4"></path>
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 6.75H19.5"></path>
      <path d="M9 12H19.5"></path>
      <path d="M9 17.25H19.5"></path>
      <path d="M4.5 6.75h.01"></path>
      <path d="M4.5 12h.01"></path>
      <path d="M4.5 17.25h.01"></path>
    </svg>
  )
}
