<script>
  function initFaqAccordion() {
    document.querySelectorAll<HTMLElement>("[data-faq-accordion]").forEach((accordion) => {
      if (accordion.dataset.faqAccordionBound === "true") {
        return;
      }

      accordion.dataset.faqAccordionBound = "true";
      accordion.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const trigger = target.closest<HTMLButtonElement>(".faq-item__trigger");
        if (!trigger || !accordion.contains(trigger)) {
          return;
        }

        const item = trigger.closest<HTMLElement>(".faq-item");
        if (!item) {
          return;
        }

        const isActive = item.classList.contains("faq-item--active");
        accordion.querySelectorAll(".faq-item").forEach((faqItem) => {
          faqItem.classList.remove("faq-item--active");
        });

        if (!isActive) {
          item.classList.add("faq-item--active");
        }
      });
    });
  }

  initFaqAccordion();
  document.addEventListener("astro:after-swap", initFaqAccordion);
  document.addEventListener("faq-accordion:refresh", initFaqAccordion);

  function initMissionTextExpand() {
    document.querySelectorAll("[data-mission-text-expand]").forEach((wrap) => {
      const text = wrap.querySelector(".mission-card__text");
      const button = wrap.querySelector("[data-mission-text-toggle]");
      if (
        !(text instanceof HTMLElement) ||
        !(button instanceof HTMLButtonElement)
      ) {
        return;
      }

      const isOverflowing = () => text.scrollHeight > text.clientHeight + 1;

      const syncToggleVisibility = () => {
        if (wrap.classList.contains("is-expanded")) {
          button.hidden = false;
          return;
        }

        button.hidden = !isOverflowing();
      };

      syncToggleVisibility();
      window.addEventListener("resize", syncToggleVisibility);

      button.addEventListener("click", () => {
        const expanded = wrap.classList.toggle("is-expanded");
        button.textContent = expanded ? "View less" : "View more";
        button.setAttribute("aria-expanded", String(expanded));
        syncToggleVisibility();
      });
    });
  }

  function initMissionTabs() {
    document.querySelectorAll<HTMLElement>("[data-mission-section]").forEach((section) => {
      if (section.dataset.missionTabsBound === "true") {
        return;
      }

      const tabs = Array.from(
        section.querySelectorAll<HTMLButtonElement>("[data-mission-tab]"),
      );
      const panels = Array.from(
        section.querySelectorAll<HTMLElement>("[data-mission-panel]"),
      );

      if (tabs.length === 0 || panels.length === 0) {
        return;
      }

      const activateTab = (tabId: string) => {
        tabs.forEach((tab) => {
          const isActive = tab.dataset.missionTab === tabId;
          tab.classList.toggle("is-active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
        });

        panels.forEach((panel) => {
          const isActive = panel.dataset.missionPanel === tabId;
          panel.classList.toggle("is-active", isActive);
        });

        window.dispatchEvent(new Event("resize"));
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const tabId = tab.dataset.missionTab;
          if (!tabId || tab.classList.contains("is-active")) {
            return;
          }

          activateTab(tabId);
        });
      });

      section.dataset.missionTabsBound = "true";
    });
  }

  initMissionTextExpand();
  initMissionTabs();
  document.addEventListener("astro:after-swap", initMissionTextExpand);
  document.addEventListener("astro:after-swap", initMissionTabs);
</script>
