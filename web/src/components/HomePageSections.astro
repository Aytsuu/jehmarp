---
import AdminContentEditable from "@/components/admin/AdminContentEditable.astro";
import AdminContentEditableImage from "@/components/admin/AdminContentEditableImage.astro";
import AdminFaqEditor from "@/components/admin/AdminFaqEditor.astro";
import AdminTaglinesEditor from "@/components/admin/AdminTaglinesEditor.astro";
import TaglineDisplayStack from "@/components/home/TaglineDisplayStack.astro";
import type {
  PublicFeaturedProduct,
  PublicPageSectionRecord,
} from "@/lib/public-website/content";
import type { AdminContentEditingContext } from "@/lib/public-website/admin-content-editing";
import { getAboutSectionImage, getWhyChooseSectionImage } from "@/lib/public-website/home-section-image";
import {
  getProductCategoryImage,
  normalizeProductCategories,
} from "@/lib/public-website/home-product-categories";
import { normalizeTaglineItems } from "@/lib/public-website/home-taglines";
import {
  getFaqDescription,
  getFaqHeading,
  getFaqItems,
} from "@/lib/public-website/home-faq";
import MissionExpandableText from "@/components/MissionExpandableText.astro";
import { toAdminContentPreviewHref } from "@/lib/public-website/admin-content-preview";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  sections: PublicPageSectionRecord[];
  featuredProducts: PublicFeaturedProduct[];
  previewRoot?: string;
  contentEditing?: AdminContentEditingContext;
};

const { sections, featuredProducts, previewRoot, contentEditing } = Astro.props;

function linkHref(href: string) {
  return previewRoot ? toAdminContentPreviewHref(href) : href;
}

const about = sections.find((section) => section.type === "about");
const missionVisionCoreValues = sections.find(
  (section) => section.type === "mission_vision_core_values",
);
const taglines = sections.find((section) => section.type === "taglines");
const shopInfoSource = sections.find(
  (section) => section.type === "images_gallery",
);
const whyChoose = sections.find((section) => section.type === "why_choose");
const productCategoryRange = sections.find(
  (section) => section.type === "product_category_range",
);
const faq = sections.find((section) => section.type === "faq");

const aboutHeading = stringValue(about?.content.heading) ?? "The Meatshop";
const aboutSummary = stringValue(about?.content.summary);
const aboutBody = stringValue(about?.content.body);
const aboutImage = getAboutSectionImage(about?.content);
const whyChooseImage = getWhyChooseSectionImage(whyChoose?.content);
const productCategoryContent = normalizeProductCategories(productCategoryRange?.content);
const whyChooseHeading =
  stringValue(whyChoose?.content.heading) ?? "Why Choose JEHMARP";
const missionText = stringValue(missionVisionCoreValues?.content.mission) ?? "";
const visionText = stringValue(missionVisionCoreValues?.content.vision) ?? "";
const coreValuesText = coreValuesContent(
  missionVisionCoreValues?.content.coreValues,
);
const taglineItems = normalizeTaglineItems(taglines?.content.items);
const faqHeading = getFaqHeading(faq?.content);
const faqDescription = getFaqDescription(faq?.content);
const faqItems = getFaqItems(faq?.content);
const storefrontBenefits = [
  {
    title: "Direct from Local Farmers",
    desc: "Partnering with trusted local farmers ensures the delivery of the best quality meat while supporting local agriculture.",
    class: "why-buy-card--0",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
  },
  {
    title: "Guaranteed Freshness",
    desc: "Every product is freshly delivered and carefully handled daily to meet strict standards of top-notch freshness.",
    class: "why-buy-card--1",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    title: "Affordable & Fair Pricing",
    desc: "Premium quality meat is offered at fair, budget-friendly prices accessible to every family.",
    class: "why-buy-card--2",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
  {
    title: "Trusted Family Experience",
    desc: "A multi-generational, family-run business built on a foundation of honesty, dedication, and genuine care for its customers.",
    class: "why-buy-card--3",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
  },
  {
    title: "Community-Centered Business",
    desc: "Dedicated to giving back, supporting community livelihoods, and uplifting the local neighborhood that has supported the business throughout the years.",
    class: "why-buy-card--4",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];

function stringValue(value: unknown): string | undefined {
  return typeof value === "string" && value.trim().length > 0
    ? value.trim()
    : undefined;
}

function asStringArray(value: unknown): string[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value.flatMap((item) =>
    typeof item === "string" && item.trim().length > 0 ? [item.trim()] : [],
  );
}

function coreValuesContent(value: unknown): string | undefined {
  const text = stringValue(value);
  if (text) {
    return text;
  }

  const items = asStringArray(value);
  return items.length > 0 ? items.join(" ") : undefined;
}

function getProductImage(name: string): string {
  const normalized = name.toLowerCase();
  if (normalized.includes("pork belly")) return "/images/pork_belly.png";
  if (normalized.includes("chicken breast"))
    return "/images/chicken_breast.png";
  if (normalized.includes("short ribs") || normalized.includes("beef"))
    return "/images/beef_short_ribs.png";
  if (normalized.includes("ground pork")) return "/images/ground_pork.png";
  return "/images/meat_cluster.svg";
}

function getFeaturedProductImage(product: PublicFeaturedProduct): string {
  return (
    resolvePublicStorageUrl(product.image_path) ?? getProductImage(product.name)
  );
}

const defaultBestSellers = [
  {
    id: "best-1",
    name: "Pork Belly Prime Cut",
    price: "₱380.00",
    image: "/images/pork_belly.png",
    description:
      "Freshly cut pork belly with ideal fat-to-meat ratio, perfect for grilling or crisp roasting.",
    badge: null,
    availability: "Freshly packed daily",
  },
  {
    id: "best-2",
    name: "Chicken Breast (Skinless)",
    price: "₱240.00",
    image: "/images/chicken_breast.png",
    description:
      "Lean, tender chicken breast prepared fresh daily, ideal for healthy home meals.",
    badge: null,
    availability: "Freshly packed daily",
  },
  {
    id: "best-3",
    name: "Beef Short Ribs",
    price: "From ₱420.00",
    image: "/images/beef_short_ribs.png",
    description:
      "Richly marbled beef short ribs cut for slow stewing, braising, or smoking.",
    badge: "SOLD OUT",
    availability: "Out of stock",
  },
  {
    id: "best-4",
    name: "Special Ground Pork",
    price: "₱260.00",
    image: "/images/ground_pork.png",
    description:
      "Freshly ground pork prepared from lean cuts, perfect for lumpia, patties, and sauces.",
    badge: null,
    availability: "Freshly packed daily",
  },
];

const bestSellersList = defaultBestSellers.map((defaultItem, index) => {
  const dbProduct = featuredProducts[index];
  if (dbProduct) {
    return {
      id: dbProduct.id,
      name: dbProduct.name,
      price: defaultItem.price,
      image: getFeaturedProductImage(dbProduct),
      description: dbProduct.description ?? defaultItem.description,
      badge: defaultItem.badge,
      availability: defaultItem.availability,
    };
  }
  return defaultItem;
});

const featuredProductsList =
  featuredProducts.length > 0
    ? featuredProducts.map((prod, i) => ({
        id: prod.id,
        name: prod.name,
        price: defaultBestSellers[i]?.price ?? "₱250.00",
        image: getFeaturedProductImage(prod),
        description:
          prod.description ??
          defaultBestSellers[i]?.description ??
          "Fresh local cut prepared daily.",
        category_name: "Fresh Cut",
      }))
    : defaultBestSellers.map((item) => ({
        ...item,
        category_name: "Fresh Cut",
      }));

---

<div class="home-sections">
  {
    about && (
      <div class="home-container">
        <section class="about-section" aria-labelledby="home-about">
          <div class="about-section__grid">
            <div class="about-section__image-container">
              {
                contentEditing && about ? (
                  <AdminContentEditableImage
                    contentEditing={contentEditing}
                    section={about}
                    imageSrc={aboutImage.imageSrc}
                    imageAlt={aboutImage.imageAlt}
                    displaySrc={aboutImage.displaySrc}
                    imageClass="about-section__image"
                    popoverTitle="Replace Image"
                  />
                ) : (
                  <img
                    src={aboutImage.displaySrc}
                    alt={aboutImage.imageAlt}
                    class="about-section__image"
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
            </div>
            <div class="about-section__content">
              <AdminContentEditable
                contentEditing={contentEditing}
                section={about}
                fieldKey="heading"
                fieldLabel="About heading"
                value={aboutHeading}
              >
                <h2 id="home-about" class="about-section__title">
                  {aboutHeading}
                </h2>
              </AdminContentEditable>
              {aboutSummary && (
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={about}
                  fieldKey="summary"
                  fieldLabel="About summary"
                  value={aboutSummary}
                  multiline
                >
                  <p class="about-section__summary">{aboutSummary}</p>
                </AdminContentEditable>
              )}
              {aboutBody && (
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={about}
                  fieldKey="body"
                  fieldLabel="About body"
                  value={aboutBody}
                  multiline
                >
                  <p class="about-section__body">{aboutBody}</p>
                </AdminContentEditable>
              )}
            </div>
          </div>
        </section>
      </div>
    )
  }

  {
    missionVisionCoreValues && (
      <div class="mission-section-outer">
        <div class="home-container">
          <section
            class="mission-section"
            data-mission-section
            aria-label="Mission, Vision, and Core Values"
          >
            <div
              class="mission-section__tabs"
              role="tablist"
              aria-label="Mission, Vision, and Core Values"
            >
              <button
                type="button"
                class="mission-section__tab is-active"
                role="tab"
                id="mission-tab-mission"
                aria-selected="true"
                aria-controls="mission-panel-mission"
                data-mission-tab="mission"
              >
                Mission
              </button>
              <button
                type="button"
                class="mission-section__tab"
                role="tab"
                id="mission-tab-vision"
                aria-selected="false"
                aria-controls="mission-panel-vision"
                data-mission-tab="vision"
                tabindex="-1"
              >
                Vision
              </button>
              <button
                type="button"
                class="mission-section__tab"
                role="tab"
                id="mission-tab-values"
                aria-selected="false"
                aria-controls="mission-panel-values"
                data-mission-tab="values"
                tabindex="-1"
              >
                Core Values
              </button>
            </div>
            <div class="mission-section__grid">
              <article
                class="mission-card mission-card--mission is-active"
                id="mission-panel-mission"
                role="tabpanel"
                aria-labelledby="mission-tab-mission"
                data-mission-panel="mission"
              >
                <div class="mission-card__icon-wrapper">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mission-card__icon"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="6" />
                    <circle cx="12" cy="12" r="2" />
                  </svg>
                </div>
                <h3 class="mission-card__heading">Mission</h3>
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={missionVisionCoreValues}
                  fieldKey="mission"
                  fieldLabel="Mission"
                  value={missionText}
                  multiline
                >
                  <MissionExpandableText
                    text={missionText}
                    fallback="Mission content is not available yet."
                  />
                </AdminContentEditable>
              </article>
              <article
                class="mission-card mission-card--vision"
                id="mission-panel-vision"
                role="tabpanel"
                aria-labelledby="mission-tab-vision"
                data-mission-panel="vision"
              >
                <div class="mission-card__icon-wrapper">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mission-card__icon"
                  >
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                </div>
                <h3 class="mission-card__heading">Vision</h3>
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={missionVisionCoreValues}
                  fieldKey="vision"
                  fieldLabel="Vision"
                  value={visionText}
                  multiline
                >
                  <MissionExpandableText
                    text={visionText}
                    fallback="Vision content is not available yet."
                  />
                </AdminContentEditable>
              </article>
              <article
                class="mission-card mission-card--values"
                id="mission-panel-values"
                role="tabpanel"
                aria-labelledby="mission-tab-values"
                data-mission-panel="values"
              >
                <div class="mission-card__icon-wrapper">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mission-card__icon"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                </div>
                <h3 class="mission-card__heading">Core Values</h3>
                <AdminContentEditable
                  contentEditing={contentEditing}
                  section={missionVisionCoreValues}
                  fieldKey="coreValues"
                  fieldLabel="Core values"
                  value={coreValuesText ?? ""}
                  multiline
                >
                  <MissionExpandableText
                    text={coreValuesText ?? ""}
                    fallback="Core values have not been added yet."
                  />
                </AdminContentEditable>
              </article>
            </div>
          </section>
        </div>
      </div>
    )
  }

  <div class="category-range-section">
    <div class="home-container">
      <section aria-labelledby="home-category-range">
        <div class="category-range__header">
          {
            contentEditing && productCategoryRange ? (
              <AdminContentEditable
                contentEditing={contentEditing}
                section={productCategoryRange}
                fieldKey="heading"
                fieldLabel="Product range heading"
                value={productCategoryContent.heading}
              >
                <h2 id="home-category-range" class="category-range__title">
                  {productCategoryContent.heading}
                </h2>
              </AdminContentEditable>
            ) : (
              <h2 id="home-category-range" class="category-range__title">
                {productCategoryContent.heading}
              </h2>
            )
          }
          {
            contentEditing && productCategoryRange ? (
              <AdminContentEditable
                contentEditing={contentEditing}
                section={productCategoryRange}
                fieldKey="subtitle"
                fieldLabel="Product range subtitle"
                value={productCategoryContent.subtitle}
                multiline
              >
                <p class="category-range__subtitle">
                  {productCategoryContent.subtitle}
                </p>
              </AdminContentEditable>
            ) : (
              <p class="category-range__subtitle">
                {productCategoryContent.subtitle}
              </p>
            )
          }
        </div>

        <div class="category-range__grid">
          {
            productCategoryContent.categories.map((category, categoryIndex) => {
              const categoryImage = getProductCategoryImage(category);

              return (
                <article
                  class={`category-range-card category-range-card--${category.key}`}
                >
                  <div class="category-range-card__image-container">
                    {
                      contentEditing && productCategoryRange ? (
                        <AdminContentEditableImage
                          contentEditing={contentEditing}
                          section={productCategoryRange}
                          imageSrc={categoryImage.imageSrc}
                          imageAlt={categoryImage.imageAlt}
                          displaySrc={categoryImage.displaySrc}
                          imageClass="category-range-card__image"
                          popoverTitle={`Replace ${category.title} image`}
                          categoryIndex={categoryIndex}
                        />
                      ) : (
                        <img
                          src={categoryImage.displaySrc}
                          alt={categoryImage.imageAlt}
                          class="category-range-card__image"
                          loading="lazy"
                        />
                      )
                    }
                  </div>
                  <div class="category-range-card__body">
                    {
                      contentEditing && productCategoryRange ? (
                        <AdminContentEditable
                          contentEditing={contentEditing}
                          section={productCategoryRange}
                          fieldKey="tag"
                          fieldLabel={`${category.title} tag`}
                          value={category.tag}
                          categoryIndex={categoryIndex}
                        >
                          <span class="category-range-card__tag">{category.tag}</span>
                        </AdminContentEditable>
                      ) : (
                        <span class="category-range-card__tag">{category.tag}</span>
                      )
                    }
                    {
                      contentEditing && productCategoryRange ? (
                        <AdminContentEditable
                          contentEditing={contentEditing}
                          section={productCategoryRange}
                          fieldKey="title"
                          fieldLabel={`${category.title} title`}
                          value={category.title}
                          categoryIndex={categoryIndex}
                        >
                          <h3 class="category-range-card__title">{category.title}</h3>
                        </AdminContentEditable>
                      ) : (
                        <h3 class="category-range-card__title">{category.title}</h3>
                      )
                    }
                    {
                      contentEditing && productCategoryRange ? (
                        <AdminContentEditable
                          contentEditing={contentEditing}
                          section={productCategoryRange}
                          fieldKey="description"
                          fieldLabel={`${category.title} description`}
                          value={category.description}
                          multiline
                          categoryIndex={categoryIndex}
                        >
                          <p class="category-range-card__desc">{category.description}</p>
                        </AdminContentEditable>
                      ) : (
                        <p class="category-range-card__desc">{category.description}</p>
                      )
                    }
                    <a
                      href={linkHref(`/shop?category=${category.shopCategory}`)}
                      class="public-pill-button public-pill-button--brand"
                    >
                      Show more
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>

  <div class="best-sellers-section">
    <div class="home-container">
      <section aria-labelledby="home-best-sellers">
        <div class="best-sellers__header">
          <h2 id="home-best-sellers" class="best-sellers__title">
            Best Sellers
          </h2>
          <p class="best-sellers__description">
            Finding good meat shouldn't be a challenge. That's why JEHMARP makes
            it simple and reliable. Our products are selected with care from
            trusted local suppliers who share our commitment to quality. Each
            item you see has been chosen for its freshness, taste, and
            consistency so you get great results whether you're grilling,
            roasting, stewing, or frying. We take great pride in offering fresh,
            top-grade meat cuts that customers can trust daily.
          </p>
        </div>

        <div class="best-sellers__grid">
          {
            bestSellersList.map((product) => (
              <article class="best-seller-card">
                <div class="best-seller-card__image-container">
                  {product.badge && (
                    <span class="best-seller-card__badge">{product.badge}</span>
                  )}
                  <img
                    src={product.image}
                    alt={product.name}
                    class="best-seller-card__image"
                    loading="lazy"
                  />
                </div>
                <div class="best-seller-card__content">
                  <span class="best-seller-card__price">{product.price}</span>
                  <h3 class="best-seller-card__name">{product.name}</h3>
                  <p class="best-seller-card__desc">{product.description}</p>
                  <div class="best-seller-card__footer">
                    <span class="best-seller-card__dot">○</span>
                    <span>{product.availability}</span>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <div class="best-sellers__action">
          <a href={linkHref("/shop")} class="best-sellers__button">
            View all products
          </a>
        </div>
      </section>
    </div>
  </div>

  {
    taglines && (
      <div class="tagline-section">
        <div class="home-container">
          <div class="tagline-container">
            {
              contentEditing ? (
                <AdminTaglinesEditor
                  contentEditing={contentEditing}
                  section={taglines}
                  items={taglineItems}
                />
              ) : (
                <TaglineDisplayStack items={taglineItems} />
              )
            }
            <a href={linkHref("/our-story")} class="tagline-button">
              Our Story
            </a>
          </div>
        </div>
      </div>
    )
  }

  {
    shopInfoSource && (
      <>
        <div class="featured-products-section">
          <div class="home-container">
            <section aria-labelledby="home-featured-products">
              <div class="featured-products__header">
                <div>
                  <h2
                    id="home-featured-products"
                    class="featured-products__title"
                  >
                    Featured Products
                  </h2>
                  <p class="featured-products__description">
                    Handpicked fresh cuts, prepared daily by our expert butchers
                    for top taste and quality.
                  </p>
                </div>
                <a
                  href={linkHref("/shop")}
                  class="featured-products__header-link"
                >
                  Explore All Products →
                </a>
              </div>

              <div class="featured-products__grid">
                {featuredProductsList.map((product) => (
                  <article class="featured-product-card">
                    <div class="featured-product-card__image-container">
                      {product.category_name && (
                        <span class="featured-product-card__badge">
                          {product.category_name}
                        </span>
                      )}
                      <img
                        src={product.image}
                        alt={product.name}
                        class="featured-product-card__image"
                        loading="lazy"
                      />
                    </div>
                    <div class="featured-product-card__content">
                      <span class="featured-product-card__price">
                        {product.price}
                      </span>
                      <h3 class="featured-product-card__name">
                        {product.name}
                      </h3>
                      <p class="featured-product-card__desc">
                        {product.description}
                      </p>
                      <div class="featured-product-card__footer">
                        <a
                          href={linkHref(`/shop`)}
                          class="featured-product-card__button"
                        >
                          Order Now
