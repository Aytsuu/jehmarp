---
import { authRoutes, publicRoutes } from "@/config/navigation";
import {
  toAdminContentPreviewHref,
  toPublicPathFromAdminPreview,
} from "@/lib/public-website/admin-content-preview";
import { loadPlatformSettings } from "@/lib/platform-settings";
import { createSupabaseAdminClient } from "@/lib/supabase/admin";
import { resolveBrandLogoUrl } from "@/lib/platform-settings/default-logo";

type Props = {
  activePath?: string;
  disableSmartScroll?: boolean;
  previewRoot?: string;
};

const { activePath, disableSmartScroll = false, previewRoot } = Astro.props;
const pathname =
  activePath ??
  (previewRoot
    ? toPublicPathFromAdminPreview(Astro.url.pathname)
    : Astro.url.pathname);
const disableGuestActions = Boolean(previewRoot);

function linkHref(href: string) {
  return previewRoot ? toAdminContentPreviewHref(href) : href;
}

function isDisabledGuestAction(href: string) {
  return disableGuestActions && href === "/login";
}

const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }
  return pathname.startsWith(href);
};

const navItems = [
  ...publicRoutes.map((item) => ({ ...item, variant: "link" as const })),
  ...authRoutes.map((item) => ({
    ...item,
    variant: item.href === "/login" ? ("button" as const) : ("link" as const),
  })),
];

const platformSettings = await loadPlatformSettings(createSupabaseAdminClient());
const brandText = platformSettings.businessProfile.tradeName || "JEHMARP";
const logoUrl = resolveBrandLogoUrl(platformSettings.businessProfile.logoPath);
---

<header class="site-nav" data-site-nav-smart-scroll={disableSmartScroll ? undefined : ""}>
  <div class="site-nav__surface">
  <div class="site-nav__announcement">
    <div class="site-nav__announcement-inner">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="site-nav__announcement-icon"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
      <span><strong>FREE DELIVERY</strong> | Within Compostela & Consolacion Public Market (Minimum purchase may apply)</span>
    </div>
  </div>
  <nav class="site-nav__inner" aria-label="Primary navigation">
    <a class="site-nav__brand" href={linkHref("/")}>
      <img src={logoUrl} alt="" class="site-nav__brand-logo" />
      <span class="site-nav__brand-text">{brandText}</span>
    </a>
    <button
      type="button"
      class="site-nav__menu-toggle lg:hidden"
      data-site-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav-mobile-menu"
      aria-label="Open navigation menu"
    >
      <span class="site-nav__menu-toggle-bar" aria-hidden="true"></span>
      <span class="site-nav__menu-toggle-bar" aria-hidden="true"></span>
      <span class="site-nav__menu-toggle-bar" aria-hidden="true"></span>
    </button>
    <ul class="site-nav__list site-nav__list--desktop">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          const linkClass =
            item.variant === "button"
              ? `site-nav__link--button ${active ? "site-nav__link--active" : ""}`
              : active
                ? "site-nav__link--active"
                : "";

          return (
            <li>
              {isDisabledGuestAction(item.href) ? (
                <span
                  class={`${linkClass} site-nav__link--disabled`.trim()}
                  aria-disabled="true"
                  title="Login is unavailable in content preview"
                >
                  {item.label}
                </span>
              ) : (
                <a href={linkHref(item.href)} class={linkClass}>
                  {item.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
  </div>
</header>

<div
  id="site-nav-mobile-menu"
  class="site-nav__mobile-menu"
  hidden
  aria-hidden="true"
>
  <div
    class="site-nav__mobile-menu-backdrop"
    data-site-nav-backdrop
    aria-hidden="true"
  ></div>
  <nav class="site-nav__mobile-menu-panel" aria-label="Mobile navigation">
    <ul class="site-nav__mobile-list">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              {isDisabledGuestAction(item.href) ? (
                <span
                  class:list={[
                    "site-nav__mobile-link",
                    active && "site-nav__mobile-link--active",
                    item.variant === "button" && "site-nav__mobile-link--button",
                    "site-nav__link--disabled",
                  ]}
                  aria-disabled="true"
                  title="Login is unavailable in content preview"
                >
                  {item.label}
                </span>
              ) : (
                <a
                  href={linkHref(item.href)}
                  class:list={[
                    "site-nav__mobile-link",
                    active && "site-nav__mobile-link--active",
                    item.variant === "button" && "site-nav__mobile-link--button",
                  ]}
                >
                  {item.label}
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
</div>

<script>
  import { initSiteNavMobileMenu } from "@/lib/client/site-nav-mobile-menu";
  import { initSiteNavSmartScroll } from "@/lib/client/site-nav-smart-scroll";

  function initSiteNav() {
    initSiteNavMobileMenu();
    initSiteNavSmartScroll();
  }

  document.addEventListener("DOMContentLoaded", initSiteNav);
  document.addEventListener("astro:after-swap", initSiteNav);

  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initSiteNav();
  }
</script>
