---
import ActionMenuGlyph, { type ActionMenuGlyph as ActionMenuGlyphName } from "@/components/ActionMenuGlyph.astro";

export type ActionMenuIcon = "external-pdf" | "details";

export type ActionMenuItem = {
  label: string;
  href?: string;
  target?: string;
  rel?: string;
  icon?: ActionMenuIcon;
  dataAction?: string;
  disabled?: boolean;
  openAlertDialog?: string;
  alertDialogForm?: string;
};

export type ActionMenuTriggerIcon = ActionMenuGlyphName;

type Props = {
  menuLabel: string;
  items: ActionMenuItem[];
  triggerLabel?: string;
  triggerIcon?: ActionMenuTriggerIcon;
  triggerClass?: string;
  menuClass?: string;
  disabled?: boolean;
  id?: string;
};

const {
  menuLabel,
  items,
  triggerLabel,
  triggerIcon = "vertical",
  triggerClass = "",
  menuClass = "",
  disabled = false,
  id,
} = Astro.props;

const isLabelTrigger = Boolean(triggerLabel);
const triggerClasses = [
  "table-action-menu__trigger",
  isLabelTrigger && "table-action-menu__trigger--button",
  !isLabelTrigger && "table-action-menu__trigger--icon",
  triggerClass,
]
  .filter(Boolean)
  .join(" ");

const rootClasses = ["table-action-menu", menuClass].filter(Boolean).join(" ");
---

<div class={rootClasses} data-table-action-menu id={id}>
  <button
    type="button"
    class={triggerClasses}
    aria-label={menuLabel}
    aria-haspopup="menu"
    aria-expanded="false"
    data-table-action-menu-trigger
    disabled={disabled || undefined}
  >
    {
      isLabelTrigger ? (
        <span>{triggerLabel}</span>
      ) : (
        <ActionMenuGlyph glyph={triggerIcon} />
      )
    }
  </button>
  <div
    class="table-action-menu__content"
    role="menu"
    aria-label={menuLabel}
    hidden
    data-table-action-menu-content
  >
    {
      items.map((item) => {
        const icon = item.icon ?? "none";

        if (item.href) {
          return (
            <a
              href={item.href}
              class="table-action-menu__item"
              target={item.target}
              rel={item.rel}
              role="menuitem"
              aria-disabled={item.disabled ? "true" : undefined}
              tabindex={item.disabled ? -1 : undefined}
              data-astro-prefetch={
                item.target === "_blank" || item.href?.endsWith(".pdf")
                  ? undefined
                  : "false"
              }
            >
              {icon === "external-pdf" && <ActionMenuGlyph glyph="external-pdf" />}
              {icon === "details" && <ActionMenuGlyph glyph="details" />}
              <span>{item.label}</span>
            </a>
          );
        }

        return (
          <button
            type="button"
            class="table-action-menu__item"
            role="menuitem"
            data-action-menu-item
            data-action={item.dataAction}
            data-open-alert-dialog={item.openAlertDialog}
            data-alert-dialog-form={item.alertDialogForm}
            disabled={item.disabled || undefined}
          >
            {icon === "external-pdf" && <ActionMenuGlyph glyph="external-pdf" />}
            {icon === "details" && <ActionMenuGlyph glyph="details" />}
            <span>{item.label}</span>
          </button>
        );
      })
    }
  </div>
</div>
