---
import ActionMenu from "@/components/ActionMenu.astro";
import ActionMenuGlyph from "@/components/ActionMenuGlyph.astro";

type Props = {
  menuLabel: string;
  pdfHref?: string;
  detailsHref?: string;
  detailsLabel?: string;
  mobileModalId?: string;
};

const {
  menuLabel,
  pdfHref,
  detailsHref,
  detailsLabel = "Order Details",
  mobileModalId,
} = Astro.props;

const items = [
  pdfHref
    ? {
        label: "Open PDF",
        href: pdfHref,
        target: "_blank",
        rel: "noreferrer",
        icon: "external-pdf" as const,
      }
    : null,
  detailsHref
    ? {
        label: detailsLabel,
        href: detailsHref,
        icon: "details" as const,
      }
    : null,
].filter((item): item is NonNullable<typeof item> => item !== null);

const hasActions = items.length > 0;
---

{
  mobileModalId ? (
    <div class="table-action-menu-responsive">
      <div class="table-action-menu-responsive__desktop">
        <ActionMenu menuLabel={menuLabel} items={items} />
      </div>
      <button
        type="button"
        class="table-action-menu__trigger table-action-menu__trigger--icon table-action-menu-responsive__mobile"
        aria-label={menuLabel}
        data-table-row-action-trigger
        data-open-dashboard-modal={mobileModalId}
        data-row-action-pdf-href={pdfHref}
        data-row-action-details-href={detailsHref}
        data-row-action-details-label={detailsLabel}
        data-row-action-menu-label={menuLabel}
        aria-controls={mobileModalId}
        disabled={!hasActions || undefined}
      >
        <ActionMenuGlyph glyph="vertical" />
      </button>
    </div>
  ) : (
    <ActionMenu menuLabel={menuLabel} items={items} />
  )
}
