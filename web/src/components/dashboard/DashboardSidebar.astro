---
import Tooltip from "@/components/ui/Tooltip.astro";
import {
  getDashboardSidebarCategories,
  formatSidebarUnreadCount,
  type DashboardSidebarUnreadBadge,
} from "@/lib/dashboard/sidebar-navigation";
import {
  getDashboardRouteStatuses,
  getPageStatusLabel,
} from "@/lib/page-availability";
import { loadPlatformSettings } from "@/lib/platform-settings";
import { createSupabaseAdminClient } from "@/lib/supabase/admin";
import { resolvePublicStorageUrl } from "@/lib/supabase/storage";

type Props = {
  navLabel: string;
  sidebarUnreadBadges?: Record<string, DashboardSidebarUnreadBadge>;
};

const { navLabel, sidebarUnreadBadges = {} } = Astro.props;
const isAdmin = Astro.url.pathname.startsWith("/admin");
const categories = getDashboardSidebarCategories(isAdmin);
const routeStatuses = getDashboardRouteStatuses();
const platformSettings = await loadPlatformSettings(createSupabaseAdminClient());
const brandText = platformSettings.businessProfile.tradeName || "JEHMARP";
const logoUrl = resolvePublicStorageUrl(platformSettings.businessProfile.logoPath);
---

<div
  class="dashboard-sidebar-shell"
  id="dashboard-sidebar-mobile-panel"
  transition:persist="dashboard-sidebar-shell"
>
  <aside class="dashboard-sidebar" aria-labelledby="dashboard-sidebar-title">
    <div class="dashboard-sidebar__header">
      <a class="dashboard-sidebar__brand" href="/">
        {logoUrl ? (
          <img src={logoUrl} alt="" class="site-nav__brand-logo" />
        ) : (
          <span class="site-nav__brand-mark" aria-hidden="true">Logo</span>
        )}
        <span class="dashboard-sidebar__brand-text">{brandText}</span>
      </a>
      {
        isAdmin && (
          <button
            type="button"
            class="dashboard-sidebar__mobile-close"
            data-admin-sidebar-mobile-close
            aria-label="Close menu"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        )
      }
    </div>
    <div class="dashboard-sidebar__scroll">
      <nav class="dashboard-sidebar__nav" aria-label={navLabel}>
        <div class="dashboard-sidebar__categories">
          {
            categories.map((group, groupIndex) => (
              <div
                class:list={[
                  "sidebar-category-group",
                  groupIndex > 0 && "sidebar-category-group--separated",
                ]}
              >
                <span class="sidebar-category-title">{group.title}</span>
                <ul>
                  {group.items.map((item) => {
                    const isCurrent =
                      Astro.url.pathname === item.href ||
                      (item.href !== "/admin" &&
                        item.href !== "/agent" &&
                        Astro.url.pathname.startsWith(item.href));
                    const unreadBadge = sidebarUnreadBadges[item.href];
                    const unreadCount = unreadBadge
                      ? ("count" in unreadBadge ? unreadBadge.count : unreadBadge.ids.length)
                      : 0;
                    const routeStatus = routeStatuses[item.href];
                    const showRouteStatus = routeStatus && routeStatus.status !== "ready";
                    const routeStatusLabel = routeStatus
                      ? getPageStatusLabel(routeStatus.status)
                      : "";
                    const routeStatusIcon =
                      routeStatus?.status === "maintenance"
                        ? `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.66 5.66l-6.36 6.36a2 2 0 0 0 2.83 2.83l6.36-6.36a4 4 0 0 0 5.66-5.66l-2.12 2.12-2.83-2.83 2.12-2.12z"></path></svg>`
                        : `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>`;

                    return (
                      <li>
                        {item.isAction ? (
                          <div class="dashboard-sidebar__logout-form">
                            <Tooltip
                              text={item.label}
                              placement="right"
                              sidebarOnly={true}
                              focusable={false}
                              class="dashboard-sidebar__nav-tooltip"
                            >
                              <button
                                type="button"
                                data-open-alert-dialog="dashboard-logout-dialog"
                                data-alert-dialog-form="dashboard-logout-form"
                              >
                                <span class="dashboard-sidebar__nav-link-content">
                                  <span class="nav-icon-wrapper" set:html={item.icon} />
                                  <span class="dashboard-sidebar__nav-label">{item.label}</span>
                                </span>
                              </button>
                            </Tooltip>
                          </div>
                        ) : (
                          <Tooltip
                            text={item.label}
                            placement="right"
                            sidebarOnly={true}
                            focusable={false}
                            class="dashboard-sidebar__nav-tooltip"
                          >
                            <a
                              href={item.href}
                              class={isCurrent ? "active" : ""}
                              data-dashboard-nav-link
                              data-astro-prefetch="hover"
                              aria-current={isCurrent ? "page" : undefined}
                            >
                              <span class="dashboard-sidebar__nav-link-content">
                                <span class="nav-icon-wrapper" set:html={item.icon} />
                                <span class="dashboard-sidebar__nav-label">{item.label}</span>
                              </span>
                              {
                                showRouteStatus && (
                                  <span
                                    class={`dashboard-sidebar__status dashboard-sidebar__status--${routeStatus.status}`}
                                    aria-label={`${item.label} status: ${routeStatusLabel}`}
                                    title={`${item.label}: ${routeStatusLabel}`}
                                    set:html={routeStatusIcon}
                                  />
                                )
                              }
                              {
                                unreadBadge && unreadCount > 0 && (
                                    <span
                                      class="dashboard-sidebar__nav-badge"
                                      data-sidebar-unread-badge={
                                        "count" in unreadBadge ? undefined : true
                                      }
                                      data-storage-key={
                                        "count" in unreadBadge ? undefined : unreadBadge.storageKey
                                      }
                                      data-unread-ids={
                                        "count" in unreadBadge
                                          ? undefined
                                          : JSON.stringify(unreadBadge.ids)
                                      }
                                      data-unread-count={unreadCount}
                                      aria-label={`${item.label} unread count: ${unreadCount}`}
                                    >
                                      {formatSidebarUnreadCount(unreadCount)}
                                    </span>
                                  )
                              }
                            </a>
                          </Tooltip>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </nav>
    </div>
  </aside>
  <div class="dashboard-sidebar__toggle-anchor">
    <Tooltip
      text="Collapse sidebar"
      placement="right"
      focusable={false}
      class="dashboard-sidebar__toggle-tooltip-trigger"
    >
      <button
        type="button"
        class="dashboard-sidebar__toggle"
        data-dashboard-sidebar-toggle
        aria-expanded="true"
        aria-label="Collapse sidebar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
    </Tooltip>
  </div>
</div>
