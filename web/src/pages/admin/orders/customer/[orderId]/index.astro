---
import StatusBadge from "@/components/dashboard/StatusBadge.astro";
import RouteBackButton from "@/components/dashboard/RouteBackButton.astro";
import OrderDetailNav from "@/components/dashboard/OrderDetailNav.astro";
import AdminPageFrame from "@/components/admin/AdminPageFrame.astro";
import Tab from "@/components/ui/Tab.astro";
import TabPanel from "@/components/ui/TabPanel.astro";
import Tabs from "@/components/ui/Tabs.astro";
import PdfLabeledField from "@/components/ui/PdfLabeledField.astro";
import AlertDialog from "@/components/ui/AlertDialog.astro";
import {
  formatAdminActionFeedback,
  markAdminOrderReadIfUnread,
} from "@/lib/admin-dashboard/actions";
import {
  loadAdminDashboardData,
  loadAdminAgentOrder,
  loadAdminOrder,
} from "@/lib/admin-dashboard/data";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import {
  canConvertPromotedCustomerOrderToDistribution,
  customerOrderDistributionConversionBlockMessage,
  defaultProductCommissionAmount,
  formatCurrency,
  formatDate,
  formatDateTime,
  fullName,
  getCustomerOrderDistributionConversionBlockReason,
  orderCommissionTotal,
  orderDistributionConversionAgentId,
  orderPaymentTotal,
  orderReceivableTotal,
  shouldShowCustomerOrderDistributionConversionCard,
} from "@/lib/admin-dashboard/view";
import {
  buildOrderSlipLayout,
  buildSalesInvoiceLayout,
  getDocumentColumnTemplate,
} from "@/lib/order-documents/layout";
import { loadDocumentLayoutOptions } from "@/lib/platform-settings/document-layout";
import { autoCapitalize, formatOrderSource } from "@/lib/formatters";
import { manilaDateInputValue, manilaTimeInputValue } from "@/lib/datetime";
import {
  getOrderStatusBadgeLabel,
  isAdminOrderDetailNavOrder,
} from "@/lib/order-status-display";
import {
  buildOrderDetailNavEntries,
  formatOrderCode,
} from "@/lib/order-detail-nav";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

const { orderId } = Astro.params;

if (!orderId) {
  return Astro.redirect("/admin/orders", 302);
}

const orderDetailTabIds = [
  "products",
  "order-slip",
  "sales-invoice",
  "payment-record",
  "timeline",
  "notes",
] as const;
const requestedOrderDetailTab = Astro.url.searchParams.get("tab");

const [dashboardData, order, documentLayout] = await Promise.all([
  loadAdminDashboardData(),
  loadAdminOrder(orderId),
  loadDocumentLayoutOptions(),
]);

if (!order) {
  return Astro.redirect("/admin/orders", 302);
}

type CustomerOrderItem = NonNullable<
  typeof order
>["customer_order_item"][number];

await markAdminOrderReadIfUnread(Astro, orderId, adminRoute.userId);

const rawFeedback = formatAdminActionFeedback(Astro.url);
const hiddenInlineValidationErrors = new Set([
  "Quantity must be greater than zero.",
  "Order product quantities cannot be reduced below the recorded payment total.",
]);
const feedback =
  rawFeedback.status === "Order marked as read." ||
  rawFeedback.status === "Commission updated." ||
  rawFeedback.status === "Order notes saved." ||
  rawFeedback.status === "Order status updated." ||
  (rawFeedback.error && hiddenInlineValidationErrors.has(rawFeedback.error))
    ? {
        ...rawFeedback,
        status:
          rawFeedback.status === "Order marked as read." ||
          rawFeedback.status === "Commission updated." ||
          rawFeedback.status === "Order notes saved." ||
          rawFeedback.status === "Order status updated."
            ? undefined
            : rawFeedback.status,
        error:
          rawFeedback.error &&
          hiddenInlineValidationErrors.has(rawFeedback.error)
            ? undefined
            : rawFeedback.error,
      }
    : rawFeedback;

const invoice = order.invoice[0] ?? null;
const hasSalesInvoice = Boolean(invoice);
const hasPayments = order.payment.length > 0;
const agentReceivedPayments = order.agent_received_payment ?? [];
const pendingAgentReceivedPayments = agentReceivedPayments.filter(
  (payment) => payment.status === "pending_admin_confirmation",
);
const pendingAgentReceivedTotal = pendingAgentReceivedPayments.reduce(
  (total, payment) => total + payment.amount,
  0,
);
const canEditOrderProducts = !hasSalesInvoice;
const canGenerateInvoice = order.order_status === "processing";
const paidTotal = orderPaymentTotal(order);
const totalCommission = orderCommissionTotal(order);
type PaymentFormCustomerType = "regular" | "wholesale" | "reseller";
const isResellerCustomer = Boolean(order.customer?.is_reseller);
const paymentCustomerType: PaymentFormCustomerType = (() => {
  if (
    isResellerCustomer ||
    order.customer_order_item.every((item) => item.price_type === "reseller")
  ) {
    return "reseller";
  }

  return "regular";
})();
const paymentOrderTotal = order.customer_order_item.reduce((total, item) => {
  return total + item.final_quantity * item.unit_price;
}, 0);
const isAgentLinkedOrder = Boolean(
  order.agent_id || order.parent_order_id || totalCommission > 0,
);
const commissionAdjustedOrderTotal = orderReceivableTotal(
  order,
  "final_quantity",
);
const paymentFormCommissionTotal = isAgentLinkedOrder ? totalCommission : 0;
const paymentFormOrderTotal = isAgentLinkedOrder
  ? commissionAdjustedOrderTotal
  : paymentOrderTotal;
const paymentFormBalance = Math.max(paymentFormOrderTotal - paidTotal, 0);
const canCreatePaymentRecord = paymentFormBalance > 0;
const receivable = isAgentLinkedOrder
  ? commissionAdjustedOrderTotal
  : paymentOrderTotal;
const showOrigOrderTotal =
  isAgentLinkedOrder && commissionAdjustedOrderTotal < paymentOrderTotal;
const balanceDue = paymentFormBalance;
const canEditInvoiceQuantities = hasSalesInvoice;
const distributionConversionAgentId = orderDistributionConversionAgentId(order);
const distributionConversionBlockReason =
  getCustomerOrderDistributionConversionBlockReason(
    order,
    distributionConversionAgentId,
  );
const distributionConversionBlockMessage =
  customerOrderDistributionConversionBlockMessage(
    distributionConversionBlockReason,
  );
const canConvertToDistributionOrder =
  canConvertPromotedCustomerOrderToDistribution(
    order,
    distributionConversionAgentId,
  );
const showDistributionConversionPrompt =
  shouldShowCustomerOrderDistributionConversionCard(
    order,
    distributionConversionAgentId,
  );
const paymentDateDefault = manilaDateInputValue();
const paymentTimeDefault = manilaTimeInputValue();
const availableOrderDetailTabs = orderDetailTabIds;
const activeOrderDetailTab =
  requestedOrderDetailTab &&
  availableOrderDetailTabs.includes(
    requestedOrderDetailTab as (typeof availableOrderDetailTabs)[number],
  )
    ? requestedOrderDetailTab
    : "products";
const isOrderDetailTabActive = (tab: string) => tab === activeOrderDetailTab;
const orderCode = formatOrderCode(order.id);
const orderSlipPdfHref = `/admin/orders/customer/${order.id}/order-slip.pdf`;
const salesInvoicePdfHref = `/admin/orders/customer/${order.id}/sales-invoice.pdf`;
const paymentRecordReturnPath = `/admin/orders/customer/${order.id}?tab=payment-record`;

function sanitizeAttachmentFileName(value: string) {
  return (
    value
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "") || "file"
  );
}

const orderSlipPdfFileName = `order-slip-${sanitizeAttachmentFileName(fullName(order.customer))}-${order.id.slice(0, 8)}.pdf`;
const salesInvoicePdfFileName = invoice
  ? `sales-invoice-${sanitizeAttachmentFileName(fullName(order.customer))}-${invoice.invoice_number}.pdf`
  : null;
const commissionProjectionTrigger = Boolean(
  order.agent_id ||
  order.parent_order_id ||
  order.customer?.promoted_to_agent_id,
);

function projectedItemCommission(item: CustomerOrderItem, quantity: number) {
  if (item.agent_commission_amount > 0) {
    return Math.max(item.agent_commission_amount, 0);
  }

  return defaultProductCommissionAmount({
    product: item.product,
    quantity,
    unitPrice: item.unit_price,
  });
}

const paymentProjectionSubtotal = order.customer_order_item.reduce(
  (total, item) => total + item.final_quantity * item.unit_price,
  0,
);
const paymentProjectionCommissionTotal = order.customer_order_item.reduce(
  (total, item) => total + projectedItemCommission(item, item.final_quantity),
  0,
);

function quantityValidationDataset(
  item: CustomerOrderItem,
  originalQuantity: number,
) {
  const currentSubtotal = item.final_quantity * item.unit_price;
  const currentCommission = projectedItemCommission(item, item.final_quantity);

  return {
    "data-order-product-quantity-form": true,
    "data-order-quantity-original": originalQuantity,
    "data-order-quantity-paid-total": paidTotal,
    "data-order-quantity-subtotal-without-item":
      paymentProjectionSubtotal - currentSubtotal,
    "data-order-quantity-commission-without-item":
      paymentProjectionCommissionTotal - currentCommission,
    "data-order-quantity-unit-price": item.unit_price,
    "data-order-quantity-agent-commission-amount": item.agent_commission_amount,
    "data-order-quantity-agent-commission-type":
      item.product?.agent_commission_type ?? "",
    "data-order-quantity-agent-commission-value":
      item.product?.agent_commission_value ?? 0,
    "data-order-quantity-commission-trigger": commissionProjectionTrigger
      ? "true"
      : "false",
  };
}
const orderSlipLayout = buildOrderSlipLayout(order, documentLayout);
const salesInvoiceLayout = buildSalesInvoiceLayout(order, documentLayout);
const orderSlipGridTemplate = getDocumentColumnTemplate(
  orderSlipLayout.columns,
);
const salesInvoiceGridTemplate = getDocumentColumnTemplate(
  salesInvoiceLayout.columns,
);
const isPendingOrder = order.order_status === "pending";
const orderStatusBadgeLabel = (status: typeof order.order_status) =>
  getOrderStatusBadgeLabel(status);

const customerDisplayName = order.customer
  ? fullName(order.customer)
  : "Unassigned customer";
const customerViewHref = order.customer?.id
  ? `/admin/customers/${order.customer.id}`
  : null;
const customerAddress = order.customer?.address ?? "No address on file";
const customerPhone = order.customer?.phone_number ?? "No contact number";
const customerEmail = order.customer?.email ?? "No email address";
const orderedByAgent =
  order.parent_order_id && !order.converted_at
    ? (order.parent_order?.agent ?? null)
    : null;
const orderedByAgentDisplayName =
  orderedByAgent?.display_name ?? "Agent details unavailable";
const orderedByAgentPhone = orderedByAgent?.contact ?? "No contact number";
const orderedByAgentEmail = orderedByAgent?.email ?? "No email address";
const orderedProductIds = new Set(
  order.customer_order_item.map((item) => item.product_id),
);
const addableProducts = dashboardData.products.filter(
  (product) => product.is_active && !orderedProductIds.has(product.id),
);
const orderProductEditLockReason = hasSalesInvoice
  ? "Order products are locked after a sales invoice has been created."
  : null;
const canAddOrderProducts = canEditOrderProducts && addableProducts.length > 0;

function customerProductUnitPrice(product: (typeof dashboardData.products)[number]) {
  return order?.customer?.is_reseller
    ? product.reseller_price
    : product.default_price;
}

const timelineItems = [
  ...order.payment.map((payment) => ({
    id: `payment-${payment.id}`,
    title: `Payment recorded via ${payment.payment_method}`,
    timestamp: payment.created_at,
    meta: `${formatCurrency(payment.amount)}${payment.reference_number ? ` • Ref ${payment.reference_number}` : ""}`,
  })),
  ...order.customer_order_status_history.map((entry) => ({
    id: `status-${entry.id}`,
    title: `Order moved to ${autoCapitalize(entry.to_status)}`,
    timestamp: entry.changed_at,
    meta:
      entry.notes ??
      (entry.from_status
        ? `From ${autoCapitalize(entry.from_status)}`
        : "Status update"),
  })),
  ...(invoice
    ? [
        {
          id: `invoice-${invoice.id}`,
          title: "Invoice created",
          timestamp: invoice.created_at,
          meta: invoice.invoice_number,
        },
      ]
    : []),
  {
    id: `created-${order.id}`,
    title: "Order created",
    timestamp: order.created_at,
    meta: formatOrderSource(order.source),
  },
].sort((left, right) => {
  return (
    new Date(right.timestamp).getTime() - new Date(left.timestamp).getTime()
  );
});

const returnToParam = Astro.url.searchParams.get("returnTo");
const backHref =
  returnToParam?.startsWith("/admin/") && !returnToParam.startsWith("//")
    ? returnToParam
    : "/admin/orders";
const backLabel = backHref.startsWith("/admin/customers/")
  ? "Back to customer record"
  : backHref.startsWith("/admin/orders/agent/")
    ? "Back to distribution order"
    : "Back to orders";
const parentAgentOrder =
  order.parent_order_id && !order.converted_at
    ? await loadAdminAgentOrder(order.parent_order_id)
    : null;
const orderNavigationSource = parentAgentOrder
  ? parentAgentOrder.customer_order.filter(isAdminOrderDetailNavOrder)
  : order.parent_order_id
    ? dashboardData.orders.filter(
        (entry) =>
          entry.parent_order_id === order.parent_order_id &&
          isAdminOrderDetailNavOrder(entry),
      )
    : dashboardData.orders.filter(isAdminOrderDetailNavOrder);
const orderNavigationEntries = buildOrderDetailNavEntries({
  orders: orderNavigationSource,
  currentOrderId: order.id,
  buildHref: (entry) =>
    `/admin/orders/customer/${entry.id}?returnTo=${encodeURIComponent(backHref)}`,
});
---

<AdminPageFrame
  title={`${orderCode} - JEHMARP`}
  description="Admin order details with order slip, sales invoice, commissions, payment records, and notes."
  heading="Order Details"
  intro={`Review ${orderCode} and manage invoice, commission, payment, and notes.`}
  feedback={feedback}
  dashboardData={dashboardData}
>
  <div
    class="order-detail-page"
    data-order-detail-page
    data-dashboard-record-page
  >
    <aside class="order-detail-sidebar">
      <div class="order-sidebar-header">
        <p class="order-detail-eyebrow">Orders / Order Details</p>

        <div class="order-summary-top">
          <div class="order-summary-top__main">
            <RouteBackButton href={backHref} label={backLabel} />

            <div class="order-title-copy">
              <OrderDetailNav
                currentCode={orderCode}
                entries={orderNavigationEntries}
                menuLabel={parentAgentOrder
                  ? "Other customer orders in this distribution order"
                  : "Other orders"}
              />
              <p>{formatOrderSource(order.source)}</p>
            </div>
          </div>

          <div class="order-summary-top__status">
            <StatusBadge
              kind="order"
              status={order.order_status}
              label={orderStatusBadgeLabel(order.order_status)}
            />
          </div>
        </div>

        <section
          class="order-information"
          aria-labelledby="order-information-title"
        >
          <dl class="order-information__list">
            <div class="order-information__item">
              <dt>Date</dt>
              <dd>{formatDateTime(order.created_at)}</dd>
            </div>
            <div class="order-information__item">
              <dt>Release</dt>
              <dd>{formatDateTime(order.release_date ?? null)}</dd>
            </div>
            <div class="order-information__item">
              <dt>Payment status</dt>
              <dd>
                <StatusBadge
                  kind="payment"
                  status={order.payment_status}
                  label={autoCapitalize(order.payment_status)}
                />
              </dd>
            </div>
            <div class="order-information__item">
              <dt>Paid</dt>
              <dd>{formatCurrency(paidTotal)}</dd>
            </div>
            {
              isAgentLinkedOrder && (
                <div class="order-information__item">
                  <dt>Commission</dt>
                  <dd>
                    <form
                      method="post"
                      class="order-commission-form"
                      data-astro-reload
                    >
                      <input
                        type="hidden"
                        name="action"
                        value="update-order-total-commission"
                      />
                      <input type="hidden" name="orderId" value={order.id} />
                      <input
                        type="number"
                        name="amount"
                        min="0"
                        step="0.01"
                        value={totalCommission.toFixed(2)}
                        aria-label="Total commission"
                      />
                      <button type="submit">Save</button>
                    </form>
                  </dd>
                </div>
              )
            }
            <div class="order-information__item">
              <dt>Receivable</dt>
              <dd class="order-information__amount">
                <span>{formatCurrency(receivable)}</span>
                {
                  showOrigOrderTotal && (
                    <span class="order-information__orig-amount">
                      Orig. {formatCurrency(paymentOrderTotal)}
                    </span>
                  )
                }
              </dd>
            </div>
            <div
              class="order-information__item order-information__item--balance-due"
            >
              <dt>Balance due</dt>
              <dd>{formatCurrency(balanceDue)}</dd>
            </div>
          </dl>
        </section>

        {
          showDistributionConversionPrompt && (
            <section
              class="order-conversion-card"
              aria-labelledby="order-conversion-title"
            >
              <h2 id="order-conversion-title">
                Do you want to convert this into an agent distribution order?
              </h2>
              <p>
                The products will move into a new agent order with pending
                customers status, ready for distribution to the agent's
                customers.
              </p>
              {canConvertToDistributionOrder ? (
                <form
                  id="convert-customer-order-distribution-form"
                  method="post"
                  data-astro-reload
                >
                  <input
                    type="hidden"
                    name="action"
                    value="convert-customer-order-to-agent-distribution"
                  />
                  <input type="hidden" name="orderId" value={order.id} />
                  <input type="hidden" name="returnTo" value={backHref} />
                  <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">
                    Submit conversion
                  </button>
                  <button
                    type="button"
                    data-open-alert-dialog="convert-customer-order-distribution-dialog"
                    data-alert-dialog-form="convert-customer-order-distribution-form"
                  >
                    Proceed Conversion
                  </button>
                </form>
              ) : (
                <div class="order-conversion-card__blocked">
                  <p>{distributionConversionBlockMessage}</p>
                  <button type="button" disabled>
                    Proceed Conversion
                  </button>
                </div>
              )}
            </section>
          )
        }

        {
          isPendingOrder && (
            <form method="post" class="order-accept-form" data-astro-reload>
              <input type="hidden" name="action" value="update-order-status" />
              <input type="hidden" name="orderId" value={order.id} />
              <input type="hidden" name="orderStatus" value="processing" />
              <button type="submit" class="order-accept-form__button">
                Accept order
              </button>
            </form>
          )
        }

        <div class="order-party-cards">
          <article class="order-party-card order-party-card--customer">
            <div class="order-party-card__identity">
              <div class="order-party-card__identity-copy">
                <span class="order-party-card__eyebrow">Customer</span>
                <p class="order-party-card__name">{customerDisplayName}</p>
              </div>
              {
                customerViewHref ? (
                  <a
                    href={customerViewHref}
                    class="order-party-card__view-details-link"
                  >
                    View details
                  </a>
                ) : null
              }
            </div>

            <ul class="order-party-card__meta-list">
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.address },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M12 21s-7-4.35-7-10a7 7 0 1 1 14 0c0 5.65-7 10-7 10Z"
                    ></path>
                    <circle cx="12" cy="11" r="2.5"></circle>
                  </svg>
                </span>
                <span class="order-party-card__meta-text"
                  >{customerAddress}</span
                >
              </li>
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.phone_number },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.11a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92Z"
                    ></path>
                  </svg>
                </span>
                {
                  order.customer?.phone_number ? (
                    <a
                      class="order-party-card__meta-link"
                      href={`tel:${order.customer.phone_number}`}
                    >
                      {customerPhone}
                    </a>
                  ) : (
                    <span class="order-party-card__meta-text">
                      {customerPhone}
                    </span>
                  )
                }
              </li>
              <li
                class:list={[
                  "order-party-card__meta-item",
                  { "is-placeholder": !order.customer?.email },
                ]}
              >
                <span class="order-party-card__meta-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path
                      d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                    ></path>
                    <path d="m22 6-10 7L2 6"></path>
                  </svg>
                </span>
                {
                  order.customer?.email ? (
                    <a
                      class="order-party-card__meta-link"
                      href={`mailto:${order.customer.email}`}
                    >
                      {customerEmail}
                    </a>
                  ) : (
                    <span class="order-party-card__meta-text">
                      {customerEmail}
                    </span>
                  )
                }
              </li>
            </ul>
          </article>

          {
            order.parent_order_id && !order.converted_at && (
              <article class="order-party-card order-party-card--agent">
                <div class="order-party-card__identity">
                  <div class="order-party-card__identity-copy">
                    <span class="order-party-card__eyebrow">Ordered by</span>
                    <p class="order-party-card__name">
                      {orderedByAgentDisplayName}
                    </p>
                  </div>
                </div>

                <ul class="order-party-card__meta-list">
                  <li
                    class:list={[
                      "order-party-card__meta-item",
                      { "is-placeholder": !orderedByAgent?.contact },
                    ]}
                  >
                    <span
                      class="order-party-card__meta-icon"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.86.3 1.7.54 2.5a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.58-1.11a2 2 0 0 1 2.11-.45c.8.24 1.64.42 2.5.54A2 2 0 0 1 22 16.92Z" />
                      </svg>
                    </span>
                    {orderedByAgent?.contact ? (
                      <a
                        class="order-party-card__meta-link"
                        href={`tel:${orderedByAgent.contact}`}
                      >
                        {orderedByAgentPhone}
                      </a>
                    ) : (
                      <span class="order-party-card__meta-text">
                        {orderedByAgentPhone}
                      </span>
                    )}
                  </li>
                  <li
                    class:list={[
                      "order-party-card__meta-item",
                      { "is-placeholder": !orderedByAgent?.email },
                    ]}
                  >
                    <span
                      class="order-party-card__meta-icon"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 24 24">
                        <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                        <path d="m22 6-10 7L2 6" />
                      </svg>
                    </span>
                    {orderedByAgent?.email ? (
                      <a
                        class="order-party-card__meta-link"
                        href={`mailto:${orderedByAgent.email}`}
                      >
                        {orderedByAgentEmail}
                      </a>
                    ) : (
                      <span class="order-party-card__meta-text">
                        {orderedByAgentEmail}
                      </span>
                    )}
                  </li>
                </ul>
              </article>
            )
          }
        </div>

        <section
          class="order-attachments"
          aria-labelledby="order-attachments-title"
        >
          <h2 id="order-attachments-title" class="order-attachments__title">
            Attachments
          </h2>
          <ul class="order-attachments__list">
            <li class="order-attachments__item">
              <a
                href={orderSlipPdfHref}
                class="order-attachments__link"
                target="_blank"
                rel="noreferrer"
              >
                {orderSlipPdfFileName}
              </a>
            </li>
            {
              salesInvoicePdfFileName ? (
                <li class="order-attachments__item">
                  <a
                    href={salesInvoicePdfHref}
                    class="order-attachments__link"
                    target="_blank"
                    rel="noreferrer"
                  >
                    {salesInvoicePdfFileName}
                  </a>
                </li>
              ) : null
            }
          </ul>
        </section>
      </div>
    </aside>

    <section class="order-detail-main">
      <Tabs
        ariaLabel="Order detail sections"
        class="order-detail-tabs"
        listClass="order-detail-tabs__list"
        panelsClass="order-detail-tabs__panels"
      >
        <Tab
          slot="tabs"
          target="products"
          active={isOrderDetailTabActive("products")}
        >
          Products
        </Tab>
        <Tab
          slot="tabs"
          target="order-slip"
          active={isOrderDetailTabActive("order-slip")}
        >
          Order Slip
        </Tab>
        <Tab
          slot="tabs"
          target="sales-invoice"
          active={isOrderDetailTabActive("sales-invoice")}
        >
          Sales Invoice
        </Tab>
        <Tab
          slot="tabs"
          target="payment-record"
          active={isOrderDetailTabActive("payment-record")}
        >
          Payment Record
        </Tab>
        <Tab
          slot="tabs"
          target="timeline"
          active={isOrderDetailTabActive("timeline")}
        >
          Timeline
        </Tab>
        <Tab
          slot="tabs"
          target="notes"
          active={isOrderDetailTabActive("notes")}
        >
          Notes
        </Tab>

        <TabPanel
          slot="panels"
          target="products"
          active={isOrderDetailTabActive("products")}
          class="order-products-panel-host"
        >
          <div class="order-products-panel" data-order-products-panel>
            <div class="order-products-panel__header">
              <div class="order-products-panel__header-copy">
                <h3 class="order-products-panel__title">Order Products</h3>
                <p class="order-products-panel__copy">
                  Finalize products and order slip quantities before opening or
                  printing the order slip.
                </p>
              </div>
              <div class="order-products-panel__header-actions">
                {
                  orderProductEditLockReason ? (
                    <p class="order-products-panel__lock">
                      {orderProductEditLockReason}
                    </p>
                  ) : null
                }
              </div>
            </div>

            <div
              class="agent-order-products-modal"
              data-order-products-list
              data-order-product-add-inline
            >
              {
                order.customer_order_item.length === 0 ? (
                  <p class="agent-order-modal-empty" data-order-product-empty>
                    No products have been added to this order yet.
                  </p>
                ) : null
              }

              {
                order.customer_order_item.length > 0 ? (
                  <ul class="agent-order-products-modal__list">
                    {
                      order.customer_order_item.map((item) => {
                        const itemSubtotal = item.partial_quantity * item.unit_price;
                        const unitLabel = item.product?.unit_label ?? "unit";
                        const canRemoveOrderProduct =
                          canEditOrderProducts &&
                          order.customer_order_item.length > 1;

                        return (
                          <li class="agent-order-products-modal__item">
                            <div class="agent-order-products-modal__item-row">
                              <div class="agent-order-products-modal__item-copy">
                                <h3 class="agent-order-products-modal__item-name">
                                  {item.product?.name ?? "Missing product"}
                                </h3>
                                <p class="agent-order-products-modal__item-price">
                                  <span>Price per unit</span>
                                  <span>{formatCurrency(item.unit_price)}</span>
                                </p>
                              </div>
                              <div class="agent-order-products-modal__item-actions">
                                {
                                  canEditOrderProducts ? (
                                    <form
                                      method="post"
                                      class="agent-order-products-modal__quantity-form"
                                      {...quantityValidationDataset(
                                        item,
                                        item.partial_quantity,
                                      )}
                                    >
                                      <div class="agent-order-products-modal__line-controls">
                                        <strong
                                          class="agent-order-products-modal__item-total"
                                          data-order-product-line-total
                                          data-unit-price={item.unit_price}
                                        >
                                          {formatCurrency(itemSubtotal)}
                                        </strong>
                                        <label
                                          class="sr-only"
                                          for={`customer-order-product-qty-${item.id}`}
                                        >
                                          Quantity for {item.product?.name ?? "item"}
                                        </label>
                                        <div class="agent-order-products-modal__quantity-input">
                                          <input
                                            id={`customer-order-product-qty-${item.id}`}
                                            type="number"
                                            name="quantity"
                                            min="0.001"
                                            step="0.001"
                                            value={item.partial_quantity}
                                            required
                                            data-order-product-quantity-input
                                            data-initial-quantity={item.partial_quantity}
                                          />
                                          <span
                                            class="agent-order-products-modal__quantity-unit"
                                            aria-hidden="true"
                                          >
                                            {unitLabel}
                                          </span>
                                        </div>
                                      </div>
                                      <input
                                        type="hidden"
                                        name="action"
                                        value="update-order-item-quantity"
                                      />
                                      <input
                                        type="hidden"
                                        name="orderItemId"
                                        value={item.id}
                                      />
                                      <button
                                        type="submit"
                                        data-order-product-quantity-save
                                        disabled
                                      >
                                        Save
                                      </button>
                                    </form>
                                  ) : (
                                    <div class="agent-order-products-modal__line-controls">
                                      <strong
                                        class="agent-order-products-modal__item-total"
                                        data-order-product-line-total
                                        data-unit-price={item.unit_price}
                                      >
                                        {formatCurrency(itemSubtotal)}
                                      </strong>
                                      <span class="agent-order-products-modal__quantity-value">
                                        {item.partial_quantity} {unitLabel}
                                      </span>
                                    </div>
                                  )
                                }
                                {
                                  canRemoveOrderProduct ? (
                                    <form
                                      method="post"
                                      class="order-product-remove-form"
                                    >
                                      <input
                                        type="hidden"
                                        name="action"
                                        value="remove-order-item"
                                      />
                                      <input
                                        type="hidden"
                                        name="orderItemId"
                                        value={item.id}
                                      />
                                      <button
                                        type="submit"
                                        class="order-product-remove-form__button"
                                      >
                                        Remove
                                      </button>
                                    </form>
                                  ) : null
                                }
                              </div>
                            </div>
                            {
                              item.add_details ? (
                                <p class="agent-order-products-modal__meta">
                                  {item.add_details}
                                </p>
                              ) : null
                            }
                          </li>
                        );
                      })
                    }
                  </ul>
                ) : null
              }

              {
                canAddOrderProducts ? (
                  <footer
                    class="agent-order-products-modal__footer agent-order-products-modal__footer--inline-add"
                    data-order-product-add-footer
                  >
                    <button
                      type="button"
                      class="agent-order-products-modal__add-trigger"
                      data-order-product-add-trigger
                    >
                      Add Product
                    </button>
                    <form
                      method="post"
                      class="agent-order-products-modal__add-row agent-order-products-modal__add-row--inline"
                      data-order-product-add-form
                      hidden
                      data-astro-reload
                    >
                      <input type="hidden" name="action" value="add-order-item" />
                      <input type="hidden" name="orderId" value={order.id} />
                      <div class="agent-order-products-modal__add-fields">
                        <label class="sr-only" for="customer-order-add-product-select">
                          Product
                        </label>
                        <select
                          id="customer-order-add-product-select"
                          name="productId"
                          class="agent-order-products-modal__add-select"
                          data-order-product-add-select
                          required
                        >
                          <option value="">Select product</option>
                          {
                            addableProducts.map((product) => (
                              <option
                                value={product.id}
                                data-unit-label={product.unit_label}
                              >
                                {product.name} -{" "}
                                {formatCurrency(customerProductUnitPrice(product))} /{" "}
                                {product.unit_label}
                              </option>
                            ))
                          }
                        </select>
                        <label class="sr-only" for="customer-order-add-product-quantity">
                          Quantity
                        </label>
                        <div class="agent-order-products-modal__quantity-input">
                          <input
                            id="customer-order-add-product-quantity"
                            type="number"
                            name="quantity"
                            class="agent-order-products-modal__add-quantity"
                            min="0.001"
                            step="0.001"
                            value="1"
                            required
                            data-order-product-add-quantity
                          />
                          <span
                            class="agent-order-products-modal__quantity-unit"
                            data-order-product-add-unit
                            aria-hidden="true"
                          >
                            {addableProducts[0]?.unit_label ?? "unit"}
                          </span>
                        </div>
                      </div>
                      <div class="agent-order-products-modal__add-actions">
                        <button
                          type="submit"
                          class="agent-order-products-modal__icon-button agent-order-products-modal__icon-button--confirm"
                          aria-label="Save product"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.25"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="agent-order-products-modal__icon-button agent-order-products-modal__icon-button--cancel"
                          data-order-product-add-cancel
                          aria-label="Cancel"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.25"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </button>
                      </div>
                    </form>
                  </footer>
                ) : null
              }
            </div>
          </div>
        </TabPanel>

        <TabPanel
          slot="panels"
          target="order-slip"
          active={isOrderDetailTabActive("order-slip")}
          variant="document"
          class="order-document-tab-panel"
        >
          <div
            class="document-preview-body document-preview--pdf-like document-preview--rounded-sm"
          >
            <header class="pdf-preview-header">
              <div class="pdf-preview-brand">
                {
                  orderSlipLayout.brandLines.map((line, index) => (
                    <p
                      class:list={[
                        "pdf-preview-brand-line",
                        index === 0 && "pdf-preview-brand-line--strong",
                      ]}
                    >
                      {line}
                    </p>
                  ))
                }
              </div>
              <div class="pdf-preview-logo">
                {
                  orderSlipLayout.logoUrl ? (
                    <img src={orderSlipLayout.logoUrl} alt="" />
                  ) : (
                    "LOGO"
                  )
                }
              </div>
              <h3 class="pdf-preview-title">{orderSlipLayout.title}</h3>
            </header>

            <div class="pdf-preview-fields">
              <PdfLabeledField
                field={orderSlipLayout.dateField}
                class="pdf-preview-labeled-field--full"
              />
              <div class="pdf-preview-fields pdf-preview-fields--two-column">
                <PdfLabeledField field={orderSlipLayout.sellerField} />
                <PdfLabeledField field={orderSlipLayout.orderedByField} />
              </div>
            </div>

            <div
              class="pdf-preview-table"
              style={`--pdf-grid-template:${orderSlipGridTemplate};`}
            >
              <div class="pdf-preview-table__head">
                {
                  orderSlipLayout.columns.map((column) => (
                    <span class:list={[column.align && `is-${column.align}`]}>
                      {column.label}
                    </span>
                  ))
                }
              </div>
              {
                orderSlipLayout.rows.map((row) => (
                  <div class="pdf-preview-table__row">
                    {row.cells.map((cell, cellIndex) => (
                      <span
                        class:list={[
                          orderSlipLayout.columns[cellIndex]?.align &&
                            `is-${orderSlipLayout.columns[cellIndex]?.align}`,
                        ]}
                      >
                        {cell || "\u00A0"}
                      </span>
                    ))}
                  </div>
                ))
              }
            </div>

            <div class="pdf-preview-total-row">
              <PdfLabeledField
                field={orderSlipLayout.totalField}
                class="pdf-preview-labeled-field--total"
                valueUnderline={false}
              />
            </div>

            <div class="pdf-preview-copy-block">
              <h4>{orderSlipLayout.deliveryHeading}</h4>
              {orderSlipLayout.deliveryLines.map((line) => <p>{line}</p>)}
            </div>

            <div class="pdf-preview-copy-block">
              <h4>{orderSlipLayout.paymentHeading}</h4>
              {orderSlipLayout.paymentLines.map((line) => <p>{line}</p>)}
            </div>

            <p class="pdf-preview-payment-due">
              <strong>{orderSlipLayout.paymentDueHeading}</strong>
              {orderSlipLayout.paymentDueLine}
            </p>

            <p class="pdf-preview-confirmation">
              {orderSlipLayout.confirmationText}
            </p>

            <footer class="pdf-preview-signatures">
              <div class="pdf-preview-signature-block">
                <p class="pdf-preview-signature-heading">
                  {orderSlipLayout.buyerSignatureLines[0]}
                </p>
                <p>{orderSlipLayout.buyerSignatureLines[1]}</p>
                <p>{orderSlipLayout.buyerSignatureLines[2]}</p>
                <p>{orderSlipLayout.buyerSignatureLines[3]}</p>
              </div>
              <div class="pdf-preview-signature-block">
                <p class="pdf-preview-signature-heading">
                  {orderSlipLayout.sellerSignatureHeading}
                </p>
                <PdfLabeledField
                  field={orderSlipLayout.sellerNameField}
                  class="pdf-preview-labeled-field--signature"
                />
                <p>{orderSlipLayout.sellerSignatureLines[0]}</p>
                <p>{orderSlipLayout.sellerSignatureLines[1]}</p>
              </div>
            </footer>
          </div>
        </TabPanel>

        <TabPanel
          slot="panels"
          target="sales-invoice"
          active={isOrderDetailTabActive("sales-invoice")}
          variant={hasSalesInvoice ? "document" : "default"}
          class:list={[hasSalesInvoice && "order-document-tab-panel"]}
        >
          {
            !hasSalesInvoice ? (
              <div class="sales-invoice-empty-state">
                <svg
                  class="sales-invoice-empty-state__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="8" y1="13" x2="16" y2="13" />
                  <line x1="8" y1="17" x2="16" y2="17" />
                  <line x1="8" y1="9" x2="10" y2="9" />
                </svg>
                <p>No sales invoice has been created for this order yet.</p>
                <form method="post">
                  <input type="hidden" name="action" value="save-invoice" />
                  <input type="hidden" name="orderId" value={order.id} />
                  <button
                    type="submit"
                    class="primary-panel-button primary-panel-button--compact"
                    disabled={!canGenerateInvoice}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 5v14" />
                      <path d="M5 12h14" />
                    </svg>
                    <span>Create Sales Invoice</span>
                  </button>
                </form>
              </div>
            ) : (
              <>
                <div class="document-preview-body document-preview--pdf-like document-preview--rounded-sm">
                  <header class="pdf-preview-header">
                    <div class="pdf-preview-brand">
                      {salesInvoiceLayout.brandLines.map((line, index) => (
                        <p
                          class:list={[
                            "pdf-preview-brand-line",
                            index === 0 && "pdf-preview-brand-line--strong",
                          ]}
                        >
                          {line}
                        </p>
                      ))}
                    </div>
                    <div class="pdf-preview-logo">
                      {
                        salesInvoiceLayout.logoUrl ? (
                          <img src={salesInvoiceLayout.logoUrl} alt="" />
                        ) : (
                          "LOGO"
                        )
                      }
                    </div>
                    <h3 class="pdf-preview-title">
                      {salesInvoiceLayout.title}
                    </h3>
                  </header>

                  <div class="pdf-preview-fields">
                    <PdfLabeledField
                      field={salesInvoiceLayout.dateField}
                      class="pdf-preview-labeled-field--full"
                    />
                    <div class="pdf-preview-fields pdf-preview-fields--two-column">
                      <PdfLabeledField field={salesInvoiceLayout.soldToField} />
                      <PdfLabeledField field={salesInvoiceLayout.addressField} />
                    </div>
                  </div>

                  <div
                    class="pdf-preview-table"
                    style={`--pdf-grid-template:${salesInvoiceGridTemplate};`}
                  >
                    <div class="pdf-preview-table__head">
                      {salesInvoiceLayout.columns.map((column) => (
                        <span
                          class:list={[column.align && `is-${column.align}`]}
                        >
                          {column.label}
                        </span>
                      ))}
                    </div>
                    {order.customer_order_item.map((item, index) => (
                      <div class="pdf-preview-table__row pdf-preview-table__row--editable">
                        <span>
                          {salesInvoiceLayout.rows[index]?.cells[0] ??
                            "Missing product"}
                        </span>
                        <form
                          method="post"
                          class="pdf-preview-quantity-form"
                          {...quantityValidationDataset(
                            item,
                            item.final_quantity,
                          )}
                        >
                          <input
                            type="hidden"
                            name="action"
                            value="update-invoice-item-quantity"
                          />
                          <input
                            type="hidden"
                            name="orderItemId"
                            value={item.id}
                          />
                          <input
                            type="number"
                            name="quantity"
                            min="0.001"
                            step="0.001"
                            value={item.final_quantity}
                            disabled={!canEditInvoiceQuantities}
                            required
                          />
                          <button
                            type="submit"
                            disabled={!canEditInvoiceQuantities}
                          >
                            Save
                          </button>
                        </form>
                        <span class="is-right">
                          {salesInvoiceLayout.rows[index]?.cells[2] ?? ""}
                        </span>
                        <span class="is-right">
                          {salesInvoiceLayout.rows[index]?.cells[3] ?? ""}
                        </span>
                      </div>
                    ))}
                  </div>

                  <div class="pdf-preview-total-row">
                    <PdfLabeledField
                      field={salesInvoiceLayout.totalField}
                      class="pdf-preview-labeled-field--total"
                      valueUnderline={false}
                    />
                  </div>

                  <div class="pdf-preview-copy-block">
                    <h4>{salesInvoiceLayout.modeOfPaymentHeading}</h4>
                    <p>{salesInvoiceLayout.modeOfPaymentLine}</p>
                  </div>

                  <footer class="pdf-preview-invoice-footer">
                    <div class="pdf-preview-issuer">
                      <p class="pdf-preview-signature-heading">
                        {salesInvoiceLayout.issuerHeading}
                      </p>
                      <p class="pdf-preview-signature-name">
                        {salesInvoiceLayout.issuerName}
                      </p>
                      <p>{salesInvoiceLayout.issuerSubline}</p>
                    </div>
                  </footer>
                </div>
              </>
            )
          }
        </TabPanel>

        <TabPanel
          slot="panels"
          target="payment-record"
          active={isOrderDetailTabActive("payment-record")}
        >
          <div class="payment-panel">
            <div class="payment-panel__header">
              <div class="payment-panel__intro">
                <h3 class="payment-panel__title">Payment History</h3>
                <p>
                  Track payments made against this order.
                </p>
              </div>
              <button
                type="button"
                class="primary-panel-button primary-panel-button--compact"
                data-toggle-payment-form
                disabled={!canCreatePaymentRecord}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 5v14"></path>
                  <path d="M5 12h14"></path>
                </svg>
                <span>Add Record</span>
              </button>
            </div>

            {
              pendingAgentReceivedPayments.length > 0 && (
                <div class="agent-received-panel">
                  <div class="agent-received-panel__header">
                    <div>
                      <h4>Agent Received Payments</h4>
                      <p>
                        {formatCurrency(pendingAgentReceivedTotal)} awaiting
                        admin confirmation.
                      </p>
                    </div>
                  </div>
                  <div class="agent-received-list">
                    {pendingAgentReceivedPayments.map((payment) => (
                      <article class="payment-row agent-received-row">
                        <div class="payment-row__content">
                          <div class="payment-row__details">
                            <span class="payment-row__method">
                              {payment.payment_method}
                            </span>
                            <span class="payment-row__date">
                              {formatDate(payment.payment_date)}
                              {" by "}
                              {payment.agent?.display_name ?? "Agent"}
                            </span>
                          </div>
                          <strong class="payment-row__amount">
                            {formatCurrency(payment.amount)}
                          </strong>
                        </div>
                        <p class="payment-row__meta">
                          {payment.reference_number
                            ? `Reference: ${payment.reference_number}`
                            : "No reference number"}
                          {" â€¢ "}
                          {payment.notes ?? "No notes"}
                        </p>
                        <form
                          method="post"
                          class="agent-received-row__actions"
                          data-astro-reload
                        >
                          <input
                            type="hidden"
                            name="action"
                            value="confirm-agent-payment"
                          />
                          <input
                            type="hidden"
                            name="agentPaymentId"
                            value={payment.id}
                          />
                          <button
                            type="submit"
                            class="primary-panel-button primary-panel-button--compact"
                          >
                            Confirm Payment Received
                          </button>
                        </form>
                      </article>
                    ))}
                  </div>
                </div>
              )
            }

            <form
              action={paymentRecordReturnPath}
              method="post"
              class="payment-form"
              data-payment-form
              data-astro-reload
              data-payment-paid-total={paidTotal}
              data-payment-order-total={paymentOrderTotal}
              data-payment-commission-total={paymentFormCommissionTotal}
              hidden
            >
              <input type="hidden" name="action" value="record-payment" />
              <input type="hidden" name="orderId" value={order.id} />
              <input
                type="hidden"
                name="returnTo"
                value={paymentRecordReturnPath}
              />
              {
                (hasPayments || isResellerCustomer) && (
                  <input
                    type="hidden"
                    name="customerType"
                    value={paymentCustomerType}
                  />
                )
              }
              <div data-payment-pricing-items hidden>
                {
                  order.customer_order_item.map((item) => (
                    <span
                      data-payment-pricing-item
                      data-final-quantity={item.final_quantity}
                      data-default-price={
                        item.product?.default_price ?? item.unit_price
                      }
                      data-reseller-price={
                        item.product?.reseller_price ?? item.unit_price
                      }
                    />
                  ))
                }
              </div>

              <div class="payment-form__grid">
                {
                  isResellerCustomer ? (
                    <div class="payment-form__readonly-field">
                      <span>Customer Type</span>
                      <strong>Reseller</strong>
                    </div>
                  ) : (
                    <label>
                      <span>Customer Type</span>
                      <select
                        name="customerType"
                        data-payment-customer-type
                        disabled={hasPayments}
                      >
                        <option
                          value="regular"
                          selected={paymentCustomerType === "regular"}
                        >
                          Regular
                        </option>
                        <option value="wholesale">Wholesale</option>
                        <option
