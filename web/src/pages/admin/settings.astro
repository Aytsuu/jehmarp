---
import AdminSettingsPageLayout from "@/components/admin/AdminSettingsPageLayout.astro";
import AdminSettingsGeneral from "@/components/admin/settings/AdminSettingsGeneral.astro";
import AdminSettingsPrivacy from "@/components/admin/settings/AdminSettingsPrivacy.astro";
import AdminSettingsTemplates from "@/components/admin/settings/AdminSettingsTemplates.astro";
import AdminSettingsAccountsSecurity from "@/components/admin/settings/AdminSettingsAccountsSecurity.astro";
import { formatAdminActionFeedback } from "@/lib/admin-dashboard/actions";
import { loadAdminAgentManagementData, loadAdminDashboardData } from "@/lib/admin-dashboard/data";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { loadPlatformSettings } from "@/lib/platform-settings";
import { createSupabaseAdminClient } from "@/lib/supabase/admin";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);
if (!adminRoute.ready) return adminRoute.response;

const activeTab = (() => {
  const tab = Astro.url.searchParams.get("tab");
  if (tab === "accounts") return "accounts";
  if (tab === "privacy") return "privacy";
  if (tab === "templates") return "templates";
  return "general";
})();
const feedback = formatAdminActionFeedback(Astro.url);
const agentsPagination = parseAdminPagination(Astro.url);
const agentsPaginationQuery = mergeAdminPaginationQuery("tab=accounts", agentsPagination);
const [data, settings, agentsData] = await Promise.all([
  loadAdminDashboardData(),
  loadPlatformSettings(createSupabaseAdminClient()),
  loadAdminAgentManagementData({}, agentsPagination),
]);
---

<AdminSettingsPageLayout
  title="Admin Settings - JEHMARP"
  description="Manage administrative settings and platform configurations."
  heading="Settings"
  intro="Configure business profile, defaults, and account security."
  activeTab={activeTab}
  feedback={feedback}
  dashboardData={data}
>
  <div class="admin-settings-page__content">
    <div
      class:list={[
        "admin-settings-page__tab-panel",
        activeTab === "general" && "is-active",
      ]}
      data-admin-settings-tab-panel="general"
      role="tabpanel"
      hidden={activeTab !== "general"}
    >
      <AdminSettingsGeneral settings={settings} />
    </div>
    <div
      class:list={[
        "admin-settings-page__tab-panel",
        activeTab === "privacy" && "is-active",
      ]}
      data-admin-settings-tab-panel="privacy"
      role="tabpanel"
      hidden={activeTab !== "privacy"}
    >
      <AdminSettingsPrivacy settings={settings} />
    </div>
    <div
      class:list={[
        "admin-settings-page__tab-panel",
        activeTab === "templates" && "is-active",
      ]}
      data-admin-settings-tab-panel="templates"
      role="tabpanel"
      hidden={activeTab !== "templates"}
    >
      <AdminSettingsTemplates settings={settings} />
    </div>
    <div
      class:list={[
        "admin-settings-page__tab-panel",
        activeTab === "accounts" && "is-active",
      ]}
      data-admin-settings-tab-panel="accounts"
      role="tabpanel"
      hidden={activeTab !== "accounts"}
    >
      <AdminSettingsAccountsSecurity
        agentsData={agentsData}
        agentsPaginationQuery={agentsPaginationQuery}
      />
    </div>
  </div>
</AdminSettingsPageLayout>

<style>
  .admin-settings-page__content {
    display: grid;
    gap: 0;
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
  }

  .admin-settings-page__content :global(.admin-settings-card) {
    min-width: 0;
    max-width: 100%;
    gap: 1rem;
    border: 0;
    padding: 0;
    background: transparent;
  }

  .admin-settings-page__content :global(.admin-settings-form) {
    border: 0;
    padding: 0;
    background: transparent;
  }

  .admin-settings-page__content :global(.admin-settings-section-row) {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: 1.5rem 2rem;
    align-items: start;
    padding: 1.25rem 0;
  }

  .admin-settings-page__content :global(.admin-settings-section-row + .admin-settings-section-row) {
    border-top: 1px solid #e5e7eb;
  }

  .admin-settings-page__content :global(.admin-settings-section-row__intro) {
    flex-shrink: 0;
  }

  .admin-settings-page__content :global(.admin-settings-section-row__intro h4) {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #111827;
  }

  .admin-settings-page__content :global(.admin-settings-section-row__intro p) {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #6b7280;
  }

  .admin-settings-page__content :global(.admin-settings-section-row__content) {
    min-width: 0;
  }

  @media (max-width: 768px) {
    .admin-settings-page__content :global(.admin-settings-section-row) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
