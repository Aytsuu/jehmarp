---
import AdminSalesManagement from "@/components/admin/AdminSalesManagement.astro";
import { loadAdminSalesManagementData } from "@/lib/admin-dashboard/data";
import {
  parseAdminSalesFilters,
  serializeAdminSalesFilters,
} from "@/lib/admin-dashboard/sales-filters";
import {
  mergeAdminPaginationQuery,
  parseAdminPagination,
} from "@/lib/admin-dashboard/pagination";
import { requireAdminRoute } from "@/lib/admin-dashboard/page";
import { setDashboardFragmentResponseHeaders } from "@/lib/dashboard/fragment-response";

export const prerender = false;

const adminRoute = await requireAdminRoute(Astro);

if (!adminRoute.ready) {
  return adminRoute.response;
}

setDashboardFragmentResponseHeaders(Astro);

const salesFilters = parseAdminSalesFilters(Astro.url);
const salesPagination = parseAdminPagination(Astro.url);
const salesFilterQuery = mergeAdminPaginationQuery(
  serializeAdminSalesFilters(salesFilters),
  salesPagination,
);
const data = await loadAdminSalesManagementData(salesFilters, salesPagination);
---

<AdminSalesManagement
  data={data}
  activeFilters={salesFilters}
  filterQuery={salesFilterQuery}
/>
