# Local development — copy to .env or .env.local
#
# npm run dev uses LOCAL_SUPABASE_* (and CLI defaults) instead of PUBLIC_SUPABASE_*.
# Keep PUBLIC_SUPABASE_* only if you need hosted credentials for one-off testing.

# --- Local Supabase (preferred for npm run dev) ---
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
LOCAL_SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# --- Hosted Supabase (optional reference; not used by default in dev) ---
# PUBLIC_SUPABASE_URL=https://your-staging-or-production-project.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# --- Turnstile (Cloudflare test keys work for local login forms) ---
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Skip the challenge in local development only. Any other value, or omitting
# this line, keeps Turnstile required. Production and staging ignore this.
# TURNSTILE=disable

# --- Email (optional unless testing reseller application workflow) ---
RESEND_API_KEY=re_your_resend_api_key
RESELLER_PRICE_LIST_FROM="JEHMARP <onboarding@resend.dev>"
RESELLER_ADMIN_EMAIL=admin@example.com

# --- Rate limiting (optional locally) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# --- Dashboard page availability ---
# Supported values: ready, maintenance, not ready
PAGE_STATUS_ADMIN_DASHBOARD=ready
PAGE_STATUS_ADMIN_PRODUCTS=ready
PAGE_STATUS_ADMIN_CUSTOMERS=ready
PAGE_STATUS_ADMIN_AGENTS=ready
PAGE_STATUS_ADMIN_ORDERS=ready
PAGE_STATUS_ADMIN_INVOICES=ready
PAGE_STATUS_ADMIN_INQUIRIES=ready
PAGE_STATUS_ADMIN_RESELLER_APPLICATIONS=ready
PAGE_STATUS_ADMIN_ACTIVITY=ready
PAGE_STATUS_ADMIN_NOTIFICATIONS=ready
PAGE_STATUS_ADMIN_CONTENT=ready
PAGE_STATUS_ADMIN_SETTINGS=ready
PAGE_STATUS_AGENT_DASHBOARD=ready
PAGE_STATUS_AGENT_EARNINGS=ready
PAGE_STATUS_AGENT_CUSTOMERS=ready
PAGE_STATUS_AGENT_ORDERS=ready
PAGE_STATUS_AGENT_PAYMENTS=ready
PAGE_STATUS_AGENT_NOTIFICATIONS=ready
PAGE_STATUS_AGENT_SETTINGS=ready
